[
	{
		"type": "edit-module",
		"subject": "@N:Place order",
		"set": {
			"responsibility": "POST /orders: saves the order as pending and starts the payment, then answers"
		}
	},
	{
		"type": "add-module",
		"module": {
			"name": "Payment webhook",
			"kind": "route",
			"parent": "Checkout API",
			"groups": ["payments"],
			"responsibility": "POST /payments/webhook: records the outcome the payment provider reports",
			"order": 12000
		}
	},
	{
		"type": "add-module",
		"module": {
			"name": "Order events",
			"kind": "queue",
			"groups": ["fulfilment"],
			"responsibility": "Carries each paid order to the work that follows it",
			"order": 13000
		}
	},
	{
		"type": "add-module",
		"module": {
			"name": "Fulfilment worker",
			"kind": "job",
			"groups": ["fulfilment"],
			"responsibility": "Reserves the stock and sends the receipt for each paid order, retrying on its own",
			"order": 14000
		}
	},
	{
		"type": "remove-module",
		"subject": "@N:Timeout guard"
	},
	{
		"type": "remove-walkthrough",
		"subject": "@W:How an order is placed today"
	},
	{
		"type": "edit-relationship",
		"subject": "@E:Place order:reserve stock, and wait",
		"source": "Fulfilment worker",
		"set": {
			"to": "Inventory service",
			"kind": "http",
			"label": "reserve stock",
			"traffic": {}
		}
	},
	{
		"type": "edit-relationship",
		"subject": "@E:Place order:charge the card, and wait",
		"source": "Place order",
		"set": {
			"to": "Payment provider",
			"kind": "http",
			"label": "start the payment",
			"emphasis": "hero",
			"traffic": {}
		}
	},
	{
		"type": "edit-relationship",
		"subject": "@E:Place order:write the paid order",
		"source": "Place order",
		"set": {
			"to": "Orders DB",
			"kind": "data",
			"label": "write the order as pending",
			"traffic": {}
		}
	},
	{
		"type": "edit-relationship",
		"subject": "@E:Place order:send the receipt, and wait",
		"source": "Fulfilment worker",
		"set": {
			"to": "Email provider",
			"kind": "http",
			"label": "send the receipt",
			"traffic": {},
			"description": "Retried with backoff until the email provider accepts it; the shopper already has their confirmation page."
		}
	},
	{
		"type": "add-relationship",
		"source": "Payment provider",
		"relationship": {
			"to": "Payment webhook",
			"kind": "event",
			"label": "payment succeeded",
			"emphasis": "hero",
			"traffic": {},
			"order": 34000
		}
	},
	{
		"type": "add-relationship",
		"source": "Payment webhook",
		"relationship": {
			"to": "Orders DB",
			"kind": "data",
			"label": "mark the order paid",
			"order": 35000
		}
	},
	{
		"type": "add-relationship",
		"source": "Payment webhook",
		"relationship": {
			"to": "Order events",
			"kind": "queue",
			"label": "publish order paid",
			"emphasis": "hero",
			"traffic": {},
			"order": 36000
		}
	},
	{
		"type": "add-relationship",
		"source": "Order events",
		"relationship": {
			"to": "Fulfilment worker",
			"kind": "queue",
			"label": "deliver order paid",
			"traffic": {},
			"order": 37000
		}
	},
	{
		"type": "edit-flow",
		"subject": "@F:Place an order",
		"set": {
			"summary": "One press of Pay, from the basket to the order-received page.",
			"participants": ["Storefront", "Place order", "Orders DB", "Payment provider"]
		}
	},
	{
		"type": "remove-step",
		"subject": "@S:Place an order:start the 10 s clock"
	},
	{
		"type": "remove-step",
		"subject": "@S:Place an order:reserve the items"
	},
	{
		"type": "remove-step",
		"subject": "@S:Place an order:reserved"
	},
	{
		"type": "remove-step",
		"subject": "@S:Place an order:send the receipt"
	},
	{
		"type": "remove-step",
		"subject": "@S:Place an order:accepted"
	},
	{
		"type": "edit-step",
		"subject": "@S:Place an order:write the paid order",
		"set": {
			"label": "write the order as pending"
		}
	},
	{
		"type": "edit-step",
		"subject": "@S:Place an order:charge the card",
		"set": {
			"label": "start the payment"
		},
		"clear": ["note"]
	},
	{
		"type": "edit-step",
		"subject": "@S:Place an order:paid",
		"set": {
			"label": "payment started"
		}
	},
	{
		"type": "edit-step",
		"subject": "@S:Place an order:order confirmed",
		"set": {
			"label": "order received"
		}
	},
	{
		"type": "move-step",
		"subject": "@S:Place an order:write the paid order",
		"placement": {
			"holder": "@F:Place an order",
			"before": "@S:Place an order:charge the card"
		}
	},
	{
		"type": "add-flow",
		"collection": "Web shop",
		"flow": {
			"name": "Fulfil a paid order",
			"summary": "What happens once the card is paid, off the shopper's clock.",
			"participants": [
				"Payment provider",
				"Payment webhook",
				"Orders DB",
				"Order events",
				"Fulfilment worker",
				"Inventory service",
				"Email provider"
			],
			"steps": [
				{
					"from": "Payment provider",
					"to": "Payment webhook",
					"kind": "async",
					"label": "payment succeeded",
					"note": "the provider may deliver the same event more than once"
				},
				{
					"from": "Payment webhook",
					"to": "Orders DB",
					"label": "mark the order paid",
					"kind": "sync"
				},
				{
					"from": "Payment webhook",
					"to": "Order events",
					"kind": "async",
					"label": "publish order paid"
				},
				{
					"from": "Payment webhook",
					"to": "Payment provider",
					"kind": "return",
					"label": "200 OK"
				},
				{
					"from": "Order events",
					"to": "Fulfilment worker",
					"kind": "async",
					"label": "order paid"
				},
				{
					"from": "Fulfilment worker",
					"to": "Inventory service",
					"label": "reserve the items",
					"kind": "sync"
				},
				{
					"from": "Inventory service",
					"to": "Fulfilment worker",
					"kind": "return",
					"label": "reserved"
				},
				{
					"from": "Fulfilment worker",
					"to": "Email provider",
					"label": "send the receipt",
					"note": "retried with backoff until accepted; the shopper already has their page",
					"kind": "sync"
				},
				{
					"from": "Email provider",
					"to": "Fulfilment worker",
					"kind": "return",
					"label": "accepted"
				}
			]
		}
	}
]
