{
	"$comment": "Two independent boards describe Flask app with the same name and binding but different responsibilities. Names do not establish identity.",
	"registerRepo": true,
	"steps": [
		{
			"op": "new",
			"board": "Flask application",
			"input": {
				"level": "service",
				"nodes": [
					{
						"name": "Flask app",
						"kind": "app",
						"responsibility": "The WSGI application object",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/app.py"
						}
					},
					{
						"name": "WSGI entry",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Flask.wsgi_app: pushes the request context, then dispatches",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/app.py"
						}
					},
					{
						"name": "Dispatch",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Flask.full_dispatch_request: preprocesses, dispatches to the view, then finalizes",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/app.py"
						}
					},
					{
						"name": "Finalize request",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Flask.finalize_request: makes the response, then post-processes it",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/app.py"
						}
					},
					{
						"name": "Process response",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Flask.process_response: runs after_request functions and saves the session",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/app.py"
						}
					},
					{
						"name": "CLI",
						"kind": "module",
						"responsibility": "The flask command group and the script info that loads the app",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/cli.py"
						}
					},
					{
						"name": "Run command",
						"kind": "function",
						"parent": "CLI",
						"responsibility": "flask run: loads the app, then serves it",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/cli.py"
						}
					},
					{
						"name": "App loader",
						"kind": "function",
						"parent": "CLI",
						"responsibility": "ScriptInfo.load_app: imports the module and returns the application",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/cli.py"
						}
					},
					{
						"name": "Contexts",
						"kind": "module",
						"responsibility": "The request and application contexts",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/ctx.py"
						}
					},
					{
						"name": "Request context push",
						"kind": "function",
						"parent": "Contexts",
						"responsibility": "RequestContext.push: binds request and session for one request",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/ctx.py"
						}
					},
					{
						"name": "Session interface",
						"kind": "module",
						"responsibility": "Opens and saves the signed cookie session",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/sessions.py"
						}
					},
					{
						"name": "Development server",
						"kind": "external",
						"responsibility": "werkzeug run_simple serves the loaded application"
					}
				],
				"edges": [
					{
						"from": "WSGI entry",
						"to": "Request context push",
						"kind": "call",
						"label": "push"
					},
					{
						"from": "WSGI entry",
						"to": "Dispatch",
						"kind": "call",
						"label": "dispatches"
					},
					{
						"from": "Request context push",
						"to": "Session interface",
						"kind": "call",
						"label": "open_session",
						"description": "RequestContext.push opens the session while it binds the request"
					},
					{
						"from": "Dispatch",
						"to": "Finalize request",
						"kind": "call",
						"label": "rv"
					},
					{
						"from": "Finalize request",
						"to": "Process response",
						"kind": "call",
						"label": "response"
					},
					{
						"from": "Process response",
						"to": "Session interface",
						"kind": "call",
						"label": "save_session"
					},
					{
						"from": "Run command",
						"to": "App loader",
						"kind": "call",
						"label": "info.load_app()"
					},
					{
						"from": "Run command",
						"to": "Development server",
						"kind": "call",
						"label": "run_simple(host, port, app)"
					},
					{
						"from": "Development server",
						"to": "WSGI entry",
						"kind": "call",
						"label": "environ, start_response",
						"description": "run_simple calls the application object, whose __call__ hands the request to wsgi_app"
					}
				]
			}
		},
		{
			"op": "new",
			"board": "Flask detail",
			"input": {
				"level": "module",
				"nodes": [
					{
						"name": "Flask app",
						"kind": "app",
						"responsibility": "Dispatches the accepted request",
						"binding": {
							"repo": "$FLASK",
							"path": "src/flask/app.py"
						}
					}
				]
			}
		}
	]
}
