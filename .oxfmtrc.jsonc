{
	// Canonical vault files, the example vault's included, use the board store's
	// deterministic serializer.
	// Reformatting outside that owner would bypass board versions and live updates.
	// .claude/ is written by Claude Code in its own layout (settings it rewrites,
	// derived skill links, session worktrees), not formatted to this repository's.
	"ignorePatterns": [
		".archboard/vault/**/*.semantic.json",
		"examples/**/*.semantic.json",
		".claude/**",
	],
	"useTabs": true,
	"printWidth": 100,
	"quoteStyle": "double",
	"semicolons": "always",
	"trailingComma": "all",
	"endOfLine": "lf",
	"sortTailwindcss": {
		"functions": ["cn"],
		"preserveDuplicates": true,
	},
}
