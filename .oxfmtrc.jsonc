{
	// Canonical vault files use semantic-board-store's deterministic serializer.
	// Reformatting outside that owner would bypass board versions and live updates.
	"ignorePatterns": [".archboard/vault/**/*.semantic.json"],
	"useTabs": true,
	"printWidth": 100,
	"quoteStyle": "double",
	"semicolons": "always",
	"trailingComma": "all",
	"endOfLine": "lf",
	"sortTailwindcss": {
		"functions": ["cn"],
		"preserveDuplicates": true,
	},
}
