{
	"name": "@archboard/renderer",
	"version": "0.0.0",
	"private": true,
	"description": "Hosts the renderer core in Bun and the browser, runs its layout workers and rasterizer, and supplies the shared stylesheet and fonts.",
	"license": "BUSL-1.1",
	"type": "module",
	"imports": {
		"#*": "./src/*",
		"#tests/*": "./tests/*"
	},
	"exports": {
