{
	// The declarations of the npm build of @archboard/codex-realtime-voice
	// (scripts/pack-codex-realtime-voice.ts): the package and the workspace packages that the build
	// bundles. TypeScript emits no declaration for a file it reaches through node_modules, so each
	// one is named here, and the file sits at the root so that all of them are under its rootDir.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"]
	},
	"include": [
		"packages/codex-realtime-voice/src",
		"packages/codex-app-server/src",
		"packages/process/src",
		"packages/timing/src",
		"packages/diagnostics/src"
	],
	"exclude": ["node_modules", "dist"]
}
