---
// The CLI as a whole: how a command finds its vault and its server, what it prints, the exit
// codes, the shared options, and an index of every command.
import { Code } from "astro-expressive-code/components";
import Docs from "../../../../layouts/Docs.astro";
import { cliGroups, docsHref } from "../../../../lib/docs-nav";
import { commandAnchor, commandsUnder, inlineCode, reference } from "../../../../lib/reference";
import { docsVersion, isRelease } from "../../../../lib/docs-version";

const headings = [
	{ depth: 2, slug: "output", text: "Output streams" },
	{ depth: 2, slug: "exit-codes", text: "Exit codes" },
	{ depth: 2, slug: "shared-options", text: "Shared options" },
	{ depth: 2, slug: "environment", text: "Environment variables" },
	{ depth: 2, slug: "commands", text: "All commands" },
];
// A top-level command that no group page names would have no page, so the build refuses it.
const grouped = new Set<string>(cliGroups.flatMap((group) => group.commands));
const loose = reference.commands.filter(
	(command) => !command.name.includes(" ") && !grouped.has(command.name),
);
if (loose.length > 0) {
	throw new Error(
		`No page of cliGroups in docs-nav.ts names ${loose.map((command) => command.name).join(", ")}`,
	);
}

---

<Docs
	title="CLI overview"
	description="CLI commands, output format, exit codes, shared options, and environment variables, generated directly from the CLI's contracts."
	path="reference/cli"
	headings={headings}
	source="site/scripts/reference.ts"
>
	<p>
		{
			isRelease ? (
				<>This reference matches release <code>{docsVersion}</code> of the CLI.</>
			) : (
				<>
					This reference is generated from the <code>main</code> branch after release{" "}
					<code>{reference.version}</code>, so an npm release may omit newly added options.
				</>
			)
		}{" "}
		Every command locates its vault from the current working directory (or the directory passed to{" "}
		<code>-C</code>), just like Git locates <code>.git</code>. Commands that require the local
		server start it automatically on loopback.
	</p>
	<Code
		code={`archboard [-C <dir>] [--url <url>] [--text] <command> [options]\narchboard help <command>`}
		lang="sh"
		frame="none"
	/>

	<h2 id="output" class="heading">
		Output streams<a class="heading-link" href="#output" aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
	</h2>
	<p>
		Commands write structured JSON to standard output and human-readable diagnostics to standard
		error. Scripts parse standard output while engineers read standard error. Pass{" "}
		<code>--text</code> anywhere before <code>--</code> to print colored text to standard output
		instead of JSON.
	</p>
	<Code
		code={`archboard check > check.json 2> check.log\necho "exit $?"`}
		lang="sh"
		frame="terminal"
		title="Capture both streams"
	/>

	<h2 id="exit-codes" class="heading">
		Exit codes<a class="heading-link" href="#exit-codes" aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
	</h2>
	<p>
		All commands share the exit codes below. Individual command pages list the specific refusal
		codes each command can return.
	</p>
	<table>
		<thead>
			<tr><th scope="col">Exit</th><th scope="col">Meaning</th></tr>
		</thead>
		<tbody>
			{reference.exitCodes.map(({ exit, meaning }) => (
				<tr>
					<td><code>{exit}</code></td>
					<td set:html={inlineCode(meaning)} />
				</tr>
			))}
		</tbody>
	</table>

	<h2 id="shared-options" class="heading">
		Shared options<a class="heading-link" href="#shared-options" aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
	</h2>
	<p>
		These global options apply across commands. Each command's help lists the shared options it
		accepts and rejects any others.
	</p>
	<table>
		<thead>
			<tr><th scope="col">Option</th><th scope="col">Description</th></tr>
		</thead>
		<tbody>
			{reference.shared.map((option) => (
				<tr>
					<td><code>{option.spellings.join(", ")} &lt;{option.placeholder}&gt;</code></td>
					<td>
						<span set:html={inlineCode(/[.!?]$/u.test(option.description) ? option.description : `${option.description}.`)} />
						{option.default && <> Default: <code>{option.default}</code>.</>}
					</td>
				</tr>
			))}
			<tr>
				<td><code>--text</code></td>
				<td>Print colored text instead of JSON.</td>
			</tr>
		</tbody>
	</table>

	<h2 id="environment" class="heading">
		Environment variables<a class="heading-link" href="#environment" aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
	</h2>
	<table>
		<thead>
			<tr><th scope="col">Variable</th><th scope="col">Description</th></tr>
		</thead>
		<tbody>
			{reference.environment.map(({ name, meaning }) => (
				<tr>
					<td><code>{name}</code></td>
					<td set:html={inlineCode(meaning)} />
				</tr>
			))}
		</tbody>
	</table>

	<h2 id="commands" class="heading">
		All commands<a class="heading-link" href="#commands" aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
	</h2>
	{
		cliGroups.map((group) => (
			<>
				<h3 class="group-head">
					<a href={docsHref(`reference/cli/${group.slug}`)} set:html={inlineCode(group.title)} />
				</h3>
				<table class="index">
					<tbody>
						{group.commands.flatMap((top) => commandsUnder(top)).map((command) => (
							<tr>
								<td>
									<a href={`${docsHref(`reference/cli/${group.slug}`)}#${commandAnchor(command.name)}`}>
										<code>{command.name}</code>
									</a>
								</td>
								<td set:html={inlineCode(command.summary)} />
							</tr>
						))}
					</tbody>
				</table>
			</>
		))
	}
</Docs>
