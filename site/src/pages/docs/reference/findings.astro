---
// Every code that a check reports, with what it means and whether it fails the check. The words
// are the CLI's own help, so a new finding appears here when the CLI learns it.
import Docs from "../../../layouts/Docs.astro";
import Aside from "../../../components/docs/Aside.astro";
import { findingAnchor, inlineCode, reference, type FindingEntry } from "../../../lib/reference";

const groups: { slug: string; title: string; text: string; entries: FindingEntry[] }[] = [
	{
		slug: "semantics",
		title: "Semantics check",
		text: "The semantics check reads the model against the vault's vocabulary. An error or a warning is a diagnostic, and each diagnostic fails the check.",
		entries: reference.findings.filter((entry) => entry.check === "semantics"),
	},
	{
		slug: "code",
		title: "Code check",
		text: "The code check reads the code and infrastructure that bindings and anchors name. A warning fails the check. Information never does.",
		entries: reference.findings.filter((entry) => entry.check === "code" && entry.severity !== "skip"),
	},
	{
		slug: "skipped",
		title: "What the code check skips",
		text: "A skip is something the check did not read, with the reason. A skip never fails the check, and it is listed so that an unread subject never looks clean.",
		entries: reference.findings.filter((entry) => entry.severity === "skip"),
	},
	{
		slug: "embeds",
		title: "Embeds check",
		text: "The embeds check finds each SVG and PNG that Git tracks and that carries a render recipe. It draws the recipe again and compares the result with the file. A warning fails the check. Information never does. A finding about a file of another repository is information, whatever its code, because that repository draws the file again only after the vault's change merges.",
		entries: reference.findings.filter((entry) => entry.check === "embeds"),
	},
];
const headings = groups.map((group) => ({ depth: 2, slug: group.slug, text: group.title }));
const label = { warning: "Warning, fails", error: "Error, fails", information: "Information", skip: "Skip" };
---

<Docs
	title="Check findings"
	description="Every code that `archboard check` reports, what it means, and whether it fails the check. Link to a code with its anchor, such as `#relationship-undrawn`."
	path="reference/findings"
	headings={headings}
	source="apps/cli/src/cli/commands/vault/operations/check-help.ts"
>
	<p>
		<code>archboard check</code> exits 1 while a semantic diagnostic or a warning remains. Information
		and skips print, and they never change the exit status. Each finding names its subject, and a
		code finding names the evidence that it rests on, with its file and line.
	</p>
	{
		groups.map((group) => (
			<>
				<h2 id={group.slug} class="heading">
					{group.title}
					<a class="heading-link" href={`#${group.slug}`} aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
				</h2>
				<p>{group.text}</p>
				<div class="codes">
					{group.entries.map((entry) => (
						<div class="code-row" id={findingAnchor(entry.codes[0] ?? "")}>
							<div class="code-head">
								<span class="code-names">
									{entry.codes.map((code, at) => (
										<a class="code-name" href={`#${findingAnchor(code)}`} id={at === 0 ? undefined : findingAnchor(code)}>
											<code>{code}</code>
										</a>
									))}
								</span>
								<span class:list={["severity", entry.severity]}>{label[entry.severity]}</span>
							</div>
							<p set:html={inlineCode(entry.text)} />
						</div>
					))}
				</div>
			</>
		))
	}
	<Aside type="tip" title="Keep a finding visible without failing">
		The check Action takes <code>allow-codes</code>. A listed code still shows on the pull request, and
		it never fails the step.
	</Aside>
</Docs>

<style>
	.codes {
		margin-top: 22px;
		border-radius: var(--radius-table);
		background: var(--plane);
		box-shadow:
			0 0 0 1px var(--rule-strong),
			var(--shadow-raised);
	}
	.code-row {
		padding: 16px 20px;
		scroll-margin-top: 96px;
		transition: background-color 400ms var(--ease-out);
	}
	.code-row + .code-row {
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.code-row:target,
	.code-row:has(.code-name:target) {
		background: oklch(0.86 0.125 86 / 0.06);
	}
	.code-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 16px;
	}
	.code-names {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
	}
	.code-name {
		text-decoration: none;
		/* The row's own margin, plus its top padding, so a second code's anchor shows the whole row. */
		scroll-margin-top: 112px;
	}
	.code-name code {
		font-size: 0.875rem !important;
		color: var(--ink);
	}
	.code-row p {
		margin-top: 8px;
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	.severity {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 22px;
		padding: 0 8px;
		border-radius: var(--radius-chip);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--ink-muted);
		background: var(--well);
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.severity::before {
		content: "";
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: currentColor;
	}
	.severity.warning {
		color: var(--changed-text);
		background: color-mix(in oklch, var(--changed) 14%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--changed) 40%, transparent);
	}
	.severity.error {
		color: var(--removed-text);
		background: color-mix(in oklch, var(--removed) 14%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--removed) 40%, transparent);
	}
</style>
