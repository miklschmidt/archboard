---
// Every code that a check reports, with what it means and whether it fails the check. The words
// are the CLI's own help, so a new finding appears here when the CLI learns it.
import Docs from "../../../layouts/Docs.astro";
import Aside from "../../../components/docs/Aside.astro";
import Exit from "../../../components/docs/Exit.astro";
import { findingAnchor, inlineCode, reference, type FindingEntry } from "../../../lib/reference";

const groups: { slug: string; title: string; text: string; entries: FindingEntry[] }[] = [
	{
		slug: "semantics",
		title: "Semantics check",
		text: "Validates the model against the vault's vocabulary and structural rules. Every error or warning is a diagnostic that fails the check.",
		entries: reference.findings.filter((entry) => entry.check === "semantics"),
	},
	{
		slug: "code",
		title: "Code check",
		text: "Validates bindings and anchors against source code and infrastructure files. Warnings fail the check. Information-level findings do not.",
		entries: reference.findings.filter((entry) => entry.check === "code" && entry.severity !== "skip"),
	},
	{
		slug: "skipped",
		title: "Skipped checks",
		text: "Items the code check could not inspect, along with the reason. Skips never fail the check and are listed explicitly so unread code is not mistaken for clean code.",
		entries: reference.findings.filter((entry) => entry.severity === "skip"),
	},
	{
		slug: "embeds",
		title: "Embeds check",
		text: "Finds Git-tracked SVG and PNG files containing a render recipe, re-renders them, and compares the output against the committed file. Warnings fail the check. Information-level findings do not. Findings for files in another repository stay at information severity because that repository regenerates them after the vault change merges.",
		entries: reference.findings.filter((entry) => entry.check === "embeds"),
	},
];
const headings = groups.map((group) => ({ depth: 2, slug: group.slug, text: group.title }));
const label = { warning: "Warning (fails)", error: "Error (fails)", information: "Information", skip: "Skip" };
---

<Docs
	title="Check findings"
	description="Reference for every code reported by `archboard check`, including severity and failure behavior. Link directly to a code with its anchor, such as `#relationship-undrawn`."
	path="reference/findings"
	headings={headings}
	source="apps/cli/src/cli/commands/vault/operations/check-help.ts"
>
	<p>
		<code>archboard check</code> exits <Exit outcome="issues" /> if any semantic diagnostic or
		warning is reported. Information-level findings and skips print to standard error without
		changing the exit code. Each finding identifies its subject, and code findings include supporting
		file and line evidence.
	</p>
	{
		groups.map((group) => (
			<>
				<h2 id={group.slug} class="heading">
					{group.title}
					<a class="heading-link" href={`#${group.slug}`} aria-label="Link to this section" data-heading-link data-pagefind-ignore>#</a>
				</h2>
				<p>{group.text}</p>
				<div class="codes">
					{group.entries.map((entry) => (
						<div class="code-row" id={findingAnchor(entry.codes[0] ?? "")}>
							<div class="code-head">
								<span class="code-names">
									{entry.codes.map((code, at) => (
										<a class="code-name" data-pagefind-weight="10" href={`#${findingAnchor(code)}`} id={at === 0 ? undefined : findingAnchor(code)}>
											<code>{code}</code>
										</a>
									))}
								</span>
								<span class:list={["severity", entry.severity]}>{label[entry.severity]}</span>
							</div>
							<p set:html={inlineCode(entry.text)} />
						</div>
					))}
				</div>
			</>
		))
	}
	<Aside type="tip" title="Report a finding without failing CI">
		Pass finding codes to the check Action's <code>allow-codes</code> input to keep them visible on
		pull requests without failing the job.
	</Aside>
</Docs>

<style>
	.codes {
		margin-top: 22px;
		border-radius: var(--radius-table);
		background: var(--plane);
		box-shadow:
			0 0 0 1px var(--rule-strong),
			var(--shadow-raised);
	}
	.code-row {
		padding: 16px 20px;
		transition: background-color 400ms var(--ease-out);
	}
	.code-row + .code-row {
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.code-row:target,
	.code-row:has(.code-name:target) {
		background: var(--gold-wash);
	}
	.code-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px 16px;
	}
	.code-names {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
	}
	.code-name {
		text-decoration: none;
		/* The row's top padding, so a second code's anchor shows the whole row below the bar. */
		scroll-margin-top: 16px;
	}
	.code-name code {
		font-size: 0.875rem !important;
		color: var(--ink);
	}
	.code-row p {
		margin-top: 8px;
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	.severity {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 22px;
		padding: 0 8px;
		border-radius: var(--radius-chip);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--ink-muted);
		background: var(--well);
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.severity::before {
		content: "";
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: currentColor;
	}
	.severity.warning {
		color: var(--changed-text);
		background: color-mix(in oklch, var(--changed) 14%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--changed) 40%, transparent);
	}
	.severity.error {
		color: var(--removed-text);
		background: color-mix(in oklch, var(--removed) 14%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--removed) 40%, transparent);
	}
</style>
