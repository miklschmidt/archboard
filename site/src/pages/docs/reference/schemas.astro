---
// The JSON Schemas of the model files and of the requests that write them, as trees a person can
// read. Each comes from the same validation that the CLI runs.
import { Code } from "astro-expressive-code/components";
import Docs from "../../../layouts/Docs.astro";
import Icon from "../../../components/Icon.astro";
import SchemaNode from "../../../components/docs/SchemaNode.astro";
import { reference, type JsonSchema } from "../../../lib/reference";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** Where each schema is used. */
const uses: Record<string, string> = {
	"model-manifest": "Vault manifest (`model.json`). Stores the model identity, name, and current state without duplicating module definitions.",
	module: "Single module file (`<id>.module.json`). Defines a module's metadata, child containment, outgoing relationships, and code binding.",
	flows: "Flow collection file (`<id>.flows.json`). Stores a named group of flows and their ordered steps.",
	"model-initialize": "Input payload for `archboard model init` to create an empty planning model.",
	"model-edit": "Input payload for `archboard model edit --input`: expected revision, claim, and a batch of model operations.",
	"model-import": "Portable archive payload for `archboard model import`, including retained history.",
	"model-migrate": "Input payload for migrating a legacy vault to the canonical model format.",
	"vault-config": "Vault configuration (`.archboard/config.yaml`). Defines module kinds, relationship kinds, accepted evidence, lenses, and code-check rules.",
};

const headings = reference.schemas.map((entry) => ({ depth: 2, slug: entry.name, text: entry.title }));
const defsOf = (schema: JsonSchema): Record<string, JsonSchema> =>
	(schema["$defs"] as Record<string, JsonSchema> | undefined) ?? {};
const inline = (text: string) =>
	text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replace(/`([^`]+)`/g, "<code>$1</code>");
---

<Docs
	title="Schemas"
	description="JSON Schemas for vault files and CLI write payloads, generated directly from the CLI's validators."
	path="reference/schemas"
	headings={headings}
	source="apps/cli/src/cli/commands/model/operations/schema.ts"
>
	<p>
		Agents should read schemas directly from the installed CLI on <code>PATH</code> so definitions
		always match the running version. Schema validation checks JSON structure only. Write commands
		also validate names, identities, claims, and revision digests.
	</p>
	<Code code={`archboard model schema\narchboard model schema model-edit > model-edit.schema.json`} lang="sh" frame="terminal" />
	{
		reference.schemas.map((entry) => (
			<section class="schema" aria-labelledby={entry.name}>
				<h2 id={entry.name} class="heading">
					{entry.title}
					<a class="heading-link" href={`#${entry.name}`} aria-label="Link to this schema" data-heading-link data-pagefind-ignore>#</a>
				</h2>
				<p set:html={inline(uses[entry.name] ?? "")} />
				<div class="schema-bar">
					<code class="schema-command">archboard model schema {entry.name}</code>
					<a class="schema-file" href={`${base}/docs/reference/schemas/${entry.name}.json`}>
						<Icon name="fileCode" size={15} />
						{entry.name}.json
					</a>
				</div>
				<div class="schema-tree">
					<SchemaNode name={null} schema={entry.schema} depth={0} defs={defsOf(entry.schema)} />
				</div>
			</section>
		))
	}
</Docs>

<style>
	.schema-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}
	.schema-file {
		display: inline-flex;
		font-family: var(--font-mono);
		align-items: center;
		gap: 6px;
		height: 30px;
		padding: 0 10px;
		border-radius: var(--radius-control);
		background: var(--raised);
		color: var(--ink) !important;
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
		transition: background-color 160ms var(--ease-out);
	}
	.schema-file:hover {
		background: var(--slab);
	}
	.schema-tree {
		margin-top: 18px;
		padding: 8px 20px 12px 4px;
		border-radius: var(--radius-table);
		background: var(--plane);
		box-shadow:
			0 0 0 1px var(--rule-strong),
			var(--shadow-raised);
	}
	.schema + .schema {
		margin-top: 0;
	}
</style>
