---
// An agent's claim as a pane shows it, and the reader's Take back control. After take-back the
// former intent's next edit is refused with the real CLAIM_REVOKED answer and the architecture
// stays as it was.
import Icon from "../Icon.astro";
---

<div class="takeback table" data-takeback>
	<div class="claim-card">
		<div class="claim-head">
			<span class="live"><span class="dot"></span><span data-claim-state>Claimed</span></span>
			<span class="mono since">since 14:02</span>
		</div>
		<dl class="facts">
			<div><dt>Writer</dt><dd>codex</dd></div>
			<div><dt>Doing</dt><dd>rewording Checkout API</dd></div>
			<div><dt>Subjects</dt><dd>Checkout API, Place order</dd></div>
		</dl>
		<button type="button" class="take" data-take>
			<Icon name="unlock" size={16} /> <span data-take-label>Take back control</span>
		</button>
	</div>
	<div class="term">
		<p class="t"><span class="ps">$</span> archboard model claim --input claim.json</p>
		<p class="t out">Claimed Checkout API and Place order for codex: rewording Checkout API</p>
		<p class="t wait" data-before>Press Take back control.</p>
		<p class="t" data-after hidden><span class="ps">$</span> archboard model edit --input edit.json --doing "rewording Checkout API"</p>
		<p class="t err" data-after hidden>CLAIM_REVOKED: The claim ended. Stop this intent and obtain a new claim before another write.</p>
	</div>
</div>

<style>
	.takeback {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: 6px;
		padding: 6px;
		background: var(--chrome);
	}
	.claim-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 18px;
		border-radius: 6px;
		background: var(--plane);
		box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--live) 35%, transparent);
		transition: box-shadow 400ms var(--ease-out);
	}
	.claim-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.live {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		color: var(--ink);
	}
	.live .dot {
		color: var(--live);
		box-shadow: 0 0 0 4px color-mix(in oklch, var(--live) 22%, transparent);
	}
	.since {
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.facts {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin: 0;
		font-size: 0.875rem;
	}
	.facts div {
		display: grid;
		grid-template-columns: 80px 1fr;
		gap: 8px;
	}
	.facts dt {
		color: var(--ink-muted);
	}
	.facts dd {
		margin: 0;
		color: var(--ink);
	}
	.take {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 36px;
		padding: 0 14px;
		border: 0;
		border-radius: 4px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge),
			0 1px 0 oklch(0.06 0.004 75 / 0.8);
		cursor: pointer;
	}
	.take:active {
		transform: translateY(1px);
	}
	.takeback.is-taken .claim-card {
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.takeback.is-taken .live .dot {
		color: var(--ink-faint);
		box-shadow: none;
	}
	.takeback.is-taken .take {
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.term {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 8px;
		padding: 18px;
		border-radius: 6px;
		background: oklch(0.155 0.005 75);
		box-shadow: inset 0 0 0 1px var(--rule);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--ink);
	}
	.t {
		word-break: break-word;
	}
	.ps {
		color: var(--gold-mark);
	}
	.out {
		color: var(--ink-muted);
	}
	.err {
		color: var(--removed);
	}
	.wait {
		color: var(--ink-muted);
		font-family: var(--font-body);
	}
	.t[data-after]:not([hidden]) {
		animation: arrive 420ms var(--ease-out);
	}
	@keyframes arrive {
		from {
			opacity: 0;
			translate: 0 4px;
		}
	}
	@media (max-width: 720px) {
		.takeback {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-takeback]")) {
		const button = root.querySelector<HTMLButtonElement>("[data-take]");
		const state = root.querySelector<HTMLElement>("[data-claim-state]");
		const label = root.querySelector<HTMLElement>("[data-take-label]");
		if (!button || !state || !label) continue;
		let taken = false;
		button.addEventListener("click", () => {
			taken = !taken;
			root.classList.toggle("is-taken", taken);
			state.textContent = taken ? "Taken back" : "Claimed";
			label.textContent = taken ? "Reset the example" : "Take back control";
			for (const line of root.querySelectorAll<HTMLElement>("[data-after]")) line.hidden = !taken;
			for (const line of root.querySelectorAll<HTMLElement>("[data-before]")) line.hidden = taken;
		});
	}
</script>
