---
// Two competing proposals for a recommendations service, branched from one starting point and
// open in two panes, as the shell shows them. Both drawings are real renders.
import { drawings } from "../../lib/diagrams";

const panes = [
	{
		drawing: drawings.nightlyBatch,
		name: "Nightly batch",
		summary: "Build every product's list once a night from 90 days of orders.",
		counts: "4 added · 1 changed · 9 unchanged",
		alt: "The Nightly batch proposal: a new Nightly job reads a new Orders replica and replaces every list in Suggestions, which is marked changed.",
	},
	{
		drawing: drawings.liveEvents,
		name: "Live events",
		summary: "Score product pairs as shoppers browse, so suggestions follow today's shopping.",
		counts: "7 added · 2 removed · 1 changed · 7 unchanged",
		alt: "The Live events proposal: new Shopper events, Live scorer and Pair scores modules in green, and the Suggestions store removed as a red ghost.",
	},
];
---

<div class="options">
	{
		panes.map((pane, index) => (
			<figure class="pane table" data-reveal style={`--reveal-delay: ${index * 120}`}>
				<figcaption class="pane-head">
					<span class="pane-letter mono">{index === 0 ? "A" : "B"}</span>
					<span class="pane-name">{pane.name}</span>
					<span class="pane-from">from Starting point</span>
				</figcaption>
				<div class="pane-body">
					<img
						src={pane.drawing.url}
						width={pane.drawing.width}
						height={pane.drawing.height}
						alt={pane.alt}
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="pane-foot">
					<p>{pane.summary}</p>
					<p class="mono counts">{pane.counts}</p>
				</div>
			</figure>
		))
	}
</div>

<style>
	.options {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.pane {
		display: flex;
		flex-direction: column;
		margin: 0;
		background: var(--chrome);
		overflow: hidden;
	}
	.pane-head {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 48px;
		padding: 0 16px;
		box-shadow: inset 0 -1px 0 var(--rule);
	}
	.pane-letter {
		display: inline-grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 3px;
		font-size: 0.75rem;
		background: var(--raised);
		color: var(--ink);
		box-shadow: var(--shadow-raised);
	}
	.pane-name {
		font-weight: 600;
		color: var(--ink);
	}
	.pane-from {
		margin-left: auto;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	/* Both frames take one height, so the captions line up. It fits the taller drawing, Live
	   events (1174 by 654 with its legend), and its padding. Overflow hidden holds the ratio
	   whatever a redraw makes of a drawing. */
	.pane-body {
		display: grid;
		place-items: center;
		aspect-ratio: 1174 / 720;
		padding: 18px;
		overflow: hidden;
		background: oklch(0.2 0.006 75);
	}
	.pane-body img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.pane-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 6px 16px;
		padding: 14px 16px 16px;
		font-size: 0.9375rem;
		color: var(--ink-body);
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.counts {
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	@media (max-width: 860px) {
		.options {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
