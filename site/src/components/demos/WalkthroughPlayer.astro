---
// A walkthrough playing over real drawings: the example shop's "How an order is placed today",
// in the column the shell presents a walkthrough in. Each step selects its parts with the
// renderer's own gold ring and dims the rest. The column holds the rail, the step's number, its
// heading and words, and the walkthrough's name, then the Narrate key and the keys that step.
// While the voice narrates, the key hangs up, and the voice box stands low over the picture with
// the orb and the words as they are said. In the product the Codex voice speaks them.
import Icon from "../Icon.astro";
import { drawings, inline } from "../../lib/diagrams";
import { walkthrough } from "../../lib/walkthrough";

const picture = inline(drawings.checkout.raw, "walk");
const sequence = drawings.sequence;
const first = walkthrough.beats[0];
---

<div class="player table" data-walkthrough={JSON.stringify(walkthrough.beats)}>
	<div class="stage" data-grammar="architecture">
		<figure class="view architecture" role="img" aria-hidden="false" aria-label={`Inside Checkout API, rendered by Archboard: ${drawings.checkout.label}`}>
			<Fragment set:html={picture} />
		</figure>
		<img
			class="view sequence"
			aria-hidden="true"
			src={sequence.url}
			width={sequence.width}
			height={sequence.height}
			alt="Sequence diagram for placing an order: Place order reserves stock, charges the card, saves the order, and sends the receipt."
			loading="lazy"
			decoding="async"
		/>
		<div class="voice" data-voice-box aria-hidden="true">
			<span class="socket"><canvas class="orb" data-orb></canvas></span>
			<span class="said" data-said><span class="voice-word" data-voice-word>Starting</span></span>
			<span class="voice-keys">
				<span class="cap-key"><Icon name="mic" size={16} /></span>
				<span class="cap-key"><Icon name="captions" size={16} /></span>
			</span>
		</div>
	</div>
	<div class="box">
		<nav class="rail" aria-label="Steps">
			{
				walkthrough.beats.map((beat, index) => (
					<button
						type="button"
						class:list={["seg", { "is-on": index === 0 }]}
						aria-current={index === 0 ? "step" : undefined}
						aria-label={`Step ${index + 1}: ${beat.title}`}
						title={`Step ${index + 1}: ${beat.title}`}
					/>
				))
			}
		</nav>
		<div class="step">
			<p class="figure" aria-hidden="true">
				<span class="number" data-step-number>1</span>
				<span class="mono of">of {walkthrough.beats.length}</span>
			</p>
			<div class="words">
				<p class="beat-title" data-beat-title aria-live="polite">{first?.title}</p>
				<p class="subtitle" data-subtitle>{first?.narrative}</p>
				<p class="name">{walkthrough.name}</p>
			</div>
		</div>
		<div class="foot">
			<button type="button" class="narrate" data-narrate aria-label="Narrate">
				<span class="seat" aria-hidden="true">
					<span class="disc"><Icon name="mic" size={20} /></span>
					<span class="hang-up"><Icon name="phone" size={20} /></span>
				</span>
				<span class="key-words">
					<span class="when-paused">
						<span class="key-name">Narrate</span>
						<span class="key-hint">Hear this walkthrough read aloud.</span>
					</span>
					<span class="when-playing">
						<span class="key-name">Hang up</span>
						<span class="key-hint">End the voice.</span>
					</span>
				</span>
			</button>
			<div class="keys">
				<button type="button" class="ctl" data-prev aria-label="Previous step"><Icon name="chevronLeft" /></button>
				<button type="button" class="ctl" data-next aria-label="Next step"><Icon name="chevronRight" /></button>
				<span class="ctl leave" aria-hidden="true"><Icon name="close" size={16} /><span class="mono">Esc</span></span>
			</div>
		</div>
	</div>
</div>

<style>
	.player {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 400px;
		background: var(--chrome);
		overflow: hidden;
	}
	.stage {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 560px;
		/* The foot leaves the voice box its room, so the picture never lies under it. */
		padding: 28px 28px 116px;
		background:
			radial-gradient(90% 70% at 40% 30%, oklch(0.235 0.012 80 / 0.7), transparent 70%),
			oklch(0.2 0.006 75);
	}
	.view {
		grid-area: 1 / 1;
		width: 100%;
		max-height: 620px;
		margin: 0;
		transition:
			opacity 520ms var(--ease-in-out),
			filter 520ms var(--ease-in-out),
			scale 520ms var(--ease-in-out);
	}
	.view.architecture :global(svg) {
		width: 100%;
		height: auto;
		max-height: 620px;
	}
	.view.sequence {
		object-fit: contain;
		height: 100%;
	}
	.stage[data-grammar="architecture"] .sequence,
	.stage[data-grammar="sequence"] .architecture {
		opacity: 0;
		filter: blur(6px);
		scale: 0.97;
		pointer-events: none;
	}
	.architecture :global(g[data-semantic-kind]),
	.architecture :global([data-members]),
	.architecture :global(g[data-traffic]) {
		transition: opacity 420ms var(--ease-out);
	}
	.architecture :global(g[data-semantic-kind]) {
		cursor: default;
	}
	.architecture:global(.is-focused) :global(g[data-semantic-kind]:not(.is-lit)),
	.architecture:global(.is-focused) :global(g.ab-shadow:not(.is-lit)),
	.architecture:global(.is-focused) :global([data-members]:not(.is-lit)),
	.architecture:global(.is-focused) :global(g[data-traffic]:not(.is-lit)) {
		opacity: 0.28;
	}
	/* The voice box: a capsule low over the picture while the voice narrates, the orb in its
	   socket at the left end, the words as they are said, and the voice's two keys at the right
	   end, as a stack that follows the capsule's round end. */
	.voice {
		position: absolute;
		left: 50%;
		bottom: 20px;
		display: flex;
		align-items: center;
		width: min(560px, calc(100% - 40px));
		height: 78px;
		translate: -50% 0;
		border-radius: 39px;
		background: var(--card);
		box-shadow:
			inset 0 0 0 1px var(--rule),
			0 18px 40px -12px oklch(0.06 0.004 75 / 0.7);
		opacity: 0;
		transition: opacity 320ms var(--ease-out);
		pointer-events: none;
	}
	.player.is-playing .voice {
		opacity: 1;
	}
	/* The product's orb canvas: 84px, with its 64px ring in the middle and room around it for
	   the rings of light. The painter reads its colours from these tokens. */
	.socket {
		flex: none;
		width: 64px;
		height: 64px;
		margin: 6px;
	}
	.orb {
		--card: var(--raised);
		--primary: var(--gold);
		width: 84px;
		max-width: none;
		height: 84px;
		margin: -10px;
	}
	/* Two lines at most: the newest words stand at the foot, and the older ones leave at the top. */
	.said {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-width: 0;
		max-height: 48px;
		margin: 0 12px 0 6px;
		overflow: hidden;
		font-size: 1rem;
		line-height: 24px;
		color: var(--ink-body);
	}
	.said :global(.w) {
		animation: said 640ms var(--ease-in-out) both;
	}
	@keyframes said {
		from {
			opacity: 0;
		}
	}
	.voice-word {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--gold-mark);
	}
	.voice-keys {
		display: flex;
		flex-direction: column;
		gap: 6px;
		width: 44px;
		height: 64px;
		margin: 6px 6px 6px 0;
	}
	.cap-key {
		flex: 1;
		display: grid;
		place-items: center;
		padding-right: 6px;
		color: var(--ink-muted);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.cap-key:first-child {
		border-radius: 4px 32px 0 4px / 4px 29px 0 4px;
	}
	.cap-key:last-child {
		border-radius: 4px 0 32px 4px / 4px 0 29px 4px;
	}
	/* The column, as the shell presents a walkthrough: the panel's chrome with a rule on its
	   left edge, 20px of padding and 20px between its parts. */
	.box {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 20px;
		background: var(--chrome);
		box-shadow: inset 1px 0 0 var(--rule);
	}
	/* One segment for each step: the steps before the one shown in gold, the ones after it in
	   muted ink, and the step shown as a taller piece of gold. */
	.rail {
		display: flex;
		align-items: center;
		gap: 4px;
		height: 24px;
	}
	.seg {
		position: relative;
		flex: 1;
		height: 24px;
		padding: 0;
		border: 0;
		border-radius: 4px;
		background: none;
		cursor: pointer;
	}
	.seg::before {
		content: "";
		position: absolute;
		inset: 50% 0 auto;
		translate: 0 -50%;
		height: 4px;
		border-radius: 4px;
		background: color-mix(in oklch, var(--ink-muted) 70%, transparent);
		transition:
			height 520ms var(--ease-in-out),
			background-color 150ms var(--ease-out);
	}
	.seg:hover::before {
		background: var(--ink-muted);
	}
	.seg.is-done::before {
		background: var(--gold-mark);
	}
	.seg.is-on::before {
		height: 6px;
		background: var(--gold-mark);
	}
	.step {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0 16px;
		flex: 1;
	}
	/* The step's number, as the sheet number of a drawing: the figure over "of N", with a rule on
	   its right. */
	.figure {
		display: flex;
		flex-direction: column;
		align-items: center;
		align-self: start;
		gap: 2px;
		width: 56px;
		padding-right: 20px;
		box-shadow: inset -1px 0 0 var(--rule);
	}
	.number {
		font-family: var(--font-display);
		font-size: 44px;
		line-height: 1;
		font-weight: 650;
		color: var(--ink);
	}
	.of {
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	/* Every step stands in one cell, as high as the highest, so stepping never moves the foot. */
	.words {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-height: 300px;
	}
	.beat-title {
		font-size: 1.375rem;
		line-height: 1.25;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-wrap: balance;
	}
	.subtitle {
		font-size: 1rem;
		line-height: 1.5;
		color: var(--ink-body);
	}
	.name {
		font-size: 0.8125rem;
		color: var(--ink-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.foot {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	/* The Narrate key: a pill sunk into the column, with the gold circle of the primary action at
	   its start. While the voice narrates it is the red hang-up key. */
	.narrate {
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		padding: 0 24px 0 0;
		border: 0;
		border-radius: 999px;
		background: var(--well);
		box-shadow: var(--shadow-well);
		color: var(--ink);
		text-align: left;
		cursor: pointer;
	}
	.narrate:disabled {
		cursor: default;
	}
	.seat {
		position: relative;
		flex: none;
		width: 64px;
		height: 64px;
		margin: 6px;
	}
	.disc,
	.hang-up {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border-radius: 50%;
		transition:
			scale 260ms var(--ease-out),
			opacity 260ms var(--ease-out),
			translate 160ms var(--ease-out);
	}
	.disc {
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge),
			0 1px 0 oklch(0.06 0.004 75 / 0.8);
	}
	.narrate:not(:disabled):hover .disc {
		translate: 0 -1px;
	}
	.narrate:not(:disabled):active .disc {
		translate: 0 1px;
	}
	.hang-up {
		color: white;
		background: oklch(0.58 0.2 25);
		scale: 0;
	}
	.hang-up :global(svg) {
		rotate: 135deg;
	}
	.player.is-playing .narrate .disc {
		scale: 0;
		opacity: 0;
	}
	.player.is-playing .narrate .hang-up {
		scale: 1;
	}
	.key-words {
		display: grid;
		min-width: 0;
	}
	.when-paused,
	.when-playing {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		min-width: 0;
		transition: opacity 200ms var(--ease-out);
	}
	.when-playing,
	.player.is-playing .narrate .when-paused {
		opacity: 0;
	}
	.player.is-playing .narrate .when-playing {
		opacity: 1;
	}
	.narrate:disabled .key-words {
		opacity: 0.6;
	}
	.key-name {
		font-size: 0.875rem;
		font-weight: 500;
	}
	.key-hint {
		font-size: 0.8125rem;
		color: var(--ink-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.keys {
		display: flex;
		justify-content: flex-end;
		gap: 6px;
	}
	.ctl {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		height: 32px;
		min-width: 32px;
		padding: 0 8px;
		border: 0;
		border-radius: 4px;
		background: var(--card);
		color: var(--ink);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
		cursor: pointer;
		transition: background-color 160ms var(--ease-out);
	}
	.ctl:hover {
		background: var(--slab);
	}
	/* A key with nowhere to go is dimmed and stays a key. */
	.ctl[aria-disabled="true"] {
		opacity: 0.5;
		cursor: default;
	}
	.ctl.leave {
		cursor: default;
	}
	.ctl.leave:hover {
		background: var(--card);
	}
	.leave .mono {
		font-size: 0.75rem;
	}
	@media (max-width: 960px) {
		.player {
			grid-template-columns: minmax(0, 1fr);
		}
		.stage {
			min-height: 0;
			padding: 16px 16px 112px;
		}
		.words {
			min-height: 240px;
		}
	}
</style>

<script>
	import { prefersReducedMotion, whileVisible } from "../../scripts/reveal";
	import { mountVoiceOrb, sayWord, wordLevel, type OrbMode, type SpokenWord } from "../../scripts/voice-orb";
	import type { Beat } from "../../lib/walkthrough";

	for (const root of document.querySelectorAll<HTMLElement>("[data-walkthrough]")) {
		const beats = JSON.parse(root.dataset["walkthrough"] ?? "[]") as Beat[];
		const stage = root.querySelector<HTMLElement>(".stage");
		const figure = root.querySelector<HTMLElement>(".view.architecture");
		const title = root.querySelector<HTMLElement>("[data-beat-title]");
		const subtitle = root.querySelector<HTMLElement>("[data-subtitle]");
		const number = root.querySelector<HTMLElement>("[data-step-number]");
		const said = root.querySelector<HTMLElement>("[data-said]");
		const voiceWord = root.querySelector<HTMLElement>("[data-voice-word]");
		const narrate = root.querySelector<HTMLButtonElement>("[data-narrate]");
		const previous = root.querySelector<HTMLButtonElement>("[data-prev]");
		const next = root.querySelector<HTMLButtonElement>("[data-next]");
		const segments = [...root.querySelectorAll<HTMLButtonElement>(".seg")];
		const orb = root.querySelector<HTMLCanvasElement>("[data-orb]");
		if (!stage || !figure || !title || !subtitle || !number || !said || !voiceWord || !narrate || !previous || !next || !orb) continue;

		let index = 0;
		let playing = false;
		let timer = 0;
		/** The word being said. */
		let word: SpokenWord | null = null;
		let startedAt = 0;
		let onScreen = false;
		let paused = false;

		const select = (beat: Beat) => {
			stage.dataset["grammar"] = beat.grammar;
			for (const view of stage.querySelectorAll(".view")) view.setAttribute("aria-hidden", String(!view.classList.contains(beat.grammar)));
			for (const lit of figure.querySelectorAll(".is-lit, .is-selected")) lit.classList.remove("is-lit", "is-selected");
			figure.classList.toggle("is-focused", beat.selection.length > 0);
			const standing = new Set(beat.selection);
			for (const id of beat.selection) {
				for (const part of figure.querySelectorAll(`[data-semantic-id="${id}"]`)) {
					part.classList.add("is-lit");
					if (!part.hasAttribute("data-semantic-part")) part.classList.add("is-selected");
				}
			}
			for (const traffic of figure.querySelectorAll("[data-traffic]")) {
				if (standing.has(traffic.getAttribute("data-traffic") ?? "")) traffic.classList.add("is-lit");
			}
			for (const mark of figure.querySelectorAll("[data-members]")) {
				const members = mark.getAttribute("data-members")?.split(/\s+/u) ?? [];
				if (members.some((id) => standing.has(id))) mark.classList.add("is-lit");
			}
		};

		// The column shows the whole step, and the voice box gets the words as they are said.
		const show = (to: number, speak: boolean) => {
			window.clearTimeout(timer);
			index = (to + beats.length) % beats.length;
			const beat = beats[index];
			if (!beat) return;
			select(beat);
			title.textContent = beat.title;
			subtitle.textContent = beat.narrative;
			number.textContent = String(index + 1);
			segments.forEach((segment, at) => {
				segment.classList.toggle("is-on", at === index);
				segment.classList.toggle("is-done", at < index);
				if (at === index) segment.setAttribute("aria-current", "step");
				else segment.removeAttribute("aria-current");
			});
			previous.setAttribute("aria-disabled", String(index === 0));
			next.setAttribute("aria-disabled", String(index === beats.length - 1));
			said.replaceChildren(voiceWord);
			voiceWord.textContent = speak ? "Starting" : "Listening";
			if (!speak || prefersReducedMotion()) return;
			const words = beat.narrative.split(" ");
			const line = document.createElement("span");
			let at = 0;
			const say = () => {
				if (!playing) return;
				const text = words[at];
				if (text === undefined) {
					word = null;
					timer = window.setTimeout(() => show(index + 1, true), 1600);
					return;
				}
				if (at === 0) said.replaceChildren(line);
				const span = document.createElement("span");
				span.className = "w";
				span.textContent = text;
				line.append(...(at === 0 ? [span] : [document.createTextNode(" "), span]));
				const spoken = sayWord(text, performance.now());
				word = spoken.word;
				at += 1;
				timer = window.setTimeout(say, spoken.ms);
			};
			timer = window.setTimeout(say, 500);
		};

		const setPlaying = (value: boolean) => {
			playing = value;
			root.classList.toggle("is-playing", value);
			narrate.setAttribute("aria-label", value ? "Hang up" : "Narrate");
			word = null;
			startedAt = performance.now();
			show(index, value);
			wakeOrb();
		};

		narrate.addEventListener("click", () => {
			paused = playing;
			setPlaying(!playing);
		});
		previous.addEventListener("click", () => {
			if (index > 0) show(index - 1, playing);
		});
		next.addEventListener("click", () => {
			if (index < beats.length - 1) show(index + 1, playing);
		});
		segments.forEach((segment, at) => {
			segment.addEventListener("click", () => show(at, playing));
		});

		// The voice connects for half a second, the time before the first word, then speaks.
		const voiceMode = (): OrbMode => {
			if (!playing) return "listening";
			return performance.now() - startedAt < 500 ? "starting" : "speaking";
		};
		const voiceLevel = () => (playing ? wordLevel(word, performance.now()) : 0);
		const wakeOrb = mountVoiceOrb(orb, { mode: voiceMode, level: voiceLevel });
		show(0, false);
		const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const settle = () => {
			narrate.disabled = motion.matches;
			if (motion.matches) setPlaying(false);
		};
		motion.addEventListener("change", settle);
		settle();

		// The motion preference is read at each start, so changing it mid-visit takes effect.
		whileVisible(root, (visible) => {
			if (visible && !onScreen && !playing && !paused && !prefersReducedMotion()) setPlaying(true);
			if (!visible && playing) setPlaying(false);
			onScreen = visible;
		});
	}
</script>
