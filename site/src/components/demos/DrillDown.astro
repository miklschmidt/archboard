---
// Open a module and the camera flies into its card: the shop's picture falls out of focus and
// the Inventory service's own picture blooms out of the card's middle. Back flies out again.
// Both pictures are real renders (DESIGN.md, the Card Is a Window Rule).
import Icon from "../Icon.astro";
import { cardBox, drawings } from "../../lib/diagrams";

const outer = drawings.webShop;
const inner = drawings.inventory;
const box = cardBox(outer.raw, "Shop/MKhTEYqf#HYDbL5fE");
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`;
const centerX = ((box.x + box.width / 2) / outer.width) * 100;
const centerY = ((box.y + box.height / 2) / outer.height) * 100;
const scale = (0.92 * outer.width) / box.width;
const vars = [
	`--card-x: ${pct(box.x, outer.width)}`,
	`--card-y: ${pct(box.y, outer.height)}`,
	`--card-w: ${pct(box.width, outer.width)}`,
	`--card-h: ${pct(box.height, outer.height)}`,
	`--cx: ${centerX.toFixed(3)}%`,
	`--cy: ${centerY.toFixed(3)}%`,
	`--tx: ${(50 - centerX).toFixed(3)}%`,
	`--ty: ${(50 - centerY).toFixed(3)}%`,
	`--zoom: ${scale.toFixed(3)}`,
].join("; ");
---

<div class="drill table" data-drill data-loop style={vars}>
	<div class="bar">
		<nav class="crumbs" aria-label="Breadcrumbs">
			<button type="button" class="crumb" data-back>Shop</button>
			<span class="sep" aria-hidden="true"><Icon name="chevronRight" size={14} /></span>
			<span class="crumb here" data-here>Inventory service</span>
		</nav>
		<button type="button" class="open" data-open>
			Open Inventory service <Icon name="arrowRight" size={16} />
		</button>
		<button type="button" class="open back" data-back-button>
			<Icon name="back" size={16} /> Back to Shop
		</button>
	</div>
	<div class="stage">
		<div class="layer outer">
			<img
				src={outer.url}
				width={outer.width}
				height={outer.height}
				alt="The example shop's root modules, drawn by Archboard."
				loading="lazy"
				decoding="async"
			/>
			<button type="button" class="card-hit" data-open aria-label="Open Inventory service">
				<span class="ring" aria-hidden="true"></span>
			</button>
		</div>
		<div class="layer inner" aria-hidden="true">
			<img
				src={inner.url}
				width={inner.width}
				height={inner.height}
				alt="Inside Inventory service: Stock API, Reservation ledger, Warehouse sync and Stock DB, with the modules outside that reach them."
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</div>

<style>
	.drill {
		padding: 6px;
		background: var(--chrome);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 48px;
		padding: 4px 8px 10px;
	}
	.crumbs {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 0.9375rem;
	}
	.crumb {
		height: 30px;
		padding: 0 8px;
		border: 0;
		border-radius: 3px;
		background: none;
		font-weight: 650;
		color: var(--ink);
	}
	button.crumb {
		cursor: pointer;
	}
	.drill:not(.is-open) button.crumb {
		pointer-events: none;
	}
	.drill.is-open button.crumb {
		color: var(--ink-muted);
		font-weight: 500;
	}
	.drill.is-open button.crumb:hover {
		color: var(--ink);
		background: oklch(1 0.01 85 / 0.05);
	}
	.sep,
	.here {
		opacity: 0;
		translate: -6px 0;
		transition:
			opacity 300ms var(--ease-out),
			translate 300ms var(--ease-out);
	}
	.here {
		display: inline-flex;
		align-items: center;
	}
	.sep {
		color: var(--ink-faint);
	}
	.drill.is-open .sep,
	.drill.is-open .here {
		opacity: 1;
		translate: 0 0;
	}
	.open {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		gap: 8px;
		white-space: nowrap;
		height: 34px;
		padding: 0 14px;
		border: 0;
		border-radius: 4px;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge),
			0 1px 0 oklch(0.06 0.004 75 / 0.8);
	}
	.open.back {
		display: none;
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.drill.is-open .open:not(.back) {
		display: none;
	}
	.drill.is-open .open.back {
		display: inline-flex;
	}
	.stage {
		position: relative;
		aspect-ratio: 1002 / 691;
		border-radius: 6px;
		overflow: hidden;
		background: oklch(0.2 0.006 75);
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.layer {
		position: absolute;
		inset: 0;
	}
	.layer img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.outer {
		transform-origin: var(--cx) var(--cy);
		transition:
			transform 820ms var(--ease-in-out),
			filter 820ms var(--ease-in-out),
			opacity 520ms var(--ease-in-out) 300ms;
	}
	.drill.is-open .outer {
		transform: translate(var(--tx), var(--ty)) scale(var(--zoom));
		filter: blur(5px);
		opacity: 0;
	}
	.inner {
		display: grid;
		place-items: center;
		padding: 3%;
		opacity: 0;
		transform: scale(0.42);
		filter: blur(6px);
		transition:
			transform 720ms var(--ease-out),
			opacity 520ms var(--ease-out),
			filter 720ms var(--ease-out);
		pointer-events: none;
	}
	.drill.is-open .inner {
		opacity: 1;
		transform: none;
		filter: none;
		transition-delay: 380ms;
	}
	.card-hit {
		position: absolute;
		left: var(--card-x);
		top: var(--card-y);
		width: var(--card-w);
		height: var(--card-h);
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
	}
	.ring {
		position: absolute;
		inset: -4px;
		border-radius: 10px;
		box-shadow: 0 0 0 2px var(--gold);
		opacity: 0.9;
	}
	@media (prefers-reduced-motion: no-preference) {
		.ring {
			animation: hint 2.4s var(--ease-in-out) infinite;
		}
	}
	@keyframes hint {
		50% {
			box-shadow:
				0 0 0 2px var(--gold),
				0 0 0 8px oklch(0.831 0.134 84.5 / 0.15);
		}
	}
	.drill.is-open .card-hit {
		pointer-events: none;
		opacity: 0;
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-drill]")) {
		const set = (open: boolean) => {
			root.classList.toggle("is-open", open);
			root.querySelector(".inner")?.setAttribute("aria-hidden", String(!open));
		};
		for (const button of root.querySelectorAll("[data-open]")) button.addEventListener("click", () => set(true));
		for (const button of root.querySelectorAll("[data-back], [data-back-button]"))
			button.addEventListener("click", () => set(false));
	}
</script>
