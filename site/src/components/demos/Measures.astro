---
// The Measures dialog's two tables that Archboard's own numbers answer, rebuilt for the page:
// what a module exposes and what changes together, one tab each, in the app's words. Each column
// header sorts its table, as in the shell. No score: every count describes the model or its
// commits. A module with no parts has no interface, so its interface counts stand blank.
import Icon from "../Icon.astro";
import { compareMeasures, measureRows, measureTabs } from "../../lib/measures";
import type { MeasureKey, MeasureRow } from "../../lib/measures";

/**
 * The rows sorted by one column, most first, the blanks last.
 * @param key The column.
 * @returns The rows.
 */
const sortedBy = (key: MeasureKey): MeasureRow[] =>
	measureRows.toSorted((one, other) => compareMeasures(one, other, key, true));
const most = (key: MeasureKey) => Math.max(1, ...measureRows.map((row) => row[key] ?? 0));
---

<div class="measures table" data-measures>
	<div class="head">
		<p class="title">Measures</p>
		<p class="note">Archboard's own model · 1 year of Git history</p>
	</div>
	<div class="tabs" role="tablist" aria-label="Measures">
		{
			measureTabs.map((tab, index) => (
				<button
					type="button"
					role="tab"
					class="tab"
					id={`measures-tab-${tab.key}`}
					aria-controls={`measures-panel-${tab.key}`}
					aria-selected={index === 0 ? "true" : "false"}
					tabindex={index === 0 ? 0 : -1}
					data-tab={tab.key}
				>
					<Icon name={tab.icon} size={16} />
					{tab.label}
				</button>
			))
		}
	</div>
	{
		measureTabs.map((tab, index) => {
			const sortKey = tab.columns[0].key;
			return (
				<div
					class="scroll"
					role="tabpanel"
					id={`measures-panel-${tab.key}`}
					aria-labelledby={`measures-tab-${tab.key}`}
					data-panel={tab.key}
					data-sorted={sortKey}
					hidden={index !== 0}
				>
					<table>
						<caption class="sr-only">
							{tab.label}, for Archboard's own modules. Select a column header to sort.
						</caption>
						<thead>
							<tr>
								<th scope="col" class="name-col">Module</th>
								{tab.columns.map((column) => (
									<th scope="col" aria-sort={column.key === sortKey ? "descending" : undefined}>
										<button type="button" data-sort={column.key} title={column.hint}>
											{column.label}
											<span class="arrow" aria-hidden="true" />
										</button>
									</th>
								))}
							</tr>
						</thead>
						<tbody>
							{sortedBy(sortKey).map((row) => (
								<tr data-row={JSON.stringify(row)}>
									<th scope="row" class="name-col">{row.name}</th>
									{tab.columns.map((column) => (
										<td
											data-key={column.key}
											class:list={{ "is-sorted": column.key === sortKey }}
											style={`--r: ${((row[column.key] ?? 0) / most(column.key)).toFixed(3)}`}
										>
											{row[column.key] ?? ""}
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
					{tab.key === "interface" && (
						<p class="foot">Blank cells mean the module has no child parts, so it has no container interface.</p>
					)}
				</div>
			);
		})
	}
</div>

<style>
	.measures {
		padding: 6px;
		background: var(--chrome);
	}
	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 14px 14px;
	}
	.title {
		font-weight: 600;
		color: var(--ink);
		font-size: 0.9375rem;
	}
	.note {
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	.tabs {
		display: flex;
		gap: 4px;
		padding: 0 6px 10px;
	}
	.tab {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border: 0;
		border-radius: 5px;
		background: none;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
		cursor: pointer;
		transition:
			background 200ms var(--ease-out),
			color 200ms var(--ease-out);
	}
	.tab:hover {
		color: var(--ink);
		background: oklch(1 0.01 85 / 0.04);
	}
	.tab[aria-selected="true"] {
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 -2px 0 var(--gold-mark);
	}
	.tab[aria-selected="true"] :global(svg) {
		color: var(--gold-mark);
	}
	.foot {
		padding: 10px 14px 6px;
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.scroll {
		overflow-x: auto;
		border-radius: 6px;
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	table {
		width: 100%;
		min-width: 420px;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 0.8125rem;
	}
	th,
	td {
		height: 38px;
		padding: 0 10px;
		text-align: right;
		white-space: nowrap;
	}
	thead th {
		height: 42px;
		font-weight: 500;
		color: var(--ink-muted);
		box-shadow: inset 0 -1px 0 var(--rule);
	}
	thead button {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 4px 6px;
		margin-right: -6px;
		border: 0;
		border-radius: 3px;
		background: none;
		font-size: 0.75rem;
		font-weight: 500;
		color: inherit;
		cursor: pointer;
		transition:
			color 160ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}
	thead button:hover {
		color: var(--ink);
		background: oklch(1 0.01 85 / 0.05);
	}
	th[aria-sort="descending"] button,
	th[aria-sort="ascending"] button {
		color: var(--ink);
		box-shadow: inset 0 -2px 0 var(--gold-mark);
		border-radius: 3px 3px 0 0;
	}
	.arrow {
		width: 0;
		height: 0;
		border-inline: 4px solid transparent;
		border-top: 5px solid currentColor;
		opacity: 0;
	}
	th[aria-sort="descending"] .arrow {
		opacity: 1;
	}
	th[aria-sort="ascending"] .arrow {
		opacity: 1;
		rotate: 180deg;
	}
	.name-col {
		text-align: left;
		padding-left: 14px;
		width: 34%;
	}
	tbody th {
		font-weight: 500;
		color: var(--ink);
	}
	tbody tr {
		transition: background-color 160ms var(--ease-out);
	}
	tbody tr:hover {
		background: oklch(1 0.01 85 / 0.035);
	}
	tbody tr + tr > * {
		box-shadow: inset 0 1px 0 oklch(1 0.01 85 / 0.05);
	}
	td {
		font-family: var(--font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--ink-body);
	}
	td.is-sorted {
		color: var(--ink);
	}
	td.is-sorted {
		background: linear-gradient(
			to left,
			color-mix(in oklch, var(--gold-mark) 16%, transparent) calc(var(--r) * 100%),
			transparent 0
		);
		box-shadow: inset -2px 0 0 color-mix(in oklch, var(--gold-mark) calc(var(--r) * 90%), transparent);
	}
</style>

<script>
	import type { MeasureKey, MeasureRow } from "../../lib/measures";
	import { mountTabs } from "../../scripts/tabs";
	import { compareMeasures } from "../../lib/measures";

	for (const root of document.querySelectorAll<HTMLElement>("[data-measures]")) {
		mountTabs(root);
		for (const panel of root.querySelectorAll<HTMLElement>("[data-panel]")) {
			const body = panel.querySelector("tbody");
			const buttons = [...panel.querySelectorAll<HTMLButtonElement>("[data-sort]")];
			if (!body) continue;
			let current = panel.dataset["sorted"] as MeasureKey;
			let descending = true;
			const sort = (key: MeasureKey) => {
				descending = key === current ? !descending : true;
				current = key;
				const rows = [...body.querySelectorAll<HTMLTableRowElement>("tr")];
				const data = (row: HTMLTableRowElement) => JSON.parse(row.dataset["row"] ?? "{}") as MeasureRow;
				rows.sort((one, other) => compareMeasures(data(one), data(other), key, descending));
				const before = new Map(rows.map((row) => [row, row.getBoundingClientRect().top]));
				body.append(...rows);
				for (const row of rows) {
					for (const cell of row.querySelectorAll<HTMLElement>("td")) {
						cell.classList.toggle("is-sorted", cell.dataset["key"] === key);
					}
					const moved = (before.get(row) ?? 0) - row.getBoundingClientRect().top;
					if (moved && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						row.animate([{ transform: `translateY(${moved}px)` }, { transform: "none" }], {
							duration: 420,
							easing: "cubic-bezier(0.16, 1, 0.3, 1)",
						});
					}
				}
				for (const button of buttons) {
					const th = button.closest("th");
					if (button.dataset["sort"] === key) {
						th?.setAttribute("aria-sort", descending ? "descending" : "ascending");
					} else {
						th?.removeAttribute("aria-sort");
					}
				}
			};
			for (const button of buttons) {
				button.addEventListener("click", () => sort(button.dataset["sort"] as MeasureKey));
			}
		}
	}
</script>
