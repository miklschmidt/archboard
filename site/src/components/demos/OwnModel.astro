---
// Archboard's own architecture, from this repository's vault, painted live by the product's
// painter. The whole picture fits the screen: the figure takes the page's width where the screen
// is wide enough, and no more than the screen's height. Without script, and wherever no painter
// draws, the renderer's SVG of the same reading stands.
import own from "../../paintings/own.json";
import ownSvg from "../../paintings/own.svg?url";
---

<figure class="own table" style={`--aspect: ${String(own.width / own.height)}`}>
	<div
		class="picture"
		data-own-model
		role="img"
		aria-label="Archboard's own architecture: its programs, the browser, Agent CLI and server, around the architecture inputs, with the workspace packages and the Rust drawing engine each in one container. External systems include Codex, Claude CLI, headless Chromium, ffmpeg and the Git remotes."
	>
		<img src={ownSvg} width={own.width} height={own.height} alt="" loading="lazy" decoding="async" />
		<canvas class="paint" aria-hidden="true"></canvas>
	</div>
	<figcaption class="caption">
		Archboard's own model, from <code>.archboard/vault</code> in its repository, painted live by the
		same painter the app uses.
	</figcaption>
</figure>

<style>
	.own {
		/* As wide as the page allows, and short enough that the whole picture and its caption fit
		   the screen. A wide screen takes the figure past the text's column. */
		--width: min(calc(100vw - var(--gutter) * 2), calc((100svh - 150px) * var(--aspect)));
		width: var(--width);
		margin: 0 calc((100% - var(--width)) / 2);
		padding: 6px;
		background: var(--chrome);
	}
	.picture {
		position: relative;
		aspect-ratio: var(--aspect);
		overflow: hidden;
		border-radius: 6px;
		/* The renderer's dark ground, which the painting starts from. */
		background: oklch(0.2 0.006 75);
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.paint,
	.picture img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}
	/* While a painter draws, the SVG waits unloaded behind it. */
	.paint,
	.picture[data-painting] img {
		display: none;
	}
	.picture[data-painting] .paint {
		display: block;
	}
	.caption {
		padding: 12px 10px 6px;
	}
	.caption code {
		font-size: 0.8em;
		color: var(--ink);
	}
</style>

<script>
	import { paintOwnModel } from "../../scripts/own-model";

	for (const picture of document.querySelectorAll<HTMLElement>("[data-own-model]")) {
		picture.setAttribute("data-painting", "");
		// The painter starts as the reader nears the drawing, so it is ready when the drawing is in view.
		const near = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				near.disconnect();
				void paintOwnModel(picture);
			},
			{ rootMargin: "800px 0px" },
		);
		near.observe(picture);
	}
</script>
