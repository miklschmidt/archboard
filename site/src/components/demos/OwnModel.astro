---
// Archboard's own architecture, from this repository's vault, painted live by the product's
// painter. The drawing is large, so the reader drags it, scrolls it, or moves it with the keyboard.
// Where the painter cannot start, the README's drawing of the same vault stands in.
import own from "../../paintings/own.json";
import { drawings } from "../../lib/diagrams";

const fallback = drawings.architecture;
---

<figure class="own table">
	<div
		class="viewport"
		data-own-model
		tabindex="0"
		role="img"
		aria-label="Archboard's own architecture: its programs, the browser, Agent CLI and server, around the architecture inputs, with each workspace package that holds parts. External systems include Codex, Claude CLI, headless Chromium, ffmpeg and the Git remotes. Drag or use the arrow keys to look around."
	>
		<div class="sheet" data-sheet style={`aspect-ratio: ${String(own.width)} / ${String(own.height)}`}>
			<canvas class="paint" aria-hidden="true"></canvas>
		</div>
		<template data-fallback>
			<img
				src={fallback.url}
				width={fallback.width}
				height={fallback.height}
				alt=""
				decoding="async"
				draggable="false"
			/>
		</template>
	</div>
	<figcaption class="caption">
		Archboard's own model, from <code>.archboard/vault</code> in its repository, painted live by the
		same painter the app uses. Drag to look around.
	</figcaption>
</figure>

<style>
	.own {
		margin: 0;
		padding: 6px;
		background: var(--chrome);
	}
	.viewport {
		height: clamp(360px, 58vw, 680px);
		overflow: auto;
		border-radius: 6px;
		background: oklch(0.2 0.006 75);
		box-shadow: inset 0 0 0 1px var(--rule);
		cursor: grab;
		scrollbar-width: thin;
		overscroll-behavior: contain;
	}
	.viewport:active {
		cursor: grabbing;
	}
	/* The sheet is as large as the drawing, so the viewport scrolls it. The canvas stays in view. */
	.sheet {
		width: max(2400px, 200%);
	}
	.paint {
		position: sticky;
		top: 0;
		left: 0;
		display: block;
	}
	.viewport img {
		width: max(1800px, 160%);
		max-width: none;
		height: auto;
		user-select: none;
	}
	.caption {
		padding: 12px 10px 6px;
	}
	.caption code {
		font-size: 0.8em;
		color: var(--ink);
	}
</style>

<script>
	import { paintOwnModel } from "../../scripts/own-model";

	for (const viewport of document.querySelectorAll<HTMLElement>("[data-own-model]")) {
		// The painter loads once the reader nears the drawing.
		const near = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				near.disconnect();
				void paintOwnModel(viewport).then((painted) => {
					if (painted) return;
					const fallback = viewport.querySelector<HTMLTemplateElement>("[data-fallback]");
					viewport.querySelector("[data-sheet]")?.replaceWith(fallback?.content.cloneNode(true) ?? "");
				});
			},
			{ rootMargin: "800px 0px" },
		);
		near.observe(viewport);

		let start: { x: number; y: number; left: number; top: number } | null = null;
		viewport.addEventListener("pointerdown", (event) => {
			if (event.pointerType !== "mouse") return;
			start = { x: event.clientX, y: event.clientY, left: viewport.scrollLeft, top: viewport.scrollTop };
			viewport.setPointerCapture(event.pointerId);
		});
		viewport.addEventListener("pointermove", (event) => {
			if (!start) return;
			viewport.scrollLeft = start.left - (event.clientX - start.x);
			viewport.scrollTop = start.top - (event.clientY - start.y);
		});
		const end = () => (start = null);
		viewport.addEventListener("pointerup", end);
		viewport.addEventListener("pointercancel", end);
	}
</script>
