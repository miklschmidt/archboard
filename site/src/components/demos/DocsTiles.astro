---
// Pictures that leave the application: a reading in a design document, the embed check that keeps
// it current, and the question a reader asks about a selected part.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";
import { drawings } from "../../lib/diagrams";

const picture = drawings.inventory;
---

<div class="tiles">
	<article class="tile doc table" data-reveal>
		<div class="doc-page" role="img" aria-label="Example design document with an Archboard drawing of Inventory service and its parts.">
			<p class="doc-path mono"><Icon name="fileText" size={14} /> docs/design/inventory.md</p>
			<p class="doc-title">Inventory</p>
			<p class="doc-text">
				Stock API is the only way in. The reservation ledger sets items aside only while enough are
				left, in one transaction with the counts.
			</p>
			<img
				src={picture.url}
				width={picture.width}
				height={picture.height}
				alt="Inside Inventory service: Stock API, Reservation ledger, Warehouse sync and Stock DB."
				loading="lazy"
				decoding="async"
			/>
			<p class="doc-figure mono">docs/design/inventory.svg · current</p>
		</div>
		<div class="tile-copy">
			<h3 class="h3">Pictures for docs, ADRs and pull requests</h3>
			<p class="body small">
				The CLI exports self-contained SVG and PNG from the same model the browser reads. The SVG draws
				its own glyphs, so it needs no font, and its traffic keeps moving.
			</p>
			<pre class="cmd" tabindex="0"><code><span class="ps">$</span> archboard model render --scope 'Shop/MKhTEYqf#HYDbL5fE' \
    --out docs/design/inventory.svg
<span class="ps">$</span> archboard model rasterize --scope 'Shop/MKhTEYqf#HYDbL5fE' \
    --scale 2 --out docs/design/inventory.png</code></pre>
		</div>
	</article>
	<article class="tile table" data-reveal style="--reveal-delay: 100">
		<div class="tile-copy">
			<h3 class="h3">Diagrams that stay current</h3>
			<p class="body small">
				A tracked drawing carries its exact render recipe. After an architecture change, the embed
				check names the drawings that are out of date, and <code>--fix</code> redraws them.
			</p>
			<pre class="cmd" tabindex="0"><code><span class="ps">$</span> archboard check embeds
<span class="ps">$</span> archboard check embeds --fix</code></pre>
		</div>
	</article>
	<article class="tile table" data-reveal style="--reveal-delay: 200">
		<div class="tile-copy">
			<h3 class="h3">Ask your architecture</h3>
			<p class="body small">
				Select a part and choose Explain with Codex, or press Talk and ask aloud. The local agent gets
				the exact reading and the selection, and it changes nothing.
			</p>
			<div class="ask">
				<p class="ask-selected">
					<KindChip kind="function" size={20} />
					<span class="ink">Timeout guard</span>
					<span class="muted small">selected</span>
				</p>
				<div class="ask-buttons">
					<span class="ask-btn"><Icon name="question" size={15} /> Explain with Codex</span>
					<span class="ask-btn"><Icon name="mic" size={15} /> Talk</span>
				</div>
			</div>
		</div>
	</article>
</div>
<p class="caption example-caption">Example design document and explanation controls.</p>

<style>
	.tiles {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.tile {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 24px;
		background: var(--chrome);
	}
	.tile.doc {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		align-items: center;
		gap: 32px;
	}
	.tile-copy {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.doc-page {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 24px;
		border-radius: 6px;
		background: oklch(0.2 0.006 75);
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px var(--rule);
		rotate: -1.2deg;
	}
	.doc-path {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		color: var(--ink-muted);
	}
	.doc-title {
		margin: 4px 0 0;
		font-size: 1.5rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.doc-text {
		font-size: 0.9375rem;
		color: var(--ink-body);
	}
	.doc-page img {
		width: 100%;
		border-radius: 4px;
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.doc-figure {
		font-size: 0.72rem;
		color: var(--ink-muted);
	}
	.cmd {
		margin: 0;
		padding: 14px 16px;
		border-radius: 6px;
		background: oklch(0.155 0.005 75);
		box-shadow: inset 0 0 0 1px var(--rule);
		font-size: 0.76rem;
		line-height: 1.8;
		color: var(--ink);
		overflow-x: auto;
	}
	.cmd code {
		font-size: inherit;
	}
	.ps {
		color: var(--gold-mark);
	}
	.small code {
		padding: 0.1em 0.35em;
		border-radius: var(--radius-chip);
		background: var(--card);
		color: var(--ink);
		font-size: 0.85em;
	}
	.ask {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		border-radius: 6px;
		background: var(--plane);
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.ask-selected {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 600;
	}
	.ask-selected .small {
		font-weight: 400;
	}
	.ask-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.ask-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		padding: 0 12px;
		border-radius: 4px;
		background: var(--raised);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	@media (max-width: 900px) {
		.tiles,
		.tile.doc {
			grid-template-columns: minmax(0, 1fr);
		}
		.doc-page {
			rotate: none;
		}
	}
</style>
