---
// A branch held to its plan: the Measures view `What this branch changed`, rebuilt for the page
// over the example shop's Queued fulfilment proposal. The branch, its commits and the commit hash
// are an example. The pickers, the lists, their order and their words are the shell's
// (apps/web/src/ui/architecture-drawing/model-reader/reading/branch-footprint/).

const range = [
	{ label: "Base", value: "main", mono: true },
	{ label: "Head", value: "queued-fulfilment", mono: true },
	{ label: "Against", value: "Queued fulfilment", mono: false },
];

const lists: {
	title: string;
	gloss: string;
	modules: { name: string; detail: string; commits: number }[];
}[] = [
	{
		title: "Changed but not named",
		gloss: "The commits changed these modules, and the plan does not name them.",
		modules: [{ name: "Basket cache", detail: "services/basket/cache", commits: 1 }],
	},
	{
		title: "Named and changed",
		gloss: "The plan names these modules, and the commits changed them.",
		modules: [
			{ name: "Checkout API", detail: "changed by the plan", commits: 4 },
			{ name: "Fulfilment worker", detail: "added by the plan", commits: 3 },
			{ name: "Order events", detail: "added by the plan", commits: 2 },
		],
	},
	{
		title: "Named but not changed",
		gloss: "The plan names these modules, and no commit changed them yet.",
		modules: [{ name: "Payment webhook", detail: "changed by the plan", commits: 0 }],
	},
];
---

<div class="footprint table">
	<div class="head">
		<p class="title">Measures</p>
		<p class="tab">What this branch changed</p>
	</div>
	<div class="range">
		{
			range.map((picker) => (
				<div class="picker">
					<span class="picker-label">{picker.label}</span>
					<span class:list={["picker-value", { mono: picker.mono }]}>
						<span class="picker-text">{picker.value}</span>
						<span class="chevron" aria-hidden="true" />
					</span>
				</div>
			))
		}
		<span class="key refresh">Refresh</span>
	</div>
	<div class="lists">
		{
			lists.map((list) => (
				<section class="list" aria-label={list.title}>
					<p class="list-head">
						<span class="list-title">{list.title}</span>
						<span class="count mono">{list.modules.length}</span>
						<span class="key show">Show on picture</span>
					</p>
					<p class="gloss">{list.gloss}</p>
					<ul class="modules">
						{list.modules.map((module) => (
							<li>
								<span class="module">
									<span class="module-name">{module.name}</span>
									<span class="module-detail">{module.detail}</span>
								</span>
								{module.commits > 0 && (
									<span class="commits mono">
										{module.commits} {module.commits === 1 ? "commit" : "commits"}
									</span>
								)}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
	<p class="vault">The model at queued-fulfilment, 3f2a1c9, sets what the commits are read against.</p>
</div>
<p class="caption example-caption">
	Example branch for the shop's Queued fulfilment proposal. The CLI gives the same lists:
	<code>archboard model footprint --base main --head queued-fulfilment --state "Queued fulfilment"</code>.
</p>

<style>
	.footprint {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 6px;
		background: var(--chrome);
	}
	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 14px 8px;
	}
	.title {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ink);
	}
	.tab {
		margin: 0;
		padding-bottom: 4px;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink);
		box-shadow: inset 0 -2px 0 var(--gold-mark);
	}
	.range {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 10px;
		padding: 0 8px 8px;
	}
	.picker {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
		flex: 1 1 160px;
		max-width: 260px;
	}
	.picker-label {
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.picker-value {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		height: 34px;
		padding: 0 10px;
		border-radius: 5px;
		background: var(--plane);
		box-shadow: inset 0 0 0 1px var(--rule);
		font-size: 0.8125rem;
		color: var(--ink);
	}
	.picker-text {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.chevron {
		flex: none;
		width: 6px;
		height: 6px;
		margin-top: -3px;
		border-right: 1.5px solid var(--ink-muted);
		border-bottom: 1.5px solid var(--ink-muted);
		rotate: 45deg;
	}
	.key {
		display: inline-flex;
		align-items: center;
		height: 26px;
		padding: 0 9px;
		border-radius: 4px;
		box-shadow: inset 0 0 0 1px var(--rule);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--ink);
		white-space: nowrap;
	}
	.refresh {
		margin-left: auto;
		margin-bottom: 4px;
	}
	.lists {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 16px;
		border-radius: 6px;
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	.list {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.list-head {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin: 0;
	}
	.list-title {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
	}
	.count {
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.show {
		margin-left: auto;
		align-self: center;
	}
	.gloss {
		margin: 0 0 4px;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}
	.modules {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.modules li {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 40px;
		padding: 4px 8px;
		border-radius: 4px;
	}
	.module {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}
	.module-name {
		font-size: 0.875rem;
		color: var(--ink);
	}
	.module-detail {
		overflow: hidden;
		font-size: 0.8125rem;
		color: var(--ink-muted);
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.commits {
		flex: none;
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.vault {
		margin: 0;
		padding: 8px 10px 6px;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	.example-caption {
		margin-top: 14px;
	}
	.example-caption code {
		overflow-wrap: anywhere;
	}
	@media (max-width: 760px) {
		.picker {
			max-width: none;
		}
		.refresh {
			margin-left: 0;
		}
	}
</style>
