---
// A conversation with the Codex voice about the example shop. The voice box holds the product's
// orb and what you and the voice say. Beside it, the coordinator's thread and the workhorse's
// thread show what each runs as the conversation goes. The lines come from lib/talk-script.ts,
// and scripts/talk-relay.ts plays them.
import Icon from "../Icon.astro";
import { talkScript, type Thread } from "../../lib/talk-script";

const lines = talkScript.map((line, order) => ({ ...line, order }));
const threads: { id: Thread; name: string; gloss: string }[] = [
	{ id: "coordinator", name: "Coordinator", gloss: "A fast Codex thread. It reads the architecture and decides what the voice says." },
	{ id: "workhorse", name: "Workhorse", gloss: "A full Codex thread in the shop's checkout. It reads the code and does the work." },
];
---

<div class="relay table" data-talk-relay data-loop>
	<div class="voice">
		<div class="voice-head">
			<canvas class="orb" data-orb aria-hidden="true"></canvas>
			<div>
				<p class="name">Codex voice <span class="state" data-voice-state>Listening</span></p>
				<p class="gloss">Listens and speaks in real time, and hands the work to the coordinator.</p>
			</div>
		</div>
		<ol class="transcript">
			{
				lines.map(
					(line) =>
						line.kind === "said" && (
							<li
								class:list={["line", `is-${line.who}`]}
								data-talk-line
								data-order={line.order}
								data-kind="said"
								data-who={line.who}
								data-text={line.text}
							>
								<span class="who">{line.who === "you" ? "You" : "Codex voice"}</span>
								<span class="text">{line.text}</span>
							</li>
						),
				)
			}
		</ol>
		<button type="button" class="btn btn-gold btn-small talk" data-talk aria-pressed="false" hidden>
			<span class="when-held"><Icon name="voice" size={16} /> Talk</span>
			<span class="when-playing"><Icon name="pause" size={16} /> Pause</span>
		</button>
	</div>
	<div class="threads">
		{
			threads.map((thread) => (
				<section class="thread" data-thread-panel={thread.id} aria-label={thread.name}>
					<p class="name">{thread.name}</p>
					<p class="gloss">{thread.gloss}</p>
					<ol class="log">
						{lines.map(
							(line) =>
								line.kind !== "said" &&
								line.thread === thread.id && (
									<li
										class:list={["line", `is-${line.kind}`]}
										data-talk-line
										data-order={line.order}
										data-kind={line.kind}
										data-thread={thread.id}
										data-text={line.text}
									>
										{line.kind === "relay" && <span class="from">{line.from}</span>}
										{line.kind === "command" && <span class="prompt">$</span>}
										<span class="text">{line.text}</span>
									</li>
								),
						)}
					</ol>
				</section>
			))
		}
	</div>
</div>

<style>
	.relay {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: 6px;
		padding: 6px;
		background: var(--chrome);
	}
	/* The voice box lies on a plane with its own lit edge, like the walkthrough's box. */
	.voice {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
		padding: 22px 24px 24px;
		border-radius: var(--radius-panel);
		background: var(--plane);
		box-shadow:
			inset 0 1px 0 var(--highlight),
			inset 0 0 0 1px var(--rule);
	}
	.voice-head {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: 16px;
		align-items: center;
	}
	/* The product's orb canvas: 84px, with its 64px ring in the middle. Its plate is the box. */
	.orb {
		--card: var(--plane);
		--primary: var(--gold);
		width: 84px;
		max-width: none;
		height: 84px;
		margin: -10px;
	}
	.name {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}
	.state {
		margin-left: 6px;
		font-size: 0.8125rem;
		font-weight: 400;
		color: var(--ink-muted);
	}
	.gloss {
		margin-top: 2px;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}
	.transcript {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		flex: 1;
		width: 100%;
	}
	.transcript .line {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 1rem;
		line-height: 1.55;
		color: var(--ink-body);
	}
	/* What you say sits in a raised bubble, as in the agent dock. */
	.line.is-you {
		padding: 10px 12px;
		border-radius: var(--radius-control);
		background: var(--card);
		box-shadow: var(--shadow-raised);
		color: var(--ink);
	}
	.who,
	.from {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
	}
	.text :global(.w) {
		opacity: 0.18;
		transition: opacity 260ms var(--ease-out);
	}
	.text :global(.w.is-said) {
		opacity: 1;
	}
	.line.is-pending {
		visibility: hidden;
	}
	.talk[hidden] {
		display: none;
	}
	.when-held,
	.when-playing {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.when-playing,
	.talk[aria-pressed="true"] .when-held {
		display: none;
	}
	.talk[aria-pressed="true"] .when-playing {
		display: inline-flex;
	}
	/* The threads lie in a trough. The one at work rises out of it. */
	.threads {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 6px;
		border-radius: var(--radius-panel);
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	.thread {
		flex: 1;
		padding: 16px 18px 18px;
		border-radius: var(--radius-panel);
		background: var(--plane);
		box-shadow: inset 0 0 0 1px var(--rule);
		transition:
			background-color 320ms var(--ease-out),
			box-shadow 320ms var(--ease-out),
			translate 320ms var(--ease-out);
	}
	.thread.is-working {
		background: var(--raised);
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px var(--rule);
		translate: 0 -1px;
	}
	.log {
		list-style: none;
		margin: 14px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.6;
	}
	.log .line {
		display: flex;
		gap: 8px;
		min-width: 0;
	}
	.log .text {
		overflow-wrap: anywhere;
	}
	.is-command {
		color: var(--ink);
	}
	.prompt {
		flex: none;
		color: var(--gold-mark);
	}
	.is-reply {
		padding-left: 16px;
		color: var(--ink-muted);
	}
	/* Words passed between the voice and the threads read as the dock's messages do. */
	.log .is-relay {
		flex-direction: column;
		gap: 2px;
		margin: 4px 0;
		padding: 8px 10px;
		border-radius: var(--radius-control);
		background: var(--card);
		box-shadow: var(--shadow-raised);
		font-family: var(--font-body);
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink);
	}
	.is-relay .from {
		font-size: 0.75rem;
	}
	.line.is-typing .text::after {
		content: "";
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 1px;
		vertical-align: -0.15em;
		background: var(--gold-mark);
		animation: caret 900ms steps(1) infinite;
	}
	@keyframes caret {
		50% {
			opacity: 0;
		}
	}
	@media (max-width: 960px) {
		.relay {
			grid-template-columns: minmax(0, 1fr);
		}
		.voice {
			padding: 18px;
		}
		.transcript .line {
			font-size: 0.9375rem;
		}
	}
</style>

<script>
	import { mountTalkRelay } from "../../scripts/talk-relay";

	for (const root of document.querySelectorAll<HTMLElement>("[data-talk-relay]")) mountTalkRelay(root);
</script>
