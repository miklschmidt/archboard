---
// A warning of the code check as Measures shows it, under "Where the map and the code
// disagree" in the Cards layout: the count of warnings and when the check ran over the cards,
// then the card of one finding beside the source line that supports it. The checkout is a small
// example, like the README's.
import Icon from "../Icon.astro";

const source = `<span class="ln">18</span><span class="k">export async function</span> placeOrder(basket) {
<span class="ln">19</span>  <span class="k">const</span> order = <span class="k">await</span> validateOrder(basket);
<span class="ln">20</span>  <span class="k">const</span> payment = <span class="k">await</span> chargeCard(order);
<span class="hl"><span class="ln">21</span>  <span class="k">await</span> saveOrder({ ...order, payment });</span>
<span class="ln">22</span>  <span class="k">await</span> sendReceipt(order);
<span class="ln">23</span>  <span class="k">return</span> confirm(order.id);
<span class="ln">24</span>}`;
---

<div class="evidence table">
	<div class="view-head">
		<p class="count"><Icon name="alert" size={15} /> 3 warnings</p>
		<p class="when">Code check at <time class="mono">12:49 PM</time></p>
		<span class="layouts" aria-hidden="true"><span class="is-on">Cards</span><span>List</span></span>
	</div>
	<div class="finding">
		<p class="finding-head">
			<span class="chip missing">Missing relationship</span>
			<span class="show" aria-hidden="true"><Icon name="focus" size={15} /></span>
		</p>
		<p class="route">
			<span>Place order</span>
			<Icon name="arrowRight" size={14} />
			<span>Save order</span>
		</p>
		<p class="explain">
			Place order calls Save order, but no relationship connects them in the model.
		</p>
		<p class="strength"><Icon name="check" size={14} /> Resolved by analysis · awaited</p>
	</div>
	<figure class="source">
		<figcaption class="file">
			<Icon name="fileCode" size={14} />
			<span class="mono">src/orders/place-order.ts</span>
		</figcaption>
		<pre tabindex="0"><code set:html={source} /></pre>
	</figure>
</div>
<p class="caption example-caption">Sample finding from a checkout service, linked to the calling line.</p>

<style>
	.evidence {
		display: grid;
		/* The source takes the wider share, so its longest line fits without a scrollbar. */
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		gap: 6px;
		padding: 6px;
		background: var(--chrome);
	}
	/* Over the cards, as in Measures: the count and the time of the check, then the switch of
	   the two layouts at the end. */
	.view-head {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 16px;
		padding: 8px 10px 6px;
	}
	.count {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
	}
	.count :global(svg) {
		color: var(--changed);
	}
	.when {
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	.when .mono {
		font-size: 0.75rem;
	}
	.layouts {
		display: inline-flex;
		gap: 2px;
		margin-left: auto;
		padding: 2px;
		border-radius: 3px;
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	.layouts span {
		padding: 3px 10px;
		border-radius: 3px;
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.layouts .is-on {
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 -2px 0 var(--gold-mark);
	}
	.finding {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 14px;
		border-radius: 4px;
		background: var(--card);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px color-mix(in oklch, var(--changed) 45%, transparent);
	}
	.finding-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 8px;
	}
	/* The quiet key that selects the finding's subject on the picture. */
	.show {
		display: inline-grid;
		place-items: center;
		width: 24px;
		height: 24px;
		margin: -2px -4px 0 0;
		color: var(--ink-muted);
	}
	.chip.missing {
		color: oklch(0.2 0.03 50);
		background: var(--changed);
	}
	/* A name never breaks inside itself; in a narrow panel the second name moves to its own line. */
	.route {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 8px;
		font-weight: 600;
		color: var(--ink);
	}
	.route span {
		white-space: nowrap;
	}
	.route :global(svg) {
		color: var(--ink-muted);
	}
	.explain {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-body);
	}
	.strength {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	.strength :global(svg) {
		color: var(--added);
	}
	.source {
		display: flex;
		flex-direction: column;
		margin: 0;
		border-radius: 6px;
		background: oklch(0.155 0.005 75);
		box-shadow: inset 0 0 0 1px var(--rule);
		overflow: hidden;
	}
	.file {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 14px;
		color: var(--ink-muted);
		box-shadow: inset 0 -1px 0 var(--rule);
	}
	.file .mono {
		font-size: 0.75rem;
	}
	pre {
		margin: 0;
		padding: 14px 0;
		font-size: 0.78rem;
		line-height: 1.85;
		color: var(--ink-body);
		overflow-x: auto;
	}
	pre code {
		display: block;
		font-size: inherit;
	}
	.source :global(.ln) {
		display: inline-block;
		width: 3.2em;
		padding-right: 1em;
		text-align: right;
		color: var(--ink-faint);
		user-select: none;
	}
	.source :global(.k) {
		color: var(--violet-text);
	}
	.source :global(.hl) {
		display: inline-block;
		width: 100%;
		background: color-mix(in oklch, var(--changed) 16%, transparent);
		box-shadow: inset 2px 0 0 var(--changed);
		color: var(--ink);
	}
	@media (max-width: 640px) {
		.evidence {
			grid-template-columns: minmax(0, 1fr);
		}
		.view-head {
			grid-column: auto;
		}
	}
</style>
