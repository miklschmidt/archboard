---
// A module kind's chip, as the renderer draws it on a card: a tint of the kind's colour with the
// kind's icon in the colour itself.
import Icon from "./Icon.astro";
import { kinds, type Kind } from "../lib/icons";

interface Props {
	kind: Kind;
	size?: number;
}

const { kind, size = 20 } = Astro.props;
const look = kinds[kind];
---

<span class="kind-chip" style={`--c: var(--${look.color}); --s: ${size}px`} title={look.name}>
	<Icon name={look.icon} size={Math.round(size * 0.68)} />
</span>

<style>
	.kind-chip {
		display: inline-grid;
		place-items: center;
		width: var(--s);
		height: var(--s);
		flex: none;
		border-radius: calc(var(--s) * 0.24);
		color: var(--c);
		background: color-mix(in srgb, var(--c) 20%, var(--slab));
		box-shadow:
			inset 0 1px 0 oklch(1 0 0 / 0.12),
			0 1px 0 color-mix(in srgb, var(--c) 20%, oklch(0.215 0.006 75));
	}
</style>
