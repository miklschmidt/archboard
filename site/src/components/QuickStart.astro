---
// The quick start and the prompts to try. Each block copies as one command list.
import CopyButton from "./CopyButton.astro";
import InstallCommands from "./InstallCommands.astro";
import { links } from "../lib/links";

const tryIt = `mkdir -p ~/archboard-example/.archboard/vault
curl -fsSL https://codeload.github.com/miklschmidt/archboard/tar.gz/main | \\
  tar -xz -C ~/archboard-example/.archboard/vault \\
  --strip-components=3 archboard-main/examples/web-shop
git -C ~/archboard-example init
git -C ~/archboard-example remote add origin https://example.invalid/web-shop.git
archboard -C ~/archboard-example model import \\
  --input ~/archboard-example/.archboard/vault/history.import.json
archboard start`;

const prompts = [
	["Model how a request travels from the API to the database.", "ordered flow across modules anchored to source"],
	["Propose splitting billing out of the monolith and diff it against current.", "proposal overlaid on the live architecture"],
	["Draft two architecture options for search, side by side.", "two competing proposals from the same baseline"],
	["Check this model against the codebase.", "code-check findings with source evidence and warnings"],
	["Find the shallowest modules and highest-coupling boundaries.", "interface and Git co-change counts from Measures"],
	["We shipped the queue. Adopt the proposal.", "promotes the proposal to current and checkpoints the old state"],
	["Record a walkthrough of PR 128 for the reviewers and attach it.", "narrated MP4 attached to the pull request"],
	["Build an onboarding walkthrough of checkout.", "step-by-step tour ready for live narration"],
];
---

<div class="quick">
	<div class="steps">
		<div class="step" data-reveal>
			<h3 class="h3">Map your own code</h3>
			<p class="body small">
				Install Archboard, then run <code>archboard init</code> inside your repository.
				Initialization installs agent skills for Codex (and Claude Code if detected), creates the
				vault, and starts your agent to configure language servers, showing its plan before
				modifying anything.
			</p>
			<InstallCommands id="quick-install" then={["archboard init"]} />
			<p class="body small">
				Requires Git on Linux (x64/arm64) or macOS (Apple silicon). The in-browser agent, voice
				chat, narration, and video recordings require signing in to Codex from the agent dock. See
				<a href={links.install}>INSTALL.md</a> for vault discovery, code bindings, and language
				servers.
			</p>
		</div>
		<div class="step" data-reveal style="--reveal-delay: 120">
			<div class="step-head">
				<h3 class="h3">Try the example web shop</h3>
				<CopyButton text={tryIt} />
			</div>
			<p class="body small">Once installed, import the sample web-shop vault and start the local server.</p>
			<pre class="block" tabindex="0"><code>{tryIt}</code></pre>
			<p class="body small">
				Open <code>http://archboard.localhost:4242/?modelA=Shop</code> to browse its modules,
				proposals, history, and walkthroughs.
			</p>
		</div>
	</div>
	<div class="prompts table" data-reveal>
		<p class="prompts-title">Ask your agent</p>
		<ul>
			{
				prompts.map(([ask, get]) => (
					<li>
						<span class="ask">“{ask}”</span>
						<span class="get">{get}</span>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.quick {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 24px;
		align-items: start;
	}
	.steps {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.step {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		border-radius: var(--radius-table);
		background: var(--plane);
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px var(--rule);
	}
	.step-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.block {
		margin: 0;
		padding: 16px 18px;
		border-radius: 6px;
		background: oklch(0.155 0.005 75);
		box-shadow: inset 0 0 0 1px var(--rule);
		font-size: 0.8rem;
		line-height: 1.75;
		color: var(--ink);
		overflow-x: auto;
	}
	.block code {
		font-size: inherit;
	}
	.small code {
		padding: 0.1em 0.35em;
		border-radius: var(--radius-chip);
		background: var(--card);
		color: var(--ink);
		font-size: 0.85em;
	}
	.prompts {
		padding: 22px;
		background: var(--chrome);
	}
	.prompts-title {
		margin-bottom: 14px;
		font-weight: 600;
		color: var(--ink);
	}
	.prompts ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.prompts li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 12px 14px;
		border-radius: 4px;
		background: var(--plane);
		transition: background-color 160ms var(--ease-out);
	}
	.prompts li:hover {
		background: var(--card);
	}
	.ask {
		color: var(--ink);
		font-size: 0.9375rem;
		line-height: 1.45;
	}
	.get {
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	@media (max-width: 1000px) {
		.quick {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
