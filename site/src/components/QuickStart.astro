---
// The README's quick start and the prompts to try. Each block copies as one command list.
import Icon from "./Icon.astro";
import { links } from "../lib/links";

const tryIt = `npm install --global archboard
mkdir -p ~/archboard-example/.archboard/vault
curl -fsSL https://codeload.github.com/miklschmidt/archboard/tar.gz/main | \\
  tar -xz -C ~/archboard-example/.archboard/vault \\
  --strip-components=3 archboard-main/examples/web-shop
git -C ~/archboard-example init
git -C ~/archboard-example remote add origin https://example.invalid/web-shop.git
archboard -C ~/archboard-example model import \\
  --input ~/archboard-example/.archboard/vault/history.import.json
archboard start`;

const ownCode = `cd ~/code/your-project
archboard install-skill --agent claude-code     # omit --agent for Codex`;

const prompts = [
	["Draw how a request travels from the API to the database.", "a flow across modules bound to source"],
	["Propose splitting billing out of the monolith and compare it with today.", "a proposal drawn against current architecture"],
	["Give me two options for search, side by side.", "two competing drafts from one starting point"],
	["Show me where this model disagrees with the code.", "findings with source evidence and warnings on the map"],
	["Where does this design cost the most? Check the shallowest modules.", "the modules to read first, each checked against the code"],
	["We shipped the queue. Adopt the proposal.", "the old architecture becomes history, with the reason"],
	["Record a walkthrough of PR 128 for the reviewers and attach it.", "a narrated MP4 on the pull request"],
	["Explain the checkout to a new hire, one step at a time.", "a newcomer's walkthrough you can narrate"],
];
---

<div class="quick">
	<div class="steps">
		<div class="step" data-reveal>
			<div class="step-head">
				<h3 class="h3">Try the example shop</h3>
				<button type="button" class="copy" data-copy={tryIt}>
					<Icon name="copy" size={15} /> <span>Copy</span>
				</button>
			</div>
			<p class="body small">
				You need Linux on x64 or arm64, or macOS on Apple silicon, with Git and npm. To build from a
				clone instead, read <a href={links.install}>INSTALL.md</a>.
			</p>
			<pre class="block" tabindex="0"><code>{tryIt}</code></pre>
			<p class="body small">
				Then open <code>http://archboard.localhost:27242/?modelA=Shop</code> to explore the modules, proposals,
				history and walkthroughs.
			</p>
		</div>
		<div class="step" data-reveal style="--reveal-delay: 120">
			<div class="step-head">
				<h3 class="h3">Use it on your own code</h3>
				<button type="button" class="copy" data-copy={ownCode}>
					<Icon name="copy" size={15} /> <span>Copy</span>
				</button>
			</div>
			<p class="body small">
				Install the skill in the repository you want mapped. Then ask
				your agent to describe it.
			</p>
			<pre class="block" tabindex="0"><code>{ownCode}</code></pre>
			<p class="body small">
				Agent, voice, narration and recordings need a Codex sign-in, from the agent dock.
				<a href={links.install}>INSTALL.md</a> covers vault discovery, code bindings and language
				servers.
			</p>
		</div>
	</div>
	<div class="prompts table" data-reveal>
		<p class="prompts-title">Ask your agent</p>
		<ul>
			{
				prompts.map(([ask, get]) => (
					<li>
						<span class="ask">“{ask}”</span>
						<span class="get">{get}</span>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.quick {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 24px;
		align-items: start;
	}
	.steps {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.step {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		border-radius: var(--radius-table);
		background: var(--plane);
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px var(--rule);
	}
	.step-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.copy {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		padding: 0 12px;
		border: 0;
		border-radius: 4px;
		background: var(--raised);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
		cursor: pointer;
		transition: background-color 160ms var(--ease-out);
	}
	.copy:hover {
		background: var(--slab);
	}
	.copy.is-done {
		color: var(--added);
	}
	.block {
		margin: 0;
		padding: 16px 18px;
		border-radius: 6px;
		background: oklch(0.155 0.005 75);
		box-shadow: inset 0 0 0 1px var(--rule);
		font-size: 0.8rem;
		line-height: 1.75;
		color: var(--ink);
		overflow-x: auto;
	}
	.block code {
		font-size: inherit;
	}
	.small code {
		padding: 0.1em 0.35em;
		border-radius: var(--radius-chip);
		background: var(--card);
		color: var(--ink);
		font-size: 0.85em;
	}
	.prompts {
		padding: 22px;
		background: var(--chrome);
	}
	.prompts-title {
		margin-bottom: 14px;
		font-weight: 600;
		color: var(--ink);
	}
	.prompts ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.prompts li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 12px 14px;
		border-radius: 4px;
		background: var(--plane);
		transition: background-color 160ms var(--ease-out);
	}
	.prompts li:hover {
		background: var(--card);
	}
	.ask {
		color: var(--ink);
		font-size: 0.9375rem;
		line-height: 1.45;
	}
	.get {
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	@media (max-width: 1000px) {
		.quick {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		const label = button.querySelector("span");
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(button.dataset["copy"] ?? "");
				button.classList.add("is-done");
				if (label) label.textContent = "Copied";
			} catch {
				if (label) label.textContent = "Select and copy";
			}
			window.setTimeout(() => {
				button.classList.remove("is-done");
				if (label) label.textContent = "Copy";
			}, 1800);
		});
	}
</script>
