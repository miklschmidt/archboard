---
import { icons, type IconName } from "../lib/icons";

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const svg = icons[name].replace(
	"<svg ",
	`<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon ${className ?? ""}" `,
);
---

<Fragment set:html={svg} />
