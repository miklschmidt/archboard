---
// A few ways onward from a page, as a reading list: one plane, one row for each link with its name
// and one line about it. `ordered` numbers the rows, for a path to read in order.
import Icon from "../Icon.astro";
import { docsHref } from "../../lib/docs-nav";
import { inlineCode } from "../../lib/reference";

interface Props {
	/** Each link: a docs path or a full URL, its name, and one line with code in backticks. */
	readonly cards: readonly { path: string; title: string; text: string }[];
	readonly ordered?: boolean;
}

const { cards, ordered = false } = Astro.props;
const List = ordered ? "ol" : "ul";
---

<List class:list={["reading", { ordered }]}>
	{
		cards.map((card, index) => {
			const external = card.path.startsWith("http");
			return (
				<li>
					<a href={external ? card.path : docsHref(card.path)}>
						{ordered && <span class="step" aria-hidden="true">{String(index + 1)}</span>}
						<span class="words">
							<span class="title">{card.title}</span>
							<span class="text" set:html={inlineCode(card.text)} />
						</span>
						<Icon name={external ? "arrowUpRight" : "arrowRight"} size={16} />
					</a>
				</li>
			);
		})
	}
</List>

<style>
	.reading {
		margin-top: 1.6em;
		padding: 0;
		list-style: none;
		border-radius: var(--radius-table);
		background: var(--plane);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.reading li {
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.reading li::before {
		display: none;
	}
	.reading li + li {
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.reading a {
		display: flex;
		align-items: center;
		gap: 16px;
		min-height: 44px;
		padding: 14px 20px;
		color: var(--ink-muted);
		text-decoration: none;
		transition: background-color 160ms var(--ease-out);
	}
	.reading a:hover {
		background: var(--highlight);
	}
	.reading a:hover :global(svg) {
		color: var(--gold-mark);
		transform: translateX(2px);
	}
	.reading :global(svg) {
		flex: none;
		margin-left: auto;
		transition:
			color 160ms var(--ease-out),
			transform 160ms var(--ease-out);
	}
	.step {
		display: inline-grid;
		flex: none;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: var(--radius-chip);
		background: var(--well);
		color: var(--gold-mark);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		box-shadow: inset 0 0 0 1px var(--rule-strong);
	}
	.words {
		display: grid;
		gap: 2px;
		min-width: 0;
	}
	.title {
		font-weight: 600;
		color: var(--ink);
	}
	.text {
		font-size: 0.875rem;
		line-height: 1.5;
	}
	@media (prefers-reduced-motion: reduce) {
		.reading a,
		.reading :global(svg) {
			transition: none;
		}
		.reading a:hover :global(svg) {
			transform: none;
		}
	}
</style>
