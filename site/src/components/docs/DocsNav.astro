---
// The docs' bar: the brand back to the site, the three ways into the docs, the search and GitHub.
// It is the site's nav in its stuck state, so the docs read as the same room.
import Icon from "../Icon.astro";
import Mark from "../Mark.astro";
import { links } from "../../lib/links";
import { docsHref } from "../../lib/docs-nav";

interface Props {
	/** The current page's path under /docs/. */
	readonly path: string;
}

const { path } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = [
	{ href: docsHref(""), label: "Docs", active: !path.startsWith("reference") },
	{ href: docsHref("reference/cli"), label: "CLI", active: path.startsWith("reference/cli") },
	{
		href: docsHref("reference/schemas"),
		label: "Schemas",
		active: path === "reference/schemas",
	},
];
---

<header class="docs-bar">
	<div class="bar-row">
		<a class="brand" href={`${base}/`} aria-label="archboard, the home page">
			<Mark size={24} id="docs-mark" />
			<span class="wordmark" aria-hidden="true">archboard</span>
		</a>
		<nav aria-label="Docs">
			<ul>
				{
					items.map((item) => (
						<li>
							<a href={item.href} aria-current={item.active ? "true" : undefined} data-bar-link>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="bar-actions">
			<button type="button" class="search-trigger" data-search-open aria-label="Search the docs">
				<Icon name="search" size={16} />
				<span class="search-word">Search</span>
				<kbd data-search-key>/</kbd>
			</button>
			<a class="github" href={links.repository} aria-label="Archboard on GitHub">
				<Icon name="github" size={20} />
				<span>GitHub</span>
			</a>
		</div>
	</div>
</header>

<style>
	.docs-bar {
		position: sticky;
		top: 0;
		z-index: 50;
		height: 64px;
		background: var(--chrome);
		box-shadow:
			inset 0 -1px 0 var(--rule),
			0 10px 24px -12px var(--cast);
	}
	.bar-row {
		display: flex;
		align-items: center;
		gap: 28px;
		height: 100%;
		max-width: calc(var(--docs-measure) + var(--gutter) * 2);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}
	.brand {
		display: inline-flex;
		align-items: flex-end;
		gap: 11px;
		/* A target of at least 24 pixels high (WCAG 2.5.8). */
		padding-block: 4px;
		text-decoration: none;
		color: var(--ink);
		flex: none;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 22px;
		line-height: 22px;
		font-weight: 560;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: -2px;
	}
	nav {
		flex: 1;
	}
	nav ul {
		display: flex;
		gap: 4px;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		height: 34px;
		padding: 0 12px;
		border-radius: var(--radius-control);
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--ink-muted);
		text-decoration: none;
		transition:
			color 160ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}
	nav a:hover {
		color: var(--ink);
		background: var(--wash);
	}
	nav a[aria-current="true"] {
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 -2px 0 var(--gold-mark);
	}
	.bar-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		width: 232px;
		height: 36px;
		padding: 0 6px 0 12px;
		border: 0;
		border-radius: var(--radius-panel);
		background: var(--well);
		color: var(--ink-muted);
		font-size: 0.875rem;
		box-shadow:
			var(--shadow-well),
			inset 0 0 0 1px var(--rule);
		cursor: pointer;
		transition: color 160ms var(--ease-out);
	}
	.search-trigger:hover {
		color: var(--ink);
	}
	.search-word {
		flex: 1;
		text-align: left;
	}
	kbd {
		display: inline-grid;
		place-items: center;
		min-width: 24px;
		height: 22px;
		padding: 0 6px;
		border-radius: var(--radius-control);
		background: var(--raised);
		color: var(--ink-muted);
		font-size: 0.75rem;
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.github {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 34px;
		padding: 0 12px;
		border-radius: var(--radius-control);
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color 160ms var(--ease-out);
	}
	.github:hover {
		color: var(--ink);
	}
	@media (max-width: 1100px) {
		.search-trigger {
			width: auto;
		}
		.search-word,
		kbd {
			display: none;
		}
	}
	@media (max-width: 640px) {
		nav {
			display: none;
		}
		.bar-actions {
			margin-left: auto;
		}
		.github span {
			display: none;
		}
	}
</style>
