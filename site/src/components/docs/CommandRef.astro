---
// One command of the CLI, from its contract: what it does, how to call it, its options, its
// examples and what each exit code means.
import { Code } from "astro-expressive-code/components";
import SubHead from "./SubHead.astro";
import {
	commandAnchor,
	descriptionBlocks,
	inlineCode,
	sharedOf,
	synopsis,
	traits,
	type CommandEntry,
	type OptionEntry,
} from "../../lib/reference";

interface Props {
	readonly command: CommandEntry;
}

const { command } = Astro.props;
const anchor = commandAnchor(command.name);
const positionals = command.parameters.filter((parameter) => parameter.kind === "positional");
const options = command.parameters.filter(
	(parameter): parameter is OptionEntry => parameter.kind === "option",
);
const shared = sharedOf(command);
const exits = [
	{ exit: 0, what: "Success", text: "The command did what it said. Its output is above." },
	...command.outcomes.map((outcome) => ({ exit: outcome.exit, what: outcome.id, text: outcome.description })),
];
const blocks = descriptionBlocks(command.description);
---

<section class="command" aria-labelledby={anchor}>
	<h2 id={anchor} class="heading command-name" data-pagefind-weight="10">
		<span>{command.name}</span>
		<a class="heading-link" href={`#${anchor}`} aria-label="Link to this command" data-heading-link data-pagefind-ignore>#</a>
	</h2>
	<p class="command-summary">{command.summary}</p>
	{
		command.router ? (
			<p>
				{command.router.runs ? (
					<>
						Without a subcommand, <code>archboard {command.name}</code> runs{" "}
						<a href={`#${commandAnchor(command.router.runs)}`}>
							<code>archboard {command.router.runs}</code>
						</a>
						, and the options before the subcommand go to it.
					</>
				) : (
					<>
						<code>archboard {command.name}</code> needs a subcommand. Without one, it refuses with exit 2.
					</>
				)}
			</p>
		) : (
			<>
				<ul class="traits" aria-label="What it needs and does">
					{traits(command).map((trait) => <li>{trait}</li>)}
				</ul>
				<SubHead id={`${anchor}-synopsis`}>Synopsis</SubHead>
				<Code code={synopsis(command)} lang="sh" frame="none" wrap />
			</>
		)
	}
	{!command.router && (<div class="command-text">
		{
			blocks.map((block) =>
				block.kind === "paragraph" ? (
					<p set:html={inlineCode(block.text)} />
				) : block.kind === "head" ? (
					<p class="block-head" set:html={inlineCode(block.text)} />
				) : block.ordered ? (
					<ol>
						{block.items.map((item) => (
							<li set:html={inlineCode(item)} />
						))}
					</ol>
				) : (
					<ul>
						{block.items.map((item) => (
							<li set:html={inlineCode(item)} />
						))}
					</ul>
				),
			)
		}
	</div>)}
	{
		!command.router && (positionals.length > 0 || options.length > 0 || shared.length > 0) && (
			<SubHead id={`${anchor}-arguments`}>Arguments</SubHead>
		)
	}
	{
		!command.router && (positionals.length > 0 || options.length > 0 || shared.length > 0) && (
			<table class="params">
				<thead>
					<tr>
						<th scope="col">Argument</th>
						<th scope="col">What it does</th>
					</tr>
				</thead>
				<tbody>
					{positionals.map((parameter) => (
						<tr>
							<td>
								<code>{`<${parameter.name}>`}</code>
								{parameter.required && <span class="mark">required</span>}
								{parameter.repeatable && <span class="mark">repeatable</span>}
							</td>
							<td>
								<span set:html={inlineCode(parameter.description)} />
								{parameter.choices && (
									<span class="detail">
										One of{" "}
										{parameter.choices.map((choice, index) => (
											<>
												{index > 0 && ", "}
												<code>{choice}</code>
											</>
										))}
										.
									</span>
								)}
							</td>
						</tr>
					))}
					{options.map((option) => (
						<tr>
							<td>
								<code>
									{option.spellings.join(", ")}
									{option.value === "required" && ` <${option.placeholder ?? "value"}>`}
									{option.value === "optional" && ` [${option.placeholder ?? "value"}]`}
								</code>
								{option.required && <span class="mark">required</span>}
								{option.repeatable && <span class="mark">repeatable</span>}
							</td>
							<td>
								<span set:html={inlineCode(option.description)} />
								{option.requiredWhen && (
									<span class="detail" set:html={inlineCode(`Required when ${option.requiredWhen}.`)} />
								)}
								{option.choices && (
									<span class="detail">
										One of{" "}
										{option.choices.map((choice, index) => (
											<>
												{index > 0 && ", "}
												<code>{choice}</code>
											</>
										))}
										.
									</span>
								)}
								{option.default && (
									<span class="detail">
										Default <code>{option.default}</code>.
									</span>
								)}
							</td>
						</tr>
					))}
					{shared.map((option) => (
						<tr class="shared">
							<td>
								<code>
									{option.spellings.join(", ")} {`<${option.placeholder ?? "value"}>`}
								</code>
								{option.key === "doing" && <span class="mark">required</span>}
							</td>
							<td>
								<span set:html={inlineCode(option.description)} />
								{option.default && (
									<span class="detail">
										Default <code>{option.default}</code>.
									</span>
								)}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		)
	}
	{
		command.examples.length > 0 && (
			<div class="examples">
				<SubHead id={`${anchor}-examples`}>Examples</SubHead>
				<Code code={command.examples.join("\n")} lang="sh" frame="terminal" />
			</div>
		)
	}
	{!command.router && <SubHead id={`${anchor}-output`}>Output</SubHead>}
	{
		!command.router && (
			<ul class="outputs">
				{command.output.map((entry) => (
					<li set:html={inlineCode(entry.description)} />
				))}
			</ul>
		)
	}
	{!command.router && <SubHead id={`${anchor}-exit-codes`}>Exit codes</SubHead>}
	{!command.router && (<table class="exits">
		<thead>
			<tr>
				<th scope="col">Exit</th>
				<th scope="col">When</th>
			</tr>
		</thead>
		<tbody>
			{
				exits.map((row) => (
					<tr>
						<td class="exit">
							<span class:list={["exit-code", { ok: row.exit === 0 }]}>{row.exit}</span>
						</td>
						<td>
							<span class="when">{row.what}</span>
							<span class="detail" set:html={inlineCode(row.text)} />
						</td>
					</tr>
				))
			}
		</tbody>
	</table>)}
	{!command.router && command.refusals.length > 0 && <SubHead id={`${anchor}-refusals`}>Refusals</SubHead>}
	{
		!command.router && command.refusals.length > 0 && (
			<table class="exits">
				<thead>
					<tr>
						<th scope="col">Exit</th>
						<th scope="col">Refusal</th>
					</tr>
				</thead>
				<tbody>
					{command.refusals.map((refusal) => (
						<tr id={`${anchor}-${refusal.code.toLowerCase().replaceAll("_", "-")}`} class="refusal-row">
							<td class="exit">
								<span class="exit-code">{refusal.exit}</span>
							</td>
							<td>
								<code class="when">{refusal.code}</code>
								<span class="detail" set:html={inlineCode(refusal.description)} />
							</td>
						</tr>
					))}
				</tbody>
			</table>
		)
	}
</section>

<style>
	.command {
		margin-top: 0;
		padding-top: 72px;
	}
	.command + .command {
		margin-top: 72px;
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.command > :global(* + *) {
		margin-top: 18px;
	}
	/* A command's name is code, so it sets in mono at the heading's place in the hierarchy. */
	.command-name {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
		text-transform: none;
	}
	.command-name span::before {
		content: "archboard ";
		color: var(--ink-muted);
		font-weight: 500;
	}
	.command-summary {
		font-size: 1.0625rem;
		color: var(--ink);
	}
	.traits {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		padding: 0;
	}
	.traits li {
		display: inline-flex;
		align-items: center;
		height: 22px;
		padding: 0 8px;
		border-radius: var(--radius-chip);
		background: var(--card);
		color: var(--ink-muted);
		font-size: 0.75rem;
		font-weight: 600;
		list-style: none;
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.traits li::before {
		display: none;
	}
	.traits li + li {
		margin-top: 0;
	}
	.command-text :global(p),
	.command-text :global(li) {
		max-width: var(--docs-prose);
	}
	.command-text > :global(* + *) {
		margin-top: 0.9em;
	}
	.block-head {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
	}
	.block-head + :global(ul),
	.block-head + :global(ol) {
		margin-top: 0.5em;
	}
	.command table {
		width: 100%;
	}
	.command td:first-child {
		width: 38%;
	}
	.command td .detail {
		display: block;
		margin-top: 4px;
		font-size: 0.875rem;
		color: var(--ink-muted);
	}
	.mark {
		display: inline-block;
		margin: 4px 0 0 6px;
		padding: 0 6px;
		border-radius: var(--radius-chip);
		background: var(--well);
		color: var(--ink-muted);
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 18px;
		box-shadow: inset 0 0 0 1px var(--rule);
	}
	.shared code {
		color: var(--ink-muted);
	}
	.exits td.exit {
		width: 64px;
	}
	.exit-code {
		display: inline-grid;
		place-items: center;
		min-width: 26px;
		height: 24px;
		border-radius: var(--radius-control);
		background: var(--well);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		box-shadow:
			var(--shadow-well),
			inset 0 0 0 1px var(--rule);
	}
	.exit-code.ok {
		color: var(--added);
	}
	.outputs {
		max-width: var(--docs-prose);
	}
	.refusal-row:target {
		background: var(--highlight);
	}
	.when {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--ink);
	}
</style>
