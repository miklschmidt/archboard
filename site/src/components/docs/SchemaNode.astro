---
// One field of a JSON Schema and everything under it: its type, whether it is required, its limits
// and its fields. An object or a list of objects opens to its fields, and a choice lists each
// shape it accepts. Deep levels start closed, so a long schema reads from the top down.
import type { JsonSchema } from "../../lib/reference";

interface Props {
	readonly name: string | null;
	readonly schema: JsonSchema;
	readonly required?: boolean;
	readonly depth: number;
	/** The root schema's $defs, which a $ref names. */
	readonly defs: Record<string, JsonSchema>;
	/** The definitions that this node sits inside, so a definition that holds itself stops. */
	readonly seen?: readonly string[];
}

const { name, required = false, depth, defs, seen = [] } = Astro.props;
/** The definition a schema names with $ref, if it names one. */
const refOf = (value: unknown): string | null => {
	const ref = typeof value === "object" && value !== null ? (value as JsonSchema)["$ref"] : undefined;
	return typeof ref === "string" && ref.startsWith("#/$defs/") ? ref.slice("#/$defs/".length) : null;
};
const raw = Astro.props.schema;
const rawItems = raw["items"];
const named = [
	refOf(raw),
	refOf(rawItems),
	...[raw["anyOf"], raw["oneOf"]].flatMap((list) => (Array.isArray(list) ? list.map(refOf) : [])),
].filter((ref): ref is string => ref !== null);
// A definition that holds itself, such as a loop step that holds steps, opens once.
const repeats = named.some((ref) => seen.includes(ref)) || depth > 9;
const inside = [...seen, ...named];

/** A schema with its $ref replaced by the definition it names. */
function resolve(schema: JsonSchema): JsonSchema {
	const ref = schema["$ref"];
	if (typeof ref === "string" && ref.startsWith("#/$defs/")) {
		const target = defs[ref.slice("#/$defs/".length)];
		if (target) {
			const { $ref: _, ...rest } = schema;
			return { ...target, ...rest };
		}
	}
	return schema;
}

const schema = resolve(Astro.props.schema);
const asObject = (value: unknown): JsonSchema | null =>
	typeof value === "object" && value !== null && !Array.isArray(value) ? (value as JsonSchema) : null;
const asList = (value: unknown): JsonSchema[] =>
	Array.isArray(value) ? value.map((entry) => resolve(asObject(entry) ?? {})) : [];

const choices = [...asList(schema["anyOf"]), ...asList(schema["oneOf"])];
const allOf = asList(schema["allOf"]);
const items = asObject(schema["items"]);
const itemSchema = items ? resolve(items) : null;
const fieldsOf = (target: JsonSchema | null) => asObject(target?.["properties"]);
const requiredOf = (target: JsonSchema | null): string[] =>
	Array.isArray(target?.["required"]) ? (target["required"] as string[]) : [];

/** The object whose fields this node lists: itself, the items of a list, or its allOf parts. */
const owner = fieldsOf(schema)
	? schema
	: itemSchema && fieldsOf(itemSchema)
		? itemSchema
		: (allOf.find((part) => fieldsOf(part)) ?? null);
const fields = Object.entries(fieldsOf(owner) ?? {});
const requiredFields = requiredOf(owner);
const map = asObject(owner?.["additionalProperties"] ?? schema["additionalProperties"]);
const mapValue = map && Object.keys(map).length > 0 ? resolve(map) : null;
const itemChoices = itemSchema ? [...asList(itemSchema["anyOf"]), ...asList(itemSchema["oneOf"])] : [];
const shapes = choices.length > 0 ? choices : itemChoices;

/** A short word for the type of a schema. */
function typeOf(target: JsonSchema): string {
	if ("const" in target) return JSON.stringify(target["const"]);
	if (Array.isArray(target["enum"])) return "one of";
	const type = target["type"];
	if (type === "array") {
		const inner = asObject(target["items"]);
		return inner ? `list of ${typeOf(resolve(inner))}` : "list";
	}
	if (Array.isArray(type)) return type.join(" or ");
	if (typeof type === "string") {
		if (type === "object" && asObject(target["additionalProperties"]) && !asObject(target["properties"])) {
			return "map";
		}
		return type;
	}
	if (asList(target["anyOf"]).length > 0 || asList(target["oneOf"]).length > 0) return "one of these";
	if (asList(target["allOf"]).length > 0) return "object";
	return "any";
}

/** What tells one shape of a choice from another: the value of its first constant field. */
function shapeName(target: JsonSchema, index: number): string {
	for (const [key, value] of Object.entries(fieldsOf(target) ?? {})) {
		const field = asObject(value);
		if (field && "const" in field) return `${key}: ${JSON.stringify(field["const"])}`;
	}
	const title = target["title"];
	return typeof title === "string" ? title : `Shape ${index + 1} · ${typeOf(target)}`;
}

const ENUM_SHOWN = 12;
const enumValues = Array.isArray(schema["enum"]) ? (schema["enum"] as unknown[]) : [];
/** A count with its noun. */
const count = (value: unknown, noun: string) => `${String(value)} ${noun}${value === 1 ? "" : "s"}`;
/** The largest integer JavaScript holds exactly says no limit. */
const bounded = (value: unknown) => typeof value === "number" && Math.abs(value) < Number.MAX_SAFE_INTEGER;
const limits = [
	typeof schema["minLength"] === "number" &&
		(schema["minLength"] === 1 ? "not empty" : `at least ${count(schema["minLength"], "character")}`),
	typeof schema["maxLength"] === "number" && `at most ${count(schema["maxLength"], "character")}`,
	bounded(schema["minimum"]) && `at least ${String(schema["minimum"])}`,
	bounded(schema["exclusiveMinimum"]) && `more than ${String(schema["exclusiveMinimum"])}`,
	bounded(schema["maximum"]) && `at most ${String(schema["maximum"])}`,
	typeof schema["minItems"] === "number" &&
		schema["minItems"] !== 0 &&
		`at least ${count(schema["minItems"], "item")}`,
	typeof schema["maxItems"] === "number" && `at most ${count(schema["maxItems"], "item")}`,
	schema["uniqueItems"] === true && "no repeats",
].filter((limit): limit is string => typeof limit === "string");
// A pattern that only asks for one character that is not a space is a plain rule.
const rawPattern = typeof schema["pattern"] === "string" ? schema["pattern"] : null;
if (rawPattern === "\\S") limits.push("not blank");
const pattern = rawPattern === "\\S" ? null : rawPattern;
const description = typeof schema["description"] === "string" ? schema["description"] : null;
const fallback = "default" in schema ? JSON.stringify(schema["default"]) : null;
const hasChildren = !repeats && (fields.length > 0 || shapes.length > 0 || mapValue !== null);
const open = depth < 1;
---

<div class:list={["node", { root: name === null }]}>
	{
		name !== null && (
			<div class="field">
				<code class="field-name">{name}</code>
				<span class="field-type">{typeOf(schema)}</span>
				{required && <span class="required">required</span>}
				{fallback !== null && fallback !== "[]" && fallback !== "{}" && (
					<span class="default">
						default <code>{fallback}</code>
					</span>
				)}
			</div>
		)
	}
	{description && <p class="field-text">{description}</p>}
	{repeats && <p class="field-limits">The same shape as the field that holds it, one level up.</p>}
	{
		(limits.length > 0 || pattern) && (
			<p class="field-limits">
				{limits.join(", ")}
				{limits.length > 0 && pattern && ", "}
				{pattern && (
					<>
						matches <code>{pattern}</code>
					</>
				)}
			</p>
		)
	}
	{
		enumValues.length > 0 && (
			<p class="field-enum">
				{enumValues.slice(0, ENUM_SHOWN).map((value) => (
					<code>{JSON.stringify(value)}</code>
				))}
				{enumValues.length > ENUM_SHOWN && <span>and {enumValues.length - ENUM_SHOWN} more</span>}
			</p>
		)
	}
	{
		hasChildren &&
			(name === null ? (
				<div class="children">
					{fields.map(([key, value]) => (
						<Astro.self
							name={key}
							schema={asObject(value) ?? {}}
							required={requiredFields.includes(key)}
							depth={depth + 1}
							defs={defs} seen={inside}
						/>
					))}
					{mapValue && <Astro.self name="<any key>" schema={mapValue} depth={depth + 1} defs={defs} seen={inside} />}
					{shapes.map((shape, index) => (
						<details class="shape" open={depth < 0}>
							<summary>{shapeName(shape, index)}</summary>
							<Astro.self name={null} schema={shape} depth={depth + 1} defs={defs} seen={inside} />
						</details>
					))}
				</div>
			) : (
				<details class="children-box" open={open}>
					<summary>
						{fields.length > 0
							? `${fields.length} field${fields.length === 1 ? "" : "s"}`
							: shapes.length > 0
								? `${shapes.length} shapes`
								: "value"}
					</summary>
					<div class="children">
						{fields.map(([key, value]) => (
							<Astro.self
								name={key}
								schema={asObject(value) ?? {}}
								required={requiredFields.includes(key)}
								depth={depth + 1}
								defs={defs} seen={inside}
							/>
						))}
						{mapValue && <Astro.self name="<any key>" schema={mapValue} depth={depth + 1} defs={defs} seen={inside} />}
						{shapes.map((shape, index) => (
							<details class="shape">
								<summary>{shapeName(shape, index)}</summary>
								<Astro.self name={null} schema={shape} depth={depth + 1} defs={defs} seen={inside} />
							</details>
						))}
					</div>
				</details>
			))
	}
</div>

<style>
	.node:not(.root) {
		padding: 12px 0 12px 16px;
	}
	.node:not(.root) + .node:not(.root) {
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.field {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px 10px;
	}
	.field-name {
		font-size: 0.875rem !important;
		color: var(--ink);
		background: none !important;
		box-shadow: none !important;
		padding: 0 !important;
		font-weight: 500;
	}
	.field-type {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--sky-text);
	}
	.required {
		padding: 0 6px;
		border-radius: var(--radius-chip);
		background: var(--well);
		box-shadow: inset 0 0 0 1px var(--rule-strong);
		color: var(--ink);
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 18px;
	}
	.default {
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}
	.field-text,
	.field-limits,
	.field-enum {
		margin-top: 6px;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}
	.field-text {
		color: var(--ink-body);
	}
	.field-enum {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 6px;
		align-items: center;
	}
	.children {
		margin-top: 4px;
	}
	.children-box,
	.shape {
		margin-top: 8px;
	}
	.children-box > .children {
		margin-left: 4px;
		box-shadow: inset 1px 0 0 var(--rule-strong);
	}
	summary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 2px 8px 2px 6px;
		border-radius: var(--radius-control);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
		cursor: pointer;
		list-style: none;
		user-select: none;
		transition:
			color 160ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::before {
		content: "";
		width: 0;
		height: 0;
		border-left: 5px solid var(--gold-mark);
		border-top: 4px solid transparent;
		border-bottom: 4px solid transparent;
		transition: transform 160ms var(--ease-out);
	}
	details[open] > summary::before {
		transform: rotate(90deg);
	}
	summary:hover {
		color: var(--ink);
		background: oklch(1 0.01 85 / 0.05);
	}
	.shape {
		padding-left: 16px;
	}
	.shape > summary {
		font-family: var(--font-mono);
		font-weight: 500;
		color: var(--ink);
	}
</style>
