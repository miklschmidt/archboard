---
// The search: a dialog over the page that asks Pagefind's index, which the build writes into
// dist/pagefind. Each result names its page and the sections inside it that match.
import Icon from "../Icon.astro";
---

<dialog class="search" data-search aria-label="Search the docs">
	<div class="panel">
		<div class="field">
			<Icon name="search" size={18} />
			<input
				type="search"
				placeholder="Search the docs"
				autocomplete="off"
				spellcheck="false"
				role="combobox"
				aria-label="Search the docs"
				aria-controls="search-results"
				aria-autocomplete="list"
				aria-expanded="false"
				data-search-input
			/>
			<button type="button" class="close" data-search-close aria-label="Close the search">
				<kbd>Esc</kbd>
			</button>
		</div>
		<div class="results" id="search-results" role="listbox" aria-label="Search results" data-search-results>
			<p class="hint" data-search-hint>Type to search every page, command and schema.</p>
		</div>
		<div class="foot" aria-hidden="true">
			<span><kbd>↑</kbd><kbd>↓</kbd> to move</span>
			<span><kbd>Enter</kbd> to open</span>
			<span><kbd>/</kbd> or <kbd>Ctrl</kbd><kbd>K</kbd> to search</span>
		</div>
	</div>
</dialog>

<style>
	.search {
		width: min(680px, calc(100vw - 32px));
		max-height: min(640px, calc(100vh - 96px));
		margin: 72px auto auto;
		padding: 0;
		border: 0;
		border-radius: var(--radius-table);
		background: transparent;
		color: var(--ink-body);
		overflow: visible;
	}
	.search::backdrop {
		background: oklch(0.08 0.004 75 / 0.62);
		backdrop-filter: blur(3px);
	}
	.search[open] {
		animation: rise 220ms var(--ease-out);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.985);
		}
	}
	.panel {
		display: flex;
		flex-direction: column;
		max-height: inherit;
		padding: 6px;
		border-radius: var(--radius-table);
		background: var(--chrome);
		box-shadow:
			var(--shadow-table),
			inset 0 0 0 1px var(--rule-strong);
	}
	.field {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 52px;
		padding: 0 8px 0 16px;
		border-radius: var(--radius-panel);
		background: var(--well);
		color: var(--ink-muted);
		box-shadow:
			var(--shadow-well),
			inset 0 0 0 1px var(--rule);
	}
	input {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 1.0625rem;
		outline: none;
	}
	input::placeholder {
		color: var(--ink-muted);
	}
	input::-webkit-search-cancel-button {
		display: none;
	}
	.close {
		border: 0;
		background: none;
		padding: 0;
		cursor: pointer;
	}
	.results {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 8px 4px;
		overscroll-behavior: contain;
	}
	.hint {
		padding: 28px 16px;
		font-size: 0.9375rem;
		color: var(--ink-muted);
		text-align: center;
	}
	.results :global(.result) {
		display: block;
		padding: 10px 14px;
		border-radius: var(--radius-panel);
		color: var(--ink-body);
		text-decoration: none;
	}
	.results :global(.result + .result) {
		margin-top: 2px;
	}
	.results :global(.result-page) {
		display: flex;
		align-items: baseline;
		gap: 10px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--ink-muted);
	}
	.results :global(.result-title) {
		display: block;
		margin-top: 2px;
		font-weight: 600;
		color: var(--ink);
	}
	.results :global(.result-excerpt) {
		display: block;
		margin-top: 4px;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}
	.results :global(mark) {
		background: none;
		color: var(--gold-mark);
		font-weight: 600;
	}
	.results :global(.result[aria-selected="true"]) {
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule),
			inset 0 -2px 0 var(--gold-mark);
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		padding: 10px 12px 6px;
		font-size: 0.75rem;
		color: var(--ink-muted);
	}
	.foot span {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	kbd {
		display: inline-grid;
		place-items: center;
		min-width: 22px;
		height: 22px;
		padding: 0 6px;
		border-radius: var(--radius-control);
		background: var(--raised);
		color: var(--ink-muted);
		font-family: var(--font-body);
		font-size: 0.75rem;
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	@media (max-width: 560px) {
		.search {
			margin-top: 16px;
		}
		.foot {
			display: none;
		}
	}
</style>
