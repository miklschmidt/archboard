---
// A small head inside a reference entry, such as a command's examples, with its own address.
interface Props {
	readonly id: string;
}

const { id } = Astro.props;
---

<p class="sub-head" id={id}>
	<a href={`#${id}`}><slot /></a>
</p>

<style>
	.sub-head {
		margin-top: 22px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
	}
	.sub-head a {
		color: inherit;
		text-decoration: none;
	}
	.sub-head a:hover {
		color: var(--gold-mark);
	}
	.sub-head:target {
		color: var(--gold-mark);
	}
</style>
