---
// The README's questions, in its words.
const items = [
	{
		q: "Can I move a box?",
		a: "No. Vault files store architectural meaning, not coordinates. If a diagram misrepresents the system, fix the model and let the renderer lay it out again. If the model is right and the layout is poor, that is a renderer bug; fixing it improves every view and historical checkpoint automatically.",
	},
	{
		q: "Does Archboard score my design?",
		a: "No. Measures reports raw counts: entry points, hidden parts, pass-throughs, and Git co-change pairs. High numbers can have valid reasons, so Archboard surfaces the evidence and leaves the design call to you.",
	},
	{
		q: "Which agents does it work with?",
		a: "Any coding agent that can run a CLI can author and update the model. Running archboard init installs skills for Codex and, when detected, Claude Code; other agents can install them via npx skills add miklschmidt/archboard -g. The in-browser agent, voice chat, narration, and video recording use Codex through Archboard's private app-server sign-in.",
	},
	{
		q: "Where does the architecture live?",
		a: "Everything lives in .archboard/vault inside your repository. Each .module.json file defines one module and its outgoing relationships, alongside JSON files for flows, active proposals, and walkthroughs. Git tracks the active files with your code, while a separate Git archive retains checkpoints and past decisions.",
	},
	{
		q: "Does the diagram stay in sync with the code?",
		a: "Your agent updates the model in the same task as the code change. Running archboard check code verifies bindings and anchors against source and infrastructure files, flagging broken references, reversed relationships, and unmodeled calls between mapped modules so the agent can reconcile them in a proposal.",
	},
	{
		q: "Does my code leave my machine?",
		a: "The vault, local server, static analysis, and WebAssembly renderer all run locally. Your coding agent and Codex voice send only the files and prompts they read to their respective model providers, under those providers' data policies.",
	},
	{
		q: "Is the traffic animation real traffic?",
		a: "No. Pulse animations illustrate authored request paths and relative volume; they are not live telemetry or production metrics.",
	},
	{
		q: "Is it safe to run?",
		a: "The server binds to 127.0.0.1 and has no authentication, so keep it on loopback. To use it from another machine, use an SSH tunnel.",
	},
	{
		q: "Can I use it at work?",
		a: "Yes, for individuals and organizations with fewer than 50 people and under US$1,000,000 in annual revenue, provided you do not offer Archboard as a hosted service. Other use requires a separate license. Each release converts to the MIT license four years after publication.",
	},
	{
		q: "Is it stable?",
		a: "Archboard is under active development and its CLI and file formats still evolve. Install releases from npm; the UI targets desktop browsers on Linux and macOS.",
	},
];
---

<div class="faq">
	{
		items.map((item, index) => (
			<div data-reveal style={`--reveal-delay: ${(index % 2) * 100}`}>
				<details class="item">
					<summary>
						<span>{item.q}</span>
						<span class="sign" aria-hidden="true" />
					</summary>
					<p>{item.a}</p>
				</details>
			</div>
		))
	}
</div>

<style>
	.faq {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px 24px;
		align-items: start;
	}
	.item {
		border-radius: var(--radius-panel);
		background: var(--plane);
		box-shadow: inset 0 0 0 1px var(--rule);
		transition:
			background-color 200ms var(--ease-out),
			box-shadow 200ms var(--ease-out);
	}
	.item[open] {
		background: var(--card);
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px var(--rule);
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 20px;
		font-weight: 600;
		color: var(--ink);
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.sign {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
	}
	.sign::before,
	.sign::after {
		content: "";
		position: absolute;
		left: 0;
		top: 6px;
		width: 14px;
		height: 2px;
		border-radius: 1px;
		background: var(--gold-mark);
		transition: rotate 220ms var(--ease-out);
	}
	.sign::after {
		rotate: 90deg;
	}
	.item[open] .sign::after {
		rotate: 0deg;
	}
	.item p {
		padding: 0 20px 20px;
		color: var(--ink-body);
		max-width: 40em;
	}
	@media (max-width: 860px) {
		.faq {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
