---
// Where Archboard fits, job by job, planning first: what people use for each job today, from each
// vendor's public pages as of November 2026, and what Archboard does for the same job. On a phone
// each row becomes a block.
const rows: { job: string; others: string; archboard: string }[] = [
	{
		job: "Planning a change before coding",
		others: "Agent plan mode or a design doc. The plan stays prose with no link to the eventual diff.",
		archboard: "Your agent drafts a structured proposal against the current model, or two options side by side. You pick the design up front, and the branch footprint flags work outside the proposal.",
	},
	{
		job: "Reviewing a change",
		others: "Read the raw file diff or an agent-generated PR summary.",
		archboard: "Inspect the structural diff alongside the code diff. Proposals overlay changes on the live model, and adopting one logs the rationale while retaining the previous state as a checkpoint.",
	},
	{
		job: "Verifying the model against code",
		others: "Audit source files manually or ask an agent to re-read them.",
		archboard: "archboard check code flags broken bindings, reversed relationships, and unmodeled calls between bound modules, distinguishing resolved symbols from name-only matches.",
	},
	{
		job: "Onboarding to an unfamiliar repo",
		others: "Prompt an agent or generate a one-off view in DeepWiki or GitDiagram, then rebuild context next session.",
		archboard: "Your agent commits the model into .archboard/vault once, and every future session starts from that checked-in architecture.",
	},
	{
		job: "Navigating a codebase",
		others: "Windsurf Codemaps or call-graph tools like GitNexus map files and call sites inside the editor.",
		archboard: "Models architectural responsibilities (services, data stores, and boundaries), with each module bound directly to its file or symbol.",
	},
	{
		job: "Diagrams for docs and PRs",
		others: "Mermaid or D2 snippets in Markdown, updated manually after refactors.",
		archboard: "Every diagram renders from the shared model. Tracked embeds carry render recipes, so archboard check embeds detects stale images and regenerates them.",
	},
	{
		job: "Shared team architecture",
		others: "IcePanel, Structurizr, LikeC4, or CodeViz, maintained in a separate platform or DSL.",
		archboard: "Plain JSON files in your repo, authored via CLI by your coding agent, with versioned proposals and local Git checkpoints.",
	},
];
---

<div class="compare table" data-reveal>
	<div class="scroll">
		<table>
			<caption class="sr-only">Where Archboard fits compared with existing tools</caption>
			<thead>
				<tr>
					<th scope="col" class="row-head">Job</th>
					<th scope="col">What people use today</th>
					<th scope="col" class="ours">With Archboard</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<tr>
							<th scope="row" class="row-head">{row.job}</th>
							<td data-label="What people use today">{row.others}</td>
							<td class="ours" data-label="With Archboard">{row.archboard}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<p class="caption foot">
		Tool descriptions reflect public vendor documentation as of November 2026.
	</p>
</div>

<style>
	.compare {
		padding: 6px;
		background: var(--chrome);
	}
	.scroll {
		overflow-x: auto;
		border-radius: 6px;
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	table {
		width: 100%;
		min-width: 760px;
		table-layout: fixed;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 0.875rem;
		line-height: 1.45;
	}
	th,
	td {
		padding: 14px 16px;
		text-align: left;
		vertical-align: top;
	}
	thead th {
		position: sticky;
		top: 0;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
		background: var(--well);
		box-shadow: inset 0 -1px 0 var(--rule);
		white-space: nowrap;
	}
	thead th.ours {
		width: 42%;
		color: var(--ink);
	}
	tbody tr + tr > * {
		box-shadow: inset 0 1px 0 oklch(1 0.01 85 / 0.05);
	}
	.row-head {
		position: sticky;
		left: 0;
		z-index: 1;
		width: 22%;
		background: var(--well);
		font-weight: 500;
		color: var(--ink);
	}
	td {
		color: var(--ink-body);
	}
	.ours {
		background: color-mix(in oklch, var(--gold-mark) 6%, var(--plane));
	}
	thead .ours {
		background: color-mix(in oklch, var(--gold-mark) 9%, var(--plane));
		box-shadow:
			inset 0 -1px 0 var(--rule),
			inset 0 2px 0 var(--gold-mark);
	}
	td.ours {
		color: var(--ink);
	}
	.foot {
		padding: 14px 10px 6px;
		max-width: 60em;
	}
	@media (max-width: 760px) {
		.scroll {
			overflow: visible;
			background: none;
			box-shadow: none;
		}
		table,
		tbody,
		tr,
		th,
		td {
			display: block;
		}
		table {
			min-width: 0;
		}
		thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
		tbody {
			display: flex;
			flex-direction: column;
			gap: 6px;
		}
		tr {
			padding: 14px 14px 10px;
			border-radius: 6px;
			background: var(--well);
			box-shadow: var(--shadow-well);
		}
		tbody tr + tr > * {
			box-shadow: none;
		}
		.row-head {
			position: static;
			width: auto;
			min-width: 0;
			padding: 0 0 8px;
			background: none;
			font-weight: 600;
		}
		td {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: 2px;
			padding: 6px 0;
		}
		td::before {
			content: attr(data-label);
			font-size: 0.8125rem;
			color: var(--ink-muted);
		}
		td.ours {
			margin: 2px -8px;
			padding: 6px 8px;
			border-radius: 4px;
		}
		td.ours::before {
			color: var(--gold-mark);
		}
	}
</style>
