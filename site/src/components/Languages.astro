---
// What the code check reads, from the README. A slow belt, paused for reduced motion.
const items = [
	"TypeScript",
	"Python",
	"C#",
	"Swift",
	"Rust",
	"C",
	"C++",
	"Objective-C",
	"Terraform",
	"OpenTofu",
	"Kubernetes manifests",
	"Docker Compose",
	"Nix flakes",
];
---

<section class="languages" aria-label="What the code check reads">
	<p class="intro container">The code check reads</p>
	<div class="belt">
		<ul class="track">
			{items.map((item) => <li>{item}</li>)}
		</ul>
		<ul class="track" aria-hidden="true">
			{items.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</section>

<style>
	.languages {
		padding-top: clamp(72px, 9vw, 120px);
	}
	.intro {
		margin-bottom: 18px;
		font-size: 0.9375rem;
		color: var(--ink-muted);
	}
	.belt {
		display: flex;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
	}
	.track {
		display: flex;
		flex: none;
		gap: 56px;
		padding: 0 28px;
		margin: 0;
		list-style: none;
	}
	.track li {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 650;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--ink-faint);
		transition: color 200ms var(--ease-out);
	}
	.track li:hover {
		color: var(--ink);
	}
	@media (prefers-reduced-motion: no-preference) {
		.track {
			animation: belt 46s linear infinite;
		}
		.belt:hover .track {
			animation-play-state: paused;
		}
	}
	@keyframes belt {
		to {
			transform: translateX(-100%);
		}
	}
</style>
