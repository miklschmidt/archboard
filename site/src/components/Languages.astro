---
// What the code check reads, from the README: one line, its label at the left and a slow belt of
// languages running out from under it. The belt stops for reduced motion.
const items = [
	"TypeScript",
	"Python",
	"C#",
	"Swift",
	"Rust",
	"C",
	"C++",
	"Objective-C",
	"Terraform",
	"OpenTofu",
	"Kubernetes manifests",
	"Docker Compose",
	"Nix flakes",
];
---

<section class="languages" aria-label="What the code check reads" data-loop>
	<p class="intro">The code check reads</p>
	<div class="belt">
		<ul class="track">
			{items.map((item) => <li>{item}</li>)}
		</ul>
		<ul class="track" aria-hidden="true">
			{items.map((item) => <li>{item}</li>)}
		</ul>
	</div>
</section>

<style>
	.languages {
		display: flex;
		align-items: center;
		padding-top: clamp(72px, 9vw, 120px);
	}
	/* The label starts where the page's container starts. */
	.intro {
		flex: none;
		padding-left: max(var(--gutter), calc((100% - var(--measure)) / 2));
		padding-right: 4px;
		font-size: 0.9375rem;
		color: var(--ink-muted);
		white-space: nowrap;
	}
	.belt {
		flex: 1;
		min-width: 0;
		display: flex;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, black 10%, black 88%, transparent);
	}
	.track {
		display: flex;
		flex: none;
		gap: 56px;
		padding: 0 28px;
		margin: 0;
		list-style: none;
	}
	.track li {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 650;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		white-space: nowrap;
		/* Display-size words: about Lc 57, over the large-text floor. */
		color: color-mix(in oklch, var(--ink-muted) 70%, var(--ink-faint));
		transition: color 200ms var(--ease-out);
	}
	.track li:hover {
		color: var(--ink);
	}
	@media (prefers-reduced-motion: no-preference) {
		.track {
			animation: belt 46s linear infinite;
		}
		.belt:hover .track {
			animation-play-state: paused;
		}
	}
	@keyframes belt {
		to {
			transform: translateX(-100%);
		}
	}
</style>
