---
import Mark from "./Mark.astro";
import { links } from "../lib/links";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const columns = [
	{
		title: "Product",
		items: [
			["Quick start", `${base}/#quick-start`],
			["Compared", `${base}/#compare`],
			["Docs", `${base}/docs/`],
			["README", links.readme],
			["INSTALL.md", links.install],
		],
	},
	{
		title: "Project",
		items: [
			["GitHub", links.repository],
			["Architecture decisions", links.adrs],
			["The agent skill", links.skill],
			["Issues", links.issues],
		],
	},
];
---

<footer class="footer">
	<div class="container footer-row">
		<div class="about">
			<a class="brand" href={`${base}/`} aria-label="archboard, the home page">
				<Mark size={22} id="footer-mark" />
				<span class="wordmark" aria-hidden="true">archboard</span>
			</a>
			<p class="caption">
				Source-available under the <a href={links.license}>Business Source License 1.1</a>, not open
				source. Production use is free for individuals, and for organizations with fewer than 50
				people and under US$1,000,000 in annual revenue that do not sell it as a hosted service. Each
				version becomes MIT-licensed four years after its first publication.
			</p>
			<p class="caption">Archboard drew every diagram on this site.</p>
		</div>
		{
			columns.map((column) => (
				<nav class="column" aria-label={column.title}>
					<p class="column-title">{column.title}</p>
					<ul>
						{column.items.map(([label, href]) => (
							<li>
								<a href={href}>{label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
</footer>

<style>
	.footer {
		padding: 64px 0 72px;
		background: var(--chrome);
		box-shadow: inset 0 1px 0 var(--rule);
	}
	.footer-row {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: 40px;
	}
	.about {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 34em;
	}
	.brand {
		display: inline-flex;
		align-items: flex-end;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 20px;
		font-weight: 560;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: -2px;
	}
	.column-title {
		margin-bottom: 14px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
	}
	.column ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.column a {
		font-size: 0.9375rem;
		color: var(--ink-muted);
		text-decoration: none;
	}
	.column a:hover {
		color: var(--ink);
	}
	@media (max-width: 760px) {
		.footer-row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.about {
			grid-column: 1 / -1;
		}
	}
</style>
