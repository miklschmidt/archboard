---
// The right panel of the mock shell, with Checkout API selected. Its counts and lists are the
// answer of `archboard model inspect "Checkout API"` over the example shop.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";

const measures = [
	["Entry points", 2],
	["Hidden parts", 1],
	["Callers", 1],
	["Outgoing", 8],
	["Pass-through", 0],
] as const;
const entries = [
	["Place order", "from Storefront"],
	["Basket route", "from Storefront"],
] as const;
---

<aside class="inspector" aria-hidden="true" data-inspector>
	<div class="head">
		<KindChip kind="service" size={22} />
		<div>
			<p class="name">Checkout API</p>
			<p class="kind">Service</p>
		</div>
	</div>
	<p class="summary">Takes an order, charges it and confirms it.</p>
	<div class="block">
		<p class="label">Interface</p>
		<dl class="measures">
			{
				measures.map(([label, value]) => (
					<div>
						<dt>{label}</dt>
						<dd>{value}</dd>
					</div>
				))
			}
		</dl>
	</div>
	<div class="block">
		<p class="label">Entry points</p>
		<ul class="list">
			{
				entries.map(([name, from]) => (
					<li>
						<span class="ink">{name}</span>
						<span class="from">{from}</span>
					</li>
				))
			}
		</ul>
	</div>
	<div class="block">
		<p class="label">Hidden</p>
		<ul class="list">
			<li><span class="ink">Timeout guard</span></li>
		</ul>
	</div>
	<div class="actions">
		<span class="action quiet"><Icon name="question" size={14} /> Explain with Codex</span>
		<span class="action gold">Open Checkout API <Icon name="arrowRight" size={14} /></span>
	</div>
</aside>

<style>
	.inspector {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 16px;
		background: var(--chrome);
		box-shadow: inset 1px 0 0 var(--rule);
		min-height: 0;
	}
	.head {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.name {
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 22px;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}
	.kind {
		font-size: 11px;
		color: var(--ink-muted);
	}
	.summary {
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--ink-body);
	}
	.block {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.label {
		font-size: 11.5px;
		font-weight: 600;
		color: var(--ink);
	}
	.measures {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 4px;
		margin: 0;
	}
	.measures div {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 6px 8px;
		border-radius: 3px;
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	.measures dt {
		font-size: 11px;
		color: var(--ink-muted);
	}
	.measures dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-size: 12px;
	}
	.list li {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		padding: 5px 8px;
		border-radius: 3px;
		background: var(--plane);
	}
	.from {
		color: var(--ink-muted);
		font-size: 11px;
	}
	.actions {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-bottom: 4px;
	}
	.action {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		height: 32px;
		border-radius: 4px;
		font-size: 12.5px;
		font-weight: 600;
	}
	.action.quiet {
		background: var(--raised);
		color: var(--ink);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.action.gold {
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge),
			0 1px 0 oklch(0.06 0.004 75 / 0.8);
	}
</style>
