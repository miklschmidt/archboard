---
// The right panel of the mock shell, with Checkout API selected at the shop's root, as the shell
// shows it: the subject and its interface and implementation, then the legend that ends the scroll,
// over a row of keys. The shell lists more under a module, and the mock keeps its first sections.
// The counts are the example shop's.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";
import PanelLegend from "./PanelLegend.astro";

const interfaceCounts = [
	["Entries", 2],
	["Caller", 1],
	["Pass-through", 0],
] as const;
---

<aside class="inspector" aria-hidden="true" data-inspector>
	<div class="scroll">
		<div class="identity">
			<div class="head">
				<KindChip kind="service" size={24} look="panel" />
				<div class="title">
					<p class="name">Checkout API</p>
					<p class="kind">Service</p>
				</div>
				<Icon name="close" size={16} />
			</div>
			<p class="summary">Takes an order, charges it and confirms it</p>
		</div>
		<div class="block">
			<p class="label">Interface <span class="small">Open in About</span></p>
			<ul class="rows">
				{
					interfaceCounts.map(([label, value]) => (
						<li class:list={{ off: value === 0 }}>
							{label}
							<span class="mono">{value}</span>
						</li>
					))
				}
			</ul>
		</div>
		<div class="block">
			<p class="label">Implementation</p>
			<ul class="rows">
				<li>Hidden part <span class="mono">1</span></li>
			</ul>
		</div>
		<PanelLegend />
	</div>
	<div class="actions">
		<span class="action gold">Open module</span>
		<span class="action">Focus</span>
		<span class="action"><Icon name="openai" size={15} /> Explain <Icon name="chevronDown" size={15} /></span>
	</div>
</aside>

<style>
	.inspector {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--chrome);
		font-size: 12.5px;
	}
	/* What the panel says scrolls, and the legend ends it: it stands at the foot of the scroll
	   while the subject leaves room. */
	.scroll {
		flex: 1;
		min-height: 0;
		overflow-x: hidden;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 16px;
	}
	.scroll > :global(:last-child) {
		margin-top: auto;
	}
	.identity {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.head {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		color: var(--ink);
	}
	.title {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.name {
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 22px;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}
	.kind {
		font-size: 12px;
		color: var(--ink-muted);
	}
	.summary {
		color: var(--ink-body);
	}
	.block {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	/* A section's label is the left column's: its name in full ink and semibold. */
	.label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 24px;
		font-weight: 600;
		color: var(--ink);
	}
	.small {
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 12px;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	/* A count is a row of the left column, on the panel's ground with no plate: what it counts at
	   the start, its number at the end. */
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 28px;
		font-size: 13px;
		color: var(--ink);
	}
	.rows li.off {
		color: var(--ink-muted);
	}
	.rows .mono {
		font-size: 11px;
		color: var(--ink-muted);
	}
	/* The foot is a row of keys on the panel's ground, on two columns. */
	.actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		padding: 4px 16px 16px;
	}
	.action {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		height: 32px;
		padding: 0 10px;
		border-radius: 4px;
		font-weight: 600;
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.action:last-child {
		grid-column: span 2;
	}
	.action.gold {
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge),
			0 1px 0 oklch(0.06 0.004 75 / 0.8);
	}
</style>
