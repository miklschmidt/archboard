---
// The right panel of the mock shell, with Checkout API selected at the shop's root, as the shell
// shows it: the subject, its interface and implementation, its actions and the legend. The
// counts are the example shop's.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";
import PanelLegend from "./PanelLegend.astro";

const interfaceCounts = [
	["Entries", 2],
	["Caller", 1],
	["Pass-through", 0],
] as const;
---

<aside class="inspector" aria-hidden="true" data-inspector>
	<div class="subject">
		<div class="head">
			<KindChip kind="service" size={24} />
			<div class="title">
				<p class="name">Checkout API</p>
				<p class="kind">Service</p>
			</div>
			<Icon name="close" size={16} />
		</div>
		<p class="summary">Takes an order, charges it and confirms it</p>
		<div class="block">
			<p class="label">Interface <span class="small">Open in About</span></p>
			<dl class="counts">
				{
					interfaceCounts.map(([label, value]) => (
						<div class:list={{ none: value === 0 }}>
							<dt>{label}</dt>
							<dd>{value}</dd>
						</div>
					))
				}
			</dl>
		</div>
		<div class="block">
			<p class="label">Implementation</p>
			<dl class="counts">
				<div>
					<dt>Hidden part</dt>
					<dd>1</dd>
				</div>
			</dl>
		</div>
	</div>
	<div class="actions">
		<span class="action gold">Open module</span>
		<span class="action">Focus</span>
		<span class="action"><Icon name="openai" size={15} /> Explain with Codex <Icon name="chevronDown" size={15} /></span>
	</div>
	<PanelLegend />
</aside>

<style>
	.inspector {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--chrome);
		font-size: 12.5px;
	}
	.subject {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 16px;
	}
	.head {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		color: var(--ink);
	}
	.title {
		flex: 1;
	}
	.name {
		font-family: var(--font-display);
		font-size: 20px;
		line-height: 22px;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}
	.kind {
		font-size: 12px;
		color: var(--ink-muted);
	}
	.summary {
		color: var(--ink-body);
	}
	.block {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-weight: 600;
		color: var(--ink);
	}
	.small {
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 12px;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	.counts {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 4px;
		margin: 0;
	}
	.counts div {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 5px 8px;
		border-radius: 3px;
		background: var(--well);
		box-shadow: var(--shadow-well);
		color: var(--ink-body);
	}
	.counts div.none {
		color: var(--ink-faint);
	}
	.counts dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 12px 16px;
	}
	.action {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 30px;
		padding: 0 10px;
		border-radius: 4px;
		font-weight: 600;
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.action.gold {
		flex-basis: 100%;
		max-width: fit-content;
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge),
			0 1px 0 oklch(0.06 0.004 75 / 0.8);
	}
</style>
