---
// The left column of the mock shell: the repository switcher, the keys of History and Measures,
// and one list with a section for modules, flows and walkthroughs. The rows and counts are the
// example shop's, as the shell lists them at its root with Checkout API selected. While the agent
// holds its claim, Working now shows it, as the shell does.
import Icon from "../Icon.astro";

interface Row {
	name: string;
	/** The row holds parts, so the shell gives it a chevron. */
	branch?: boolean;
	/** The row names the owner of the rows under it. */
	owner?: boolean;
	count?: number;
}
const sections: { title: string; count: number; rows: Row[] }[] = [
	{
		title: "Modules",
		count: 18,
		rows: [
			{ name: "Storefront" },
			{ name: "Checkout API", branch: true },
			{ name: "Orders DB" },
			{ name: "Payment provider" },
			{ name: "Email provider" },
			{ name: "Basket cache" },
			{ name: "Warehouse system" },
			{ name: "Inventory service", branch: true },
		],
	},
	{
		title: "Flows",
		count: 2,
		rows: [
			{ name: "Inventory service", owner: true },
			{ name: "Reserve an order's items" },
			{ name: "Web shop", owner: true },
			{ name: "Place an order" },
		],
	},
	{
		title: "Walkthroughs",
		count: 2,
		rows: [
			{ name: "How stock is reserved", count: 6 },
			{ name: "How an order is placed today", count: 4 },
		],
	},
];
const selected = "Checkout API";
---

<aside class="navigator" aria-hidden="true">
	<div class="switcher">
		<span>example.invalid/web-shop</span>
		<Icon name="chevronDown" size={16} />
	</div>
	<div class="keys">
		<span class="key"><Icon name="history" size={15} /> History</span>
		<span class="key"><Icon name="chart" size={15} /> Measures</span>
	</div>
	<div class="well">
		{
			sections.map((section) => (
				<section class="section">
					<p class="head">
						<Icon name="chevronDown" size={15} />
						<span class="title">{section.title}</span>
						<span class="count">{section.count}</span>
					</p>
					<ul class="rows">
						{section.rows.map((row) => (
							<li class:list={["row", { "is-on": row.name === selected, owner: row.owner }]}>
								<span class="fold">{row.branch && <Icon name="chevronRight" size={15} />}</span>
								<span class="name">{row.name}</span>
								{row.count !== undefined && <span class="count">{row.count}</span>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
	<div class="working">
		<p class="working-head">Working now <span>1</span></p>
		<p class="working-row">
			<span class="dot"></span>
			<span class="working-name">Shop</span>
			<span class="mono when">now</span>
		</p>
		<p class="working-doing">mapping the shop</p>
	</div>
</aside>

<style>
	.navigator {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--chrome);
		padding-top: 8px;
		gap: 8px;
		font-size: 13px;
	}
	.switcher,
	.key {
		display: flex;
		align-items: center;
		height: 32px;
		border-radius: 4px;
		background: var(--well);
		box-shadow: var(--shadow-well);
		color: var(--ink);
	}
	.switcher {
		justify-content: space-between;
		margin: 0 8px;
		padding: 0 10px;
	}
	.keys {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin: 0 8px;
	}
	.key {
		justify-content: center;
		gap: 6px;
		font-weight: 600;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	.well {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		background: var(--well);
		box-shadow: var(--shadow-well);
		padding: 2px 4px;
	}
	.section + .section {
		margin-top: 8px;
	}
	.head,
	.row {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 8px;
	}
	.head {
		color: var(--ink-muted);
		gap: 9px;
	}
	.title {
		flex: 1;
	}
	.count {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink);
		padding: 0 5px;
		border-radius: 2px;
		background: var(--slab);
		box-shadow: 0 1px 0 oklch(0.215 0.006 75);
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.row {
		border-radius: 3px;
		color: var(--ink-body);
	}
	.row.owner {
		color: var(--ink-muted);
		font-size: 12px;
	}
	.row.is-on {
		background: var(--raised);
		color: var(--ink);
		box-shadow: var(--shadow-raised);
	}
	.fold {
		display: inline-flex;
		width: 15px;
		color: var(--ink-muted);
	}
	.name {
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* Working now stands in the shell only while an agent holds a claim. */
	.working {
		display: none;
		margin-top: -8px;
		padding: 12px 16px 4px 46px;
		font-size: 12.5px;
	}
	:global(.window[data-claimed]) .working {
		display: block;
	}
	.working-head {
		color: var(--ink-muted);
		margin-bottom: 8px;
	}
	.working-head span {
		margin-left: 4px;
		color: var(--ink);
	}
	.working-row {
		position: relative;
		display: flex;
		align-items: baseline;
		color: var(--ink);
	}
	.working-row .dot {
		position: absolute;
		left: -16px;
		top: 6px;
		width: 6px;
		height: 6px;
		color: var(--live);
	}
	.working-name {
		flex: 1;
		font-weight: 600;
	}
	.when {
		font-size: 11px;
		color: var(--ink-muted);
	}
	.working-doing {
		color: var(--ink-muted);
	}
</style>
