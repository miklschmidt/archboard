---
// The left column of the mock shell: the repository switcher, the keys of History and Measures,
// and one list with a section for modules, flows and walkthroughs. The rows and counts are the
// example shop's, as the shell lists them at its root with Checkout API selected.
import Icon from "../Icon.astro";

interface Row {
	name: string;
	/** The row holds parts, so the shell gives it a chevron. */
	branch?: boolean;
	/** The line names the collection of the rows under it: it is no row. */
	owner?: boolean;
	/** The row stands one step deeper, under the line of its collection. */
	child?: boolean;
	count?: number;
}
const sections: { title: string; count: number; rows: Row[] }[] = [
	{
		title: "Modules",
		count: 18,
		rows: [
			{ name: "Storefront" },
			{ name: "Checkout API", branch: true },
			{ name: "Orders DB" },
			{ name: "Payment provider" },
			{ name: "Email provider" },
			{ name: "Basket cache" },
			{ name: "Warehouse system" },
			{ name: "Inventory service", branch: true },
		],
	},
	{
		title: "Flows",
		count: 2,
		rows: [
			{ name: "Inventory service", owner: true },
			{ name: "Reserve an order's items", child: true },
			{ name: "Web shop", owner: true },
			{ name: "Place an order", child: true },
		],
	},
	{
		title: "Walkthroughs",
		count: 2,
		rows: [
			{ name: "How stock is reserved", count: 6 },
			{ name: "How an order is placed today", count: 4 },
		],
	},
];
const selected = "Checkout API";
---

<aside class="navigator" aria-hidden="true">
	<div class="switcher">
		<span class="repo">example.invalid/web-shop</span>
		<span class="dot claim-mark"></span>
		<Icon name="chevronDown" size={16} />
	</div>
	<div class="keys">
		<span class="key"><Icon name="history" size={15} /> History</span>
		<span class="key"><Icon name="chart" size={15} /> Measures</span>
	</div>
	<div class="well">
		{
			sections.map((section) => (
				<section class="section">
					<p class="head">
						<span class="title">{section.title}</span>
						<span class="mono total">{section.count}</span>
						<span class="end"><Icon name="chevronDown" size={15} /></span>
					</p>
					<ul class="rows">
						{section.rows.map((row) => (
							<li class:list={["row", { "is-on": row.name === selected, owner: row.owner, child: row.child }]}>
								<span class="fold">{row.branch && <Icon name="chevronRight" size={15} />}</span>
								<span class="name">{row.name}</span>
								{row.count !== undefined && <span class="count">{row.count}</span>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</aside>

<style>
	.navigator {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--chrome);
		padding-top: 8px;
		gap: 8px;
		font-size: 13px;
	}
	.switcher,
	.key {
		display: flex;
		align-items: center;
		height: 32px;
		border-radius: 4px;
		background: var(--well);
		box-shadow: var(--shadow-well);
		color: var(--ink);
	}
	.switcher {
		gap: 8px;
		margin: 0 8px;
		padding: 0 10px;
	}
	.repo {
		flex: 1;
	}
	/* While the agent claims the model, the switcher marks it with the lamp of Working now. */
	.claim-mark {
		width: 6px;
		height: 6px;
		color: var(--live);
		opacity: 0;
		transition: opacity 300ms var(--ease-out);
	}
	:global(.window[data-claimed]) .claim-mark {
		opacity: 1;
		animation: claimed 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}
	@keyframes claimed {
		50% {
			opacity: 0.5;
		}
	}
	.keys {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin: 0 8px;
	}
	.key {
		justify-content: center;
		gap: 6px;
		font-weight: 600;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	.well {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		/* The list lies on the chrome, as the right panel's lists do. */
		padding: 2px 4px;
	}
	.section + .section {
		margin-top: 8px;
	}
	.head,
	.row {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 8px;
	}
	/* A section's label stands at the column's inset in full ink, with its count beside it, and
	   the chevron that folds it at the end of the head, where the rows' facts end. */
	.head {
		gap: 6px;
		padding-right: 12px;
		font-size: 12.5px;
		font-weight: 600;
		color: var(--ink);
	}
	.total {
		font-size: 11px;
		font-weight: 400;
		color: var(--ink-muted);
	}
	.end {
		display: inline-flex;
		margin-left: auto;
		color: var(--ink-muted);
	}
	.count {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink);
		padding: 0 5px;
		border-radius: 2px;
		background: var(--slab);
		box-shadow: 0 1px 0 oklch(0.215 0.006 75);
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.row {
		border-radius: 3px;
		color: var(--ink-body);
	}
	/* The name of a collection is no row: it stands in full ink where a row's name stands, and
	   its flows stand one step deeper under a rail. */
	.row.owner {
		color: var(--ink);
		font-weight: 500;
	}
	.row.child {
		position: relative;
		padding-left: 24px;
	}
	.row.child::before {
		content: "";
		position: absolute;
		left: 15px;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--rule);
	}
	.row.is-on {
		background: var(--raised);
		color: var(--ink);
		box-shadow: var(--shadow-raised);
	}
	.fold {
		display: inline-flex;
		width: 15px;
		color: var(--ink-muted);
	}
	.name {
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
