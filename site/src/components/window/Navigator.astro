---
// The left column of the mock shell: the repository switcher, the keys of History and Measures,
// and one list with a section for modules, flows and walkthroughs. The rows and counts are the
// example shop's, as the shell lists them at its root with Checkout API selected.
import Icon from "../Icon.astro";
import SectionLabel from "./SectionLabel.astro";
import type { IconName } from "../../lib/icons";

interface Row {
	name: string;
	/** The row holds parts, so the shell gives it a chevron. */
	branch?: boolean;
	/** The row is an open collection of flows: a chevron, the icon of collections and its name. */
	owner?: boolean;
	/** The row stands one step deeper, under the rail that hangs from its collection's chevron. */
	child?: boolean;
	/** A count of the row's own: the steps of a walkthrough. */
	count?: number;
	/** How many flows a collection holds, in muted mono at the row's end. */
	total?: number;
}
const sections: { title: string; icon: IconName; count: number; rows: Row[] }[] = [
	{
		title: "Modules",
		icon: "box",
		count: 18,
		rows: [
			{ name: "Storefront" },
			{ name: "Checkout API", branch: true },
			{ name: "Orders DB" },
			{ name: "Payment provider" },
			{ name: "Email provider" },
			{ name: "Basket cache" },
			{ name: "Warehouse system" },
			{ name: "Inventory service", branch: true },
		],
	},
	{
		title: "Flows",
		icon: "route",
		count: 2,
		rows: [
			{ name: "Inventory service", owner: true, total: 1 },
			{ name: "Reserve an order's items", child: true },
			{ name: "Web shop", owner: true, total: 1 },
			{ name: "Place an order", child: true },
		],
	},
	{
		title: "Walkthroughs",
		icon: "playCircle",
		count: 2,
		rows: [
			{ name: "How stock is reserved", count: 6 },
			{ name: "How an order is placed today", count: 4 },
		],
	},
];
const selected = "Checkout API";
---

<aside class="navigator" aria-hidden="true">
	<div class="switcher">
		<span class="repo">example.invalid/web-shop</span>
		<span class="dot claim-mark"></span>
		<Icon name="chevronDown" size={16} />
	</div>
	<div class="keys">
		<span class="key"><Icon name="history" size={15} /> History</span>
		<span class="key"><Icon name="chart" size={15} /> Measures</span>
	</div>
	<div class="well">
		{
			sections.map((section) => (
				<section class="section">
					<p class="head">
						<SectionLabel icon={section.icon} title={section.title} count={section.count} />
						<span class="end"><Icon name="chevronDown" size={15} /></span>
					</p>
					<ul class="rows">
						{section.rows.map((row) => (
							<li class:list={["row", { "is-on": row.name === selected, owner: row.owner, child: row.child }]}>
								<span class="fold">
									{row.branch && <Icon name="chevronRight" size={15} />}
									{row.owner && <Icon name="chevronDown" size={15} />}
								</span>
								{row.owner && <Icon name="stack" size={14} class="kind" />}
								<span class="name">{row.name}</span>
								{row.count !== undefined && <span class="count">{row.count}</span>}
								{row.total !== undefined && <span class="total">{row.total}</span>}
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</aside>

<style>
	.navigator {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--chrome);
		padding-top: 8px;
		gap: 8px;
		font-size: 13px;
	}
	.switcher,
	.key {
		display: flex;
		align-items: center;
		height: 32px;
		border-radius: 4px;
		background: var(--well);
		box-shadow: var(--shadow-well);
		color: var(--ink);
	}
	.switcher {
		gap: 8px;
		margin: 0 8px;
		padding: 0 10px;
	}
	.repo {
		flex: 1;
	}
	/* While the agent claims the model, the switcher marks it with the lamp of Working now. */
	.claim-mark {
		width: 6px;
		height: 6px;
		color: var(--live);
		opacity: 0;
		transition: opacity 300ms var(--ease-out);
	}
	:global(.window[data-claimed]) .claim-mark {
		opacity: 1;
		animation: claimed 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}
	@keyframes claimed {
		50% {
			opacity: 0.5;
		}
	}
	.keys {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin: 0 8px;
	}
	.key {
		justify-content: center;
		gap: 6px;
		font-weight: 600;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	/* The list lies on the chrome, as the right panel's lists do, and scrolls under the agent's
	   card, as the shell's list does, with each section's head held at its top. */
	.well {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 0 4px 2px;
	}
	/* A section after the first opens with a rule across the column's inset, as a section of the
	   right panel does. */
	.section + .section {
		margin-top: 4px;
		padding-top: 4px;
		border-top: 1px solid var(--rule);
		margin-inline: 8px;
	}
	.section + .section .head,
	.section + .section .rows {
		margin-inline: -8px;
	}
	.head,
	.row {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 8px;
	}
	/* A section's label stands at the column's inset in full ink, with its count beside it, and
	   the chevron that folds it at the end of the head, where the rows' facts end. */
	.head {
		position: sticky;
		top: 0;
		z-index: 1;
		padding-right: 12px;
		font-size: 12.5px;
		background: var(--chrome);
	}
	.total {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-muted);
	}
	.end {
		display: inline-flex;
		margin-left: auto;
		color: var(--ink-muted);
	}
	.count {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink);
		padding: 0 5px;
		border-radius: 2px;
		background: var(--slab);
		box-shadow: 0 1px 0 oklch(0.215 0.006 75);
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.row {
		border-radius: 3px;
		color: var(--ink-body);
	}
	/* A collection is a row of the tree like an open module: its chevron, the icon of
	   collections and its name in full ink at weight 500. Its flows stand one step deeper under
	   the rail that hangs from its chevron, so the rail starts at a row and runs unbroken. */
	.row.owner .name {
		color: var(--ink);
		font-weight: 500;
	}
	.row :global(.kind) {
		flex-shrink: 0;
		color: var(--ink-muted);
	}
	/* A flow never holds rows, so it keeps no chevron slot: its words start where the ink of its
	   collection's icon starts, as the shell's tree sets a leaf. */
	.row.child {
		position: relative;
		padding-left: 30px;
	}
	.row.child .fold {
		display: none;
	}
	/* Each flow draws its stretch of the rail and a tick into itself, and the last flow draws the
	   rail only down to its tick, so the rail ends in a tick, as the shell's tree does. */
	.row.child::before,
	.row.child::after {
		content: "";
		position: absolute;
		left: 15px;
		background: var(--rule);
	}
	.row.child::before {
		top: 0;
		bottom: 0;
		width: 1px;
	}
	.row.child:not(:has(+ .child))::before {
		bottom: 14px;
	}
	.row.child::after {
		top: 14px;
		width: 8px;
		height: 1px;
	}
	.row.is-on {
		background: var(--raised);
		color: var(--ink);
		box-shadow: var(--shadow-raised);
	}
	.fold {
		display: inline-flex;
		width: 15px;
		color: var(--ink-muted);
	}
	.name {
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
