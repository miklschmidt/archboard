---
// A mock of the Archboard shell around the example shop, which the product's painter draws. The
// window is laid out at 1280 by 760 and scaled to its column, so it keeps the shell's proportions
// at any width. On a phone it shows only the canvas, so the drawing stays large enough to read.
// The renderer's SVG of the same picture stands under the painter's canvas, for a page without
// script, with reduced motion, or where the painter does not start.
import DockLines from "./DockLines.astro";
import Inspector from "./Inspector.astro";
import Navigator from "./Navigator.astro";
import Icon from "../Icon.astro";
import Mark from "../Mark.astro";
import { drawings } from "../../lib/diagrams";

const shop = drawings.webShop;
---

<div class="window-stage" data-window-stage>
	<div class="window-tilt" data-window-tilt>
		<div class="window" data-window>
			<div class="column-head">
				<Mark size={18} id="window-mark" />
				<span class="wordmark">archboard</span>
				<span class="tools">
					<Icon name="search" size={16} />
					<Icon name="bell" size={16} />
					<Icon name="settings" size={16} />
					<Icon name="sun" size={16} />
				</span>
			</div>
			<div class="pane-head">
				<span class="crumb">Shop</span>
				<span class="field reading">Current</span>
				<span class="field">No comparison <Icon name="chevronDown" size={15} /></span>
			</div>
			<div class="panel-head">
				<span class="views"><span class="is-on">Diagram</span><span>About</span></span>
				<Icon name="fullscreen" size={16} />
				<Icon name="add" size={16} />
			</div>
			<div class="left">
				<Navigator />
				<div class="dock-well">
					<div class="dock">
						<div class="working">
							<p class="working-head">Working now <span>1</span></p>
							<p class="working-row">
								<span class="dot"></span>
								<span class="working-name">Shop</span>
								<span class="mono when">now</span>
							</p>
							<p class="working-doing">mapping the shop</p>
						</div>
						<p class="dock-title"><Icon name="terminal" size={13} /> Agent</p>
						<DockLines />
					</div>
				</div>
			</div>
			<div class="picture" data-picture>
				<figure class="drawing" role="img" aria-label={`The example shop, drawn by Archboard: ${shop.label}`}>
					<img src={shop.url} width={shop.width} height={shop.height} alt="" decoding="async" />
				</figure>
				<canvas class="paint" aria-hidden="true"></canvas>
				<div class="claim">
					<div class="claim-head">
						<p class="claim-state">
							<span class="live"><span class="dot"></span> Claimed</span>
							<span class="mono since">since 14:02</span>
						</p>
						<span class="take"><Icon name="unlock" size={14} /> Take back control</span>
					</div>
					<dl class="claim-facts">
						<dt>State</dt><dd>Synchronous checkout</dd>
						<dt>Doing</dt><dd>mapping the shop</dd>
						<dt>Subjects</dt><dd>Shop (the whole model)</dd>
					</dl>
				</div>
				<button class="replay" type="button" data-replay hidden>
					<Icon name="back" size={15} /> Replay
				</button>
			</div>
			<Inspector />
		</div>
	</div>
</div>

<style>
	.window-stage {
		--scale: 1;
		--window-width: 1280px;
		--window-height: 760px;
		position: relative;
		width: 100%;
		height: calc(var(--window-height) * var(--scale));
		perspective: 2400px;
		perspective-origin: 50% 100%;
	}
	.window-tilt {
		--tilt: 0deg;
		height: 100%;
		transform-origin: 50% 100%;
		transform: rotateX(var(--tilt));
		will-change: transform;
	}
	.window {
		scale: var(--scale);
		transform-origin: 0 0;
		display: grid;
		grid-template-columns: 280px 1fr 360px;
		grid-template-rows: 44px 1fr;
		width: var(--window-width);
		height: var(--window-height);
		overflow: hidden;
		border-radius: 12px;
		background: var(--chrome);
		box-shadow:
			inset 0 1px 0 oklch(1 0.01 85 / 0.12),
			inset 0 0 0 1px var(--rule-strong),
			0 2px 0 oklch(0.06 0.004 75 / 0.6),
			0 40px 80px -24px oklch(0.03 0.004 75 / 0.85),
			0 100px 160px -40px oklch(0.03 0.004 75 / 0.9);
		color: var(--ink-body);
		font-family: var(--font-body);
	}
	.column-head,
	.pane-head,
	.panel-head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 16px;
		background: var(--chrome);
		font-size: 12.5px;
		position: relative;
		z-index: 1;
	}
	.column-head {
		gap: 9px;
		align-items: center;
	}
	.wordmark {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 560;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
		margin-top: 2px;
	}
	.tools {
		display: flex;
		gap: 14px;
		margin-left: auto;
		color: var(--ink);
	}
	.panel-head {
		justify-content: flex-end;
		gap: 16px;
		color: var(--ink);
	}
	.crumb {
		font-weight: 600;
		color: var(--ink);
		font-size: 13px;
	}
	.field,
	.views {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 10px;
		border-radius: 3px;
		font-size: 13px;
		color: var(--ink);
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	.reading {
		justify-content: center;
		width: 128px;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	.views {
		margin-right: auto;
		padding: 2px;
		gap: 0;
	}
	.views span {
		padding: 3px 10px;
		border-radius: 3px;
		color: var(--ink-muted);
	}
	.views .is-on {
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 -2px 0 var(--gold-mark);
	}
	/* The claim lies over the top of the picture while the agent holds it, as the shell shows it. */
	.claim {
		position: absolute;
		top: 12px;
		left: 50%;
		width: min(420px, calc(100% - 24px));
		transform: translateX(-50%);
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 16px;
		border-radius: 10px;
		background: var(--chrome);
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px color-mix(in oklch, var(--live) 40%, transparent);
		font-size: 12.5px;
		opacity: 0;
		translate: 0 -4px;
		transition:
			opacity 300ms var(--ease-out),
			translate 300ms var(--ease-out);
	}
	:global(.window[data-claimed]) .claim {
		opacity: 1;
		translate: 0 0;
	}
	.claim-state {
		display: flex;
		flex-direction: column;
		gap: 2px;
		flex-shrink: 0;
	}
	.claim-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.live {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-weight: 600;
		color: var(--ink);
	}
	.live .dot {
		color: var(--live);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--live) 25%, transparent);
	}
	.since {
		font-size: 11px;
		color: var(--ink-muted);
	}
	.claim-facts {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 2px 12px;
		margin: 0;
	}
	.claim-facts dt {
		color: var(--ink-muted);
	}
	.claim-facts dd {
		margin: 0;
		color: var(--ink);
		overflow-wrap: anywhere;
	}
	.take {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: auto;
		height: 28px;
		padding: 0 10px;
		flex-shrink: 0;
		border-radius: 4px;
		font-weight: 600;
		color: var(--gold-ink);
		background: linear-gradient(180deg, var(--gold-top), var(--gold-bottom));
		box-shadow:
			inset 0 1px 0 oklch(1 0.02 90 / 0.55),
			inset 0 0 0 1px var(--gold-edge);
	}
	.left {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: 1fr auto;
		min-height: 0;
		background: var(--chrome);
	}
	/* The well of the column runs on under the agent's card, which lies in it, as in the shell. */
	.dock-well {
		padding: 8px;
		background: var(--well);
	}
	.dock {
		display: flex;
		flex-direction: column;
		padding: 12px;
		height: 318px;
		border-radius: 12px;
		background: oklch(0.205 0.007 75);
		box-shadow:
			inset 0 1px 0 var(--highlight),
			0 -10px 24px -14px oklch(0.04 0.006 75 / 0.9);
		overflow: hidden;
	}
	/* While the agent holds its claim, Working now stands at the top of its card, as in the shell. */
	.working {
		display: none;
		padding-bottom: 14px;
		font-size: 12.5px;
	}
	:global(.window[data-claimed]) .working {
		display: block;
	}
	.working-head {
		color: var(--ink-muted);
		margin-bottom: 8px;
	}
	.working-head span {
		margin-left: 4px;
		color: var(--ink);
	}
	.working-row {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
	}
	.working-row .dot {
		width: 6px;
		height: 6px;
		color: var(--live);
	}
	.working-name {
		flex: 1;
		font-weight: 600;
	}
	.when {
		font-size: 11px;
		color: var(--ink-muted);
	}
	.working-doing {
		padding-left: 16px;
		color: var(--ink-muted);
	}
	.dock-title {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 10px;
		font-size: 11.5px;
		font-weight: 600;
		color: var(--ink);
	}
	/* The shell's chrome holds the picture on every side, with a strip under it, and the
	   picture's corners are rounded against it. */
	.picture {
		position: relative;
		margin-bottom: 8px;
		border-radius: 12px;
		display: grid;
		place-items: center;
		padding: 20px 16px;
		min-height: 0;
		overflow: hidden;
		background:
			radial-gradient(120% 80% at 50% 0%, oklch(0.23 0.012 80 / 0.6), transparent 60%),
			var(--plane);
	}
	.drawing {
		width: 100%;
	}
	.drawing img {
		display: block;
		width: 100%;
		height: auto;
	}
	/* While the painter draws the picture, its canvas covers the SVG. */
	.paint {
		display: none;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.picture[data-painting] .paint {
		display: block;
	}
	.picture[data-painting] .drawing img {
		visibility: hidden;
	}
	.dock :global(.dock-lines) {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		justify-content: flex-end;
	}
	.replay {
		position: absolute;
		right: 16px;
		bottom: 16px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 30px;
		padding: 0 12px;
		border: 0;
		border-radius: 4px;
		background: var(--raised);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		box-shadow:
			var(--shadow-float),
			inset 0 0 0 1px var(--rule);
		cursor: pointer;
		opacity: 0;
		transition: opacity 300ms var(--ease-out);
	}
	.replay.is-shown {
		opacity: 1;
	}
	.replay[hidden] {
		display: none;
	}
	.replay:hover {
		background: var(--slab);
	}
	@media (max-width: 760px) {
		.window-stage {
			--window-width: 760px;
			--window-height: 600px;
		}
		.window {
			grid-template-columns: minmax(0, 1fr);
		}
		.column-head,
		.panel-head,
		.left,
		.window > :global([data-inspector]) {
			display: none;
		}
	}
</style>

<script>
	import { mountHeroWindow } from "../../scripts/hero-window";
	mountHeroWindow();
</script>
