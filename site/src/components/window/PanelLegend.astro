---
// The last sections of the mock shell's right panel: the legend of a picture, as the shell shows
// it. The kinds of the parts, then the relationships: the lens select, bounded sub-groups for
// kinds, effects, and line marks that no reader hides, then the groups. A picture whose lines wear
// no kind, as a sequence's, has no relationships.
//
// By default it explains the shop's picture under its default lens. The shop's lines are all HTTP
// or storage, so the default lens hides none of them, and the shell shows no hidden-by-lens
// sub-group. A presented walkthrough's column shows the same legend, but it only explains
// (`explains`): no lens select, no eyes, and its group tags press nothing.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";
import SectionLabel from "./SectionLabel.astro";
import { kinds as looks, type Kind } from "../../lib/icons";

interface Picture {
	readonly kinds: readonly Kind[];
	/** Each kind of line, with its colour. */
	readonly lines: readonly (readonly [string, string])[];
	readonly marks: readonly (keyof typeof markNames)[];
}

const markNames = { emphasis: "More emphasis", traffic: "Illustrated traffic" } as const;

/** The legends the site mocks, each with what its picture draws, in the policy's order. */
const pictures = {
	shop: {
		kinds: ["service", "datastore", "cache", "external", "ui"],
		lines: [
			["HTTP", "var(--sky)"],
			["Storage", "var(--emerald)"],
		],
		marks: ["traffic"],
	},
	checkout: {
		kinds: ["service", "function", "route", "datastore", "cache", "external", "ui"],
		lines: [
			["HTTP", "var(--sky)"],
			["Storage", "var(--emerald)"],
			["Async", "var(--amber)"],
		],
		marks: ["emphasis", "traffic"],
	},
	sequence: {
		kinds: ["service", "function", "route", "datastore", "external", "ui"],
		lines: [],
		marks: [],
	},
} as const satisfies Record<string, Picture>;

interface Props {
	/** The picture the legend explains. */
	picture?: keyof typeof pictures;
	/** The legend only explains, as in a presented walkthrough: no lens and no eyes. */
	explains?: boolean;
}

const { picture = "shop", explains = false } = Astro.props;
const { kinds, lines, marks } = pictures[picture];
---

<div class="legend">
	<p class="head"><SectionLabel icon="shapes" title="Legend" /><span class="fold"><Icon name="chevronDown" size={16} /></span></p>
	<ul class="grid">
		{
			kinds.map((kind) => (
				<li>
					<KindChip kind={kind} size={24} look="panel" /> {looks[kind].name}
				</li>
			))
		}
	</ul>
	{
		lines.length > 0 && (
			<>
				<p class="head"><SectionLabel icon="share" title="Relationships" /><span class="fold"><Icon name="chevronDown" size={16} /></span></p>
				{!explains && (
					<div class="lens-select">
						<span class="lens-prefix">Lens</span>
						<span class="lens-value">Main lines</span>
						<Icon name="chevronDown" size={16} class="lens-chev" />
					</div>
				)}
				<div class="group">
					<p class="subhead">Kinds</p>
					<ul class="rows">
						{lines.map(([name, color]) => (
							<li>
								<span class="line" style={`--c: ${color}`} />
								{name}
								{!explains && <Icon name="eye" size={16} class="eye" />}
							</li>
						))}
					</ul>
				</div>
				<div class="group">
					<p class="subhead">Effects</p>
					<ul class="rows">
						<li>
							<svg class="sample" viewBox="0 0 36 28" aria-hidden="true">
								<path d="M1 14H17" class="stroke" />
								<path d="M17 6.5L32 14L17 21.5Z" class="fill" />
								<path d="M33.5 5V23" class="stroke" />
							</svg>
							Mutation
							{!explains && <Icon name="eye" size={16} class="eye" />}
						</li>
						<li>
							<svg class="sample" viewBox="0 0 36 28" aria-hidden="true">
								<circle cx="6" cy="14" r="4.2" class="stroke" />
								<path d="M11.3 14H18" class="stroke" />
								<path d="M18.3 14Q21.5 7.7 25.4 8.3L34 14L25.4 19.7Q21.5 20.3 18.3 14Z" class="stroke" />
								<circle cx="24.7" cy="14" r="1.4" class="fill" />
							</svg>
							Query
							{!explains && <Icon name="eye" size={16} class="eye" />}
						</li>
					</ul>
				</div>
				<div class="group">
					<p class="subhead">Line marks</p>
					<ul class="grid marks">
						{marks.map((mark) => (
							<li>
								<span class:list={["line", mark]} /> {markNames[mark]}
							</li>
						))}
					</ul>
				</div>
			</>
		)
	}
	<p class="head"><SectionLabel icon="priceTag" title="Groups" /><span class="fold"><Icon name="chevronDown" size={16} /></span></p>
	<p class="tags"><span class="tag payments">Payments</span><span class="tag fulfilment">Fulfilment</span></p>
</div>

<style>
	/* The legend has three sections, each under the label of any section of the panel. The lens
	   select opens the relationships as a quiet key, followed by bounded sub-groups for kinds,
	   effects and line marks. A row is 28px, with no plate under it. */
	.legend {
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: var(--ink);
	}
	/* Each part opens with a rule, as every section of the panel does. */
	.head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin: 0;
		min-height: 24px;
		padding-top: 14px;
		border-top: 1px solid var(--rule);
		font-size: 12.5px;
	}
	/* The chevron that folds a part stands at the end of its head, as in every section. */
	.fold {
		display: inline-flex;
		/* The ink of the chevron, not its box, ends where the rows' words and numbers end. */
		margin-right: -3.75px;
		color: var(--ink-muted);
	}
	.grid + .head,
	.group + .head,
	.tags + .head {
		margin-top: 8px;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 8px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.grid li,
	.rows li {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 28px;
		font-size: 13px;
	}
	.lens-select {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		margin: 2px 0 4px;
		padding: 0 6px 0 10px;
		border-radius: 4px;
		font-size: 13px;
		font-weight: 500;
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.lens-prefix {
		font-weight: 400;
		color: var(--ink-muted);
	}
	.lens-value {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.lens-select :global(.lens-chev) {
		color: var(--ink-muted);
		flex: none;
	}
	.group {
		display: flex;
		flex-direction: column;
	}
	.group + .group {
		margin-top: 6px;
		padding-top: 10px;
		border-top: 1px solid color-mix(in oklch, var(--rule) 65%, transparent);
	}
	.subhead {
		margin: 0 0 4px;
		font-size: 12px;
		line-height: 16px;
		font-weight: 500;
		color: var(--ink-muted);
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* The eye toggles visibility. Its ink aligns with the end of the panel's words. */
	.rows :global(.eye) {
		margin: 0 -0.75px 0 auto;
		color: var(--ink-muted);
	}
	.line {
		width: 24px;
		height: 2px;
		background: var(--c);
	}
	.emphasis {
		height: 4px;
		background: var(--neutral);
	}
	.traffic {
		height: 3px;
		border-radius: 2px;
		background: var(--neutral);
	}
	/* An effect's sample is the picture's own line in the neutral ink, with the head and the marks
	   that say the effect: a wedge and the imprint for a mutation, the caller's ring and an eye for
	   a query. */
	.sample {
		flex: none;
		width: 24px;
		height: 19px;
		overflow: visible;
		color: var(--neutral);
	}
	.sample .stroke {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sample .fill {
		fill: currentColor;
	}
	.tags {
		display: flex;
		gap: 8px;
		margin: 0;
	}
	.tag {
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 11px;
		font-weight: 600;
		color: var(--gold-ink);
	}
	.payments {
		background: var(--violet);
	}
	.fulfilment {
		background: var(--teal);
	}
</style>
