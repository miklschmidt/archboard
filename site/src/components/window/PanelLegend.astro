---
// The foot of the mock shell's right panel: the legend of the shop's picture and the picture's
// two settings, as the shell shows them.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";
import type { Kind } from "../../lib/icons";

const kinds: [Kind, string][] = [
	["service", "Service"],
	["datastore", "Data store"],
	["cache", "Cache"],
	["external", "External"],
	["ui", "User interface"],
];
const lines = [
	["HTTP", "var(--sky)"],
	["Data", "var(--emerald)"],
	["Illustrated traffic", "var(--neutral)"],
] as const;
const settings = [
	["Layout engine", "Blocks", "Tracks"],
	["Dim on hover", "On", "Off"],
] as const;
---

<div class="legend">
	<p class="head">Legend <span class="filter"><Icon name="filter" size={14} /> Filter</span></p>
	<ul class="grid">
		{
			kinds.map(([kind, name]) => (
				<li>
					<KindChip kind={kind} size={18} /> {name}
				</li>
			))
		}
	</ul>
	<ul class="grid lines">
		{
			lines.map(([name, color]) => (
				<li>
					<span class="line" style={`--c: ${color}`}></span> {name}
				</li>
			))
		}
	</ul>
	<p class="tags"><span class="tag payments">Payments</span><span class="tag fulfilment">Fulfilment</span></p>
</div>
{
	settings.map(([name, on, off]) => (
		<p class="setting">
			{name}
			<span class="toggle">
				<span class="is-on">{on}</span>
				<span>{off}</span>
			</span>
		</p>
	))
}

<style>
	.legend {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 14px 16px;
		background: var(--raised);
		color: var(--ink);
	}
	.head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 14px;
		font-weight: 600;
	}
	.filter {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 12px;
		background: var(--raised);
		box-shadow: var(--shadow-raised);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6px 12px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.grid li {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.line {
		width: 20px;
		height: 2px;
		background: var(--c);
	}
	.tags {
		display: flex;
		gap: 8px;
	}
	.tag {
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 11px;
		font-weight: 600;
		color: var(--gold-ink);
	}
	.payments {
		background: var(--violet);
	}
	.fulfilment {
		background: var(--teal);
	}
	.setting {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 8px 16px;
		color: var(--ink-muted);
	}
	.toggle {
		display: flex;
		padding: 2px;
		border-radius: 4px;
		background: var(--well);
		box-shadow: var(--shadow-well);
	}
	.toggle span {
		padding: 3px 10px;
		border-radius: 3px;
	}
	.toggle .is-on {
		color: var(--ink);
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 -2px 0 var(--gold-mark);
	}
</style>
