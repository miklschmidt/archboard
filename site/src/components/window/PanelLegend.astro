---
// The foot of the mock shell's right panel: the legend of the shop's picture, as the shell shows it.
import Icon from "../Icon.astro";
import KindChip from "../KindChip.astro";
import type { Kind } from "../../lib/icons";

const kinds: [Kind, string][] = [
	["service", "Service"],
	["datastore", "Data store"],
	["cache", "Cache"],
	["external", "External"],
	["ui", "User interface"],
];
const lines = [
	["HTTP", "var(--sky)"],
	["Data", "var(--emerald)"],
	["Illustrated traffic", "var(--neutral)"],
] as const;
---

<div class="legend">
	<p class="head">Legend <span class="filter"><Icon name="filter" size={12} /> Filter</span></p>
	<ul class="grid">
		{
			kinds.map(([kind, name]) => (
				<li>
					<KindChip kind={kind} size={20} /> {name}
				</li>
			))
		}
	</ul>
	<ul class="grid lines">
		{
			lines.map(([name, color]) => (
				<li>
					<span class="line" style={`--c: ${color}`}></span> {name}
				</li>
			))
		}
	</ul>
	<p class="tags"><span class="tag payments">Payments</span><span class="tag fulfilment">Fulfilment</span></p>
</div>

<style>
	/* The legend lies on the two columns of the foot over it, as the shell's does: the head is a
	   panel section head, its key stands at the start of the second column, and a row is 24px. */
	.legend {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px;
		color: var(--ink);
	}
	/* 8px part the head from its rows, and 12px part one list from the next. */
	.grid + .grid,
	.grid + .tags {
		margin-top: 4px;
	}
	.head {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 8px;
		align-items: center;
		min-height: 24px;
		font-size: 12.5px;
		font-weight: 600;
	}
	.filter {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 4px;
		height: 24px;
		padding: 0 8px;
		border-radius: 3px;
		font-size: 12px;
		background: var(--raised);
		box-shadow:
			var(--shadow-raised),
			inset 0 0 0 1px var(--rule);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 8px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.grid li {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 24px;
	}
	.line {
		width: 22px;
		height: 2px;
		background: var(--c);
	}
	.tags {
		display: flex;
		gap: 8px;
	}
	.tag {
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 11px;
		font-weight: 600;
		color: var(--gold-ink);
	}
	.payments {
		background: var(--violet);
	}
	.fulfilment {
		background: var(--teal);
	}
</style>
