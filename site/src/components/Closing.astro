---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { links } from "../lib/links";
---

<section class="closing" aria-labelledby="closing-title">
	<canvas class="field" data-closing-field aria-hidden="true"></canvas>
	<div class="container inner">
		<Mark size={72} id="closing-mark" />
		<h2 id="closing-title" class="display h2">Stop drawing boxes.</h2>
		<p class="lead">
			Plan every change with your agent before it builds. Hold the code to the map, and keep every
			drawing current.
		</p>
		<div class="actions">
			<a class="btn btn-gold" href="#quick-start">Get started <Icon name="arrowRight" /></a>
			<a class="btn btn-quiet" href={links.repository}><Icon name="github" /> View on GitHub</a>
		</div>
	</div>
</section>

<style>
	.closing {
		position: relative;
		margin-top: var(--section-space);
		padding: clamp(120px, 16vw, 220px) 0;
		overflow: hidden;
		isolation: isolate;
	}
	.field {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		opacity: 0;
		transition: opacity 1600ms var(--ease-out);
		mask-image: linear-gradient(180deg, transparent, black 30%, black 70%, transparent);
	}
	.field:global(.is-live) {
		opacity: 1;
	}
	.closing::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -2;
		background: radial-gradient(50% 50% at 50% 50%, oklch(0.25 0.035 82 / 0.5), transparent 70%);
	}
	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 28px;
		text-align: center;
	}
	.inner :global(.mark) {
		filter: drop-shadow(0 8px 30px oklch(0.72 0.13 75 / 0.45));
	}
	.h2 {
		font-size: clamp(3.2rem, 9vw, 6rem);
	}
	.lead {
		max-width: 32em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}
</style>

<script>
	import { lightField } from "../scripts/field";
	const canvas = document.querySelector<HTMLCanvasElement>("[data-closing-field]");
	if (canvas) lightField(canvas, { pitch: 0.95, lift: 2.2, traffic: 1.3, grid: true });
</script>
