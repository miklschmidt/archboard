{
	"task": "TASK-150",
	"adoptedOutsideUiBy": "TASK-151",
	"scope": ["packages/**", "apps/**", "scripts/**", "tools/**", "vite.config.ts"],
	"testsScope": ["tests/**", "packages/*/tests/**", "apps/*/tests/**"],
	"oxlint": "1.89.0",
	"tsgolint": "7.0.2004",
	"categories": ["correctness", "suspicious", "perf"],
	"nurseryRules": [
		"import/named",
		"import/export",
		"no-restricted-exports",
		"promise/no-return-in-finally",
		"typescript/no-unnecessary-condition",
		"no-unreachable-loop",
		"unicorn/no-useless-iterator-to-array",
		"typescript/prefer-optional-chain"
	],
	"complexity": 6,
	"maxPhysicalLines": 600,
	"localImportPrefix": "#",
	"jsdoc": {
		"package": "eslint-plugin-jsdoc",
		"version": "64.3.5",
		"preset": "flat/recommended-typescript",
		"additionalRule": "require-description",
		"severity": "error",
		"purpose": "Concise function-purpose, parameter and return descriptions; no duplicate TypeScript type annotations."
	},
	"vitePlus": "1.4.0"
}
