# Dependencies
node_modules/

# Build artifacts
dist/
public/dist/

# Environment files
.env

# Logs
*.log

# Editor artifacts
.cursor/
.agent/

# Development artifacts
*.excalidraw

.DS_Store

docs/*
# --- fork divergences from upstream ---
# Agent configuration read by the engineering skills is tracked.
!docs/agents/
# Committed architecture diagrams are a deliverable, not a build artifact.
!diagrams/*.excalidraw

# Agent skills are derived, not authored, so they stay untracked:
#   .agents/skills/  28 third-party skills pinned by skills-lock.json,
#                    plus excalidraw-skill synced from canonical skills/
#   .claude/skills/  symlinks into .agents/skills/
# Everything else under .claude/ and .agents/ (settings.json, commands/,
# agents/) is authored configuration and IS tracked.
.agents/skills/
.claude/skills/
