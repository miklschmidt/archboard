# Dependencies
# No trailing slash: each agent worktree symlinks node_modules rather than
# installing 506MB again, and a trailing slash does not match a symlink.
node_modules

# Build artifacts. Only the frontend is built: bun runs the server and the CLI
# straight from src/, so dist/ holds nothing but what vite put in dist/frontend
# (ADR 0014). A dist/ left over from before that holds compiled JS nothing reads.
dist/

# On-demand CLI contract views. The authored source is
# docs/design/cli-command-audit.json; these three render from it and the live
# command registry with `bun run generate:cli-contract`.
docs/design/generated/cli-command-audit.md
docs/design/generated/command-contract-proof.json
docs/design/generated/command-contract-proof.md

# Rendered semantic diagrams. The authored source is the board JSON under
# docs/design/ and the builder that draws it; the pictures render on demand, at
# any depth — the pipeline example draws one file per view per variant into its
# own directory.
docs/design/generated/**/*.svg
docs/design/generated/*.svg
# Bitmaps `semantic rasterize` draws from the same boards are derived too.
docs/design/generated/**/*.png
docs/design/generated/*.png

# Exact-version Codex app-server bindings are reproducible derived output.
src/shared/codex-app-server-contract/generated/

# The consumer skill's generated JSON Schemas and portable INSTALL.md copy.
# `bun install` and every install of the skill regenerate them from the Zod
# authorities (`bun run generate:skill-artifacts`); the authored skill is
# skills/archboard.
skills/archboard/references/generated/

# Environment files
.env

# Logs
*.log

# Editor artifacts
.cursor/
.agent/

.DS_Store

# --- archboard ---
# Third-party agent skills are installed, not authored, so they stay untracked:
# `skills experimental_install` puts the ones pinned by skills-lock.json in
# .agents/skills/ and links them from .claude/skills/. This repository's own
# skills are authored in skills/ and reached through the tracked symlinks below.
# Everything else under .claude/ and .agents/ (settings.json, commands/,
# agents/) is authored configuration and IS tracked.
/.agents/skills/*
!/.agents/skills/archboard
!/.agents/skills/archboard-dev
/.claude/skills/*
!/.claude/skills/archboard
!/.claude/skills/archboard-dev

# Agent worktrees, created per subagent run and removed after.
.claude/worktrees/

# Claude Code's per-person settings: the permission rules one operator
# granted on one machine. The shared .claude/settings.json stays tracked.
.claude/settings.local.json

# Impeccable's design comps, review captures and question-server state:
# exploration and evidence output that reproduces from the tool, not authored
# input.
/.impeccable/mocks/
/.impeccable/questions/
/.impeccable/review/

# TASK-150 local reference snapshot; never stage or import it.
/legacy/

# Skill evaluation output (TASK-209): fetched Flask checkouts, run traces,
# renders, boards, verdicts and reports. The canonical inputs are tracked under
# evals; everything here reproduces from them with
# `bun run eval:skill`.
.skill-evals/
