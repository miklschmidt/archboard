{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"]
	},
	"include": [
		"packages/*/src/ui/**/*.ts",
		"packages/*/src/ui/**/*.tsx",
		"apps/*/src/ui/**/*.ts",
		"apps/*/src/ui/**/*.tsx",
		"apps/*/src/main.tsx"
	],
	"exclude": ["node_modules", "dist"]
}
