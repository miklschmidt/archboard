{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"]
	},
	"include": [
		"frontend/**/*.ts",
		"frontend/**/*.tsx",
		"frontend/**/*.mts",
		"frontend/**/*.cts",
		"src/server/board-rendering/browser.ts",
		"src/ui/**/*.ts",
		"src/ui/**/*.tsx",
		"src/ui/**/*.mts",
		"src/ui/**/*.cts"
	],
	"exclude": ["node_modules", "dist", "src/ui/**/tests/**", "src/ui/**/*.test.ts"]
}
