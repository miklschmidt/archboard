			"stdout": "{\n  \"success\": false,\n  \"conflict\": {\n    \"board\": \"save-conflict\",\n    \"file\": \"/vault/save-conflict.excalidraw.md\",\n    \"reason\": \"changed\",\n    \"actualHash\": \"actual\",\n    \"versionMove\": \"ahead\",\n    \"outcomes\": {\n      \"reload\": \"browser show save-conflict --pane <spec> --reload\",\n      \"overwrite\": \"board save --force\",\n      \"saveAs\": \"board save --as save-conflict@from-canvas\"\n    },\n    \"message\": \"Refusing fixed-base board save. Nothing was written.\"\n  },\n  \"held\": {\n    \"board\": \"save-conflict\",\n    \"message\": \"held board diagnostic\",\n    \"writes\": 0\n  }\n}\n",
			"stderr": "Refusing fixed-base board save. Nothing was written.\nheld board diagnostic\n\"save-conflict\" has stopped saving. Changes from here are held on the canvas and reach no note until one of those three is run.\n",
