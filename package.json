{
  "name": "archboard",
  "version": "0.1.0",
  "private": true,
  "description": "Internal architecture canvas: a live Excalidraw board that agents and humans build, explore, and refactor code and infrastructure architecture on together.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "archboard": "dist/bin.js"
  },
  "scripts": {
    "start": "bun run build:server && node dist/index.js",
    "cli": "node dist/bin.js",
    "canvas": "bun run build:server && node dist/server.js",
    "build": "bun run build:frontend && bun run build:server",
    "build:frontend": "bunx vite build",
    "build:server": "bunx tsc",
    "build:types": "bunx tsc --emitDeclarationOnly",
    "dev": "bunx concurrently \"bun run dev:server\" \"bunx vite\"",
    "dev:server": "bunx tsc --watch",
    "production": "bun run build && bun run canvas",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test": "bun run test:mcp && bun run test:bind",
    "test:bind": "bun run build:server && node scripts/check-local-bind.mjs",
    "test:mcp": "bun run build:server && node scripts/check-mcp-stdio.mjs",
    "type-check": "bunx tsc --noEmit && bunx tsc --noEmit -p tsconfig.frontend.json"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^1.1.3",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mermaid": "^11.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.6.0",
    "backlog.md": "^1.50.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "author": {
    "name": "Mikkel Schmidt",
    "email": "mikkel.schmidt@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/miklschmidt/archboard.git"
  },
  "homepage": "https://github.com/miklschmidt/archboard#readme",
  "bugs": {
    "url": "https://github.com/miklschmidt/archboard/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
