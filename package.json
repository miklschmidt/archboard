{
	"name": "archboard",
	"version": "0.1.0",
	"private": true,
	"description": "Internal architecture canvas: a live Excalidraw board that agents and humans build, explore, and refactor code and infrastructure architecture on together.",
	"homepage": "https://github.com/miklschmidt/archboard#readme",
	"bugs": {
		"url": "https://github.com/miklschmidt/archboard/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Mikkel Schmidt",
		"email": "mikkel.schmidt@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/miklschmidt/archboard.git"
	},
	"bin": {
		"archboard": "bin/canvas"
	},
	"type": "module",
	"scripts": {
		"start": "bun src/bin.ts",
		"cli": "bun src/bin.ts",
		"canvas": "bun src/server.ts",
		"build": "bun run build:frontend",
		"build:frontend": "bunx vite build",
		"dev": "bunx concurrently \"bun run dev:canvas\" \"bunx vite\"",
		"dev:canvas": "bun --hot src/dev-canvas.ts",
		"production": "bun run build && bun run canvas",
		"sync:skills": "bun scripts/sync-skills.mjs",
		"lint": "bun run lint:skills && bun run lint:code",
		"lint:skills": "bun scripts/check-skills.mjs --self-test && bun scripts/check-skills.mjs",
		"lint:code": "oxlint .",
		"fix": "bun run lint:skills && oxlint --fix . && bun run fmt && bun run lint:skills",
		"fmt": "oxfmt . '!dist/**' '!node_modules/**' '!backlog/**'",
		"fmt:check": "oxfmt --check . '!dist/**' '!node_modules/**' '!backlog/**'",
		"check": "bun run lint && bun run fmt:check && bun run test",
		"test": "bun run type-check && bun run test:suites && bun run test:boundaries && bun run test:module-scope && bun run test:contracts && bun run test:inspection && bun run test:cli && bun run test:bind && bun run test:obsidian && bun run test:changes && bun run test:reporting && bun run test:one-write && bun run test:lock && bun run test:doing && bun run test:geometry && bun run test:text && bun run test:labels && bun run test:library && bun run test:boards && bun run test:branch && bun run test:side-by-side && bun run test:install && bun run test:repos && bun run test:staleness && bun run test:hot && bun run test:version && bun run test:human-performance && bun run test:browser && bun run test:typing && bun run test:live-session",
		"type-check": "bunx tsc --noEmit && bunx tsc --noEmit -p tsconfig.frontend.json",
		"test:suites": "bun scripts/check-ci-suites.mjs",
		"test:boundaries": "bun scripts/check-boundary-plugin.mjs",
		"test:bind": "bun scripts/check-local-bind.mjs",
		"test:obsidian": "bun scripts/check-obsidian-md.mjs",
		"test:cli": "bun scripts/check-cli-surface.mjs",
		"test:changes": "bun scripts/check-changes.mjs",
		"test:reporting": "bun scripts/check-change-reporting.mjs",
		"test:one-write": "bun scripts/check-one-write.mjs",
		"test:lock": "bun scripts/check-lock.mjs",
		"test:doing": "bun scripts/check-doing.mjs",
		"test:version": "bun scripts/check-version.mjs",
		"test:geometry": "bun scripts/check-geometry.mjs",
		"test:text": "bun scripts/check-text-metrics.mjs",
		"test:labels": "bun scripts/check-labels.mjs",
		"test:library": "bun scripts/check-library.mjs",
		"test:boards": "bun scripts/check-boards.mjs",
		"test:branch": "bun scripts/check-branch-compare.mjs",
		"test:side-by-side": "bun scripts/check-side-by-side.mjs",
		"test:install": "bun scripts/check-install-doc.mjs",
		"test:repos": "bun scripts/check-repos.mjs",
		"test:module-scope": "bun scripts/check-module-scope.mjs && bun scripts/check-module-scope.mjs --self-test",
		"test:contracts": "bun test src/cli/command-contract/tests && bun scripts/generate-cli-contract.mjs --check && bun scripts/check-command-contract.mjs",
		"test:inspection": "bun scripts/check-board-inspection.mjs",
		"test:staleness": "bun scripts/check-staleness.mjs",
		"test:hot": "bun scripts/check-hot-reload.mjs",
		"test:human-performance": "bun scripts/check-human-edit-performance.mjs",
		"test:browser": "bun scripts/check-fixed-point.mjs",
		"test:typing": "bun scripts/check-typed-text.mjs",
		"test:live-session": "bun scripts/check-live-session.mjs",
		"reload": "bun scripts/reload.mjs"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "0.18.1",
		"@excalidraw/mermaid-to-excalidraw": "2.2.2",
		"commander": "15.0.0",
		"cors": "2.8.6",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"fractional-indexing": "4.0.0",
		"mermaid": "11.17.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"winston": "3.19.0",
		"ws": "8.21.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/node": "26.3.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "6.1.0",
		"backlog.md": "1.50.1",
		"concurrently": "10.0.5",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vite": "8.2.2"
	},
	"engines": {
		"bun": ">=1.2.0"
	}
}
