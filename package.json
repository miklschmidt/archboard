{
	"name": "archboard",
	"version": "0.1.0",
	"private": true,
	"description": "Internal architecture canvas: a live Excalidraw board that agents and humans build, explore, and refactor code and infrastructure architecture on together.",
	"homepage": "https://github.com/miklschmidt/archboard#readme",
	"bugs": {
		"url": "https://github.com/miklschmidt/archboard/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Mikkel Schmidt",
		"email": "mikkel.schmidt@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/miklschmidt/archboard.git"
	},
	"bin": {
		"archboard": "bin/canvas"
	},
	"type": "module",
	"scripts": {
		"start": "bun src/bin.ts",
		"cli": "bun src/bin.ts",
		"canvas": "bun src/server.ts",
		"build": "bun run build:frontend",
		"build:frontend": "bunx vite build",
		"dev": "bunx concurrently \"bun run canvas\" \"bun run dev:frontend\"",
		"dev:frontend": "bunx vite",
		"production": "bun run build && bun run canvas",
		"postinstall": "bun run generate:codex-contract",
		"sync:skills": "bun scripts/sync-skills.ts",
		"lint": "bun run ensure:codex-contract && bun run lint:repository && bun run lint:ui",
		"fix": "bun scripts/lint.ts --disable-nested-config --fix . && bun scripts/lint.ts --type-aware --threads 1 --fix --config src/ui/.oxlintrc.jsonc src/ui && bun run lint && bun run fmt && bun test tests/system/repository-policy/skills.test.ts",
		"fmt": "oxfmt . '!dist/**' '!node_modules/**' '!backlog/**' '!src/shared/codex-app-server-contract/generated/**'",
		"fmt:check": "oxfmt --check . '!dist/**' '!node_modules/**' '!backlog/**' '!src/shared/codex-app-server-contract/generated/**'",
		"check": "bun run lint && bun run fmt:check && bun run test",
		"test": "bun run ensure:codex-contract && bun run type-check && bun run build:frontend && bun run test:modules && bun run test:system && bun run test:repository && bun run test:serial-browser",
		"type-check": "bun run ensure:codex-contract && (root_typecheck_status=0; bunx tsc --noEmit || root_typecheck_status=$?; frontend_typecheck_status=0; bunx tsc --noEmit -p tsconfig.frontend.json || frontend_typecheck_status=$?; [ \"$root_typecheck_status\" -eq 0 ] && [ \"$frontend_typecheck_status\" -eq 0 ])",
		"test:modules": "bun test --isolate --path-ignore-patterns src/runtime/board-inspection/tests/comparison-limits.test.ts --path-ignore-patterns src/runtime/board-inspection/tests/input-limits.test.ts --path-ignore-patterns src/runtime/board-inspection/tests/large-input-indexes-capacity.test.ts --path-ignore-patterns src/runtime/board-inspection/tests/sweep-filtering-capacity.test.ts --path-ignore-patterns src/runtime/board-inspection/tests/sweep-partial-complement-capacity.test.ts --path-ignore-patterns src/runtime/codex-dynamic-tools/tests/wire-capacity.test.ts --path-ignore-patterns src/runtime/codex-transport/tests/write-capacity.test.ts --path-ignore-patterns src/server/board-rendering/tests/fixture.test.ts --path-ignore-patterns src/server/board-rendering/tests/owner.test.ts --path-ignore-patterns src/shared/codex-app-server-capacity/tests/capacity.test.ts src",
		"test:system": "bun test --isolate --max-concurrency=1 --path-ignore-patterns tests/system/board-inspection/package-read-only.test.ts --path-ignore-patterns tests/system/process-contracts/git-opener-sequence-watchdog.test.ts --path-ignore-patterns tests/system/process-contracts/cross-process-lock.test.ts tests/system/boards tests/system/label-geometry tests/system/cli tests/system/board-inspection tests/system/canvas-state tests/system/process-contracts tests/system/code-targets",
		"test:repository": "bun test --isolate tests/system/repository-policy",
		"test:serial-browser": "bun tests/system/browser/run-browser-lane.ts tests/system/browser/fixed-point-document.test.ts tests/system/browser/malformed-geometry-recovery.test.ts tests/system/browser/pane-telemetry-recovery.test.ts tests/system/browser/arrow-binding-differential.test.ts tests/system/browser/shell-layout.test.ts tests/system/browser/board-navigator.test.ts tests/system/browser/board-drill-down.test.ts tests/system/browser/fullscreen-presentation.test.ts tests/system/browser/typed-text.test.ts tests/system/browser/server-update-ordering.test.ts tests/system/browser/hold-generation.test.ts tests/system/browser/human-hold-persistence.test.ts tests/system/browser/claim-interaction.test.ts tests/system/browser/human-version-refusal.test.ts tests/system/browser/selection-inspector.test.ts tests/system/browser/connected-path-focus.test.ts tests/system/browser/opener-settings.test.ts tests/system/browser/code-target-activation.test.ts tests/system/browser/codex-text-workbench.test.ts tests/system/browser/codex-live-voice.test.ts",
		"test:opt-in:capacity": "bun test --isolate src/runtime/board-inspection/tests/comparison-limits.test.ts src/runtime/board-inspection/tests/input-limits.test.ts src/runtime/board-inspection/tests/large-input-indexes-capacity.test.ts src/runtime/board-inspection/tests/sweep-filtering-capacity.test.ts src/runtime/board-inspection/tests/sweep-partial-complement-capacity.test.ts src/runtime/codex-dynamic-tools/tests/wire-capacity.test.ts src/runtime/codex-transport/tests/write-capacity.test.ts src/shared/codex-app-server-capacity/tests/capacity.test.ts",
		"test:opt-in:tooling": "bun test --isolate --max-concurrency=1 src/server/board-rendering/tests/fixture.test.ts src/server/board-rendering/tests/owner.test.ts tests/system/support/observed-pane.test.ts tests/system/support/owned-canvas-forced-cleanup.test.ts tests/system/support/owned-canvas-process-group.test.ts tests/system/support/owned-canvas-term-escalation.test.ts tests/system/support/owned-canvas.test.ts tests/system/board-inspection/package-read-only.test.ts tests/system/process-contracts/git-opener-sequence-watchdog.test.ts",
		"test:opt-in:topology": "bun test --isolate --max-concurrency=1 tests/system/process-contracts/cross-process-lock.test.ts",
		"test:opt-in:browser-performance": "bun tests/system/browser/run-browser-lane.ts --opt-in tests/system/browser/human-edit-performance.test.ts tests/system/browser/live-session-convergence.test.ts",
		"opt-in:renderer-chromium": "bun scripts/probe-server-rendering-chromium.ts",
		"opt-in:renderer-emulation": "bun scripts/probe-server-rendering-emulation.ts",
		"generate:codex-contract": "bun scripts/generate-codex-app-server-contract.ts",
		"ensure:codex-contract": "bun scripts/generate-codex-app-server-contract.ts --ensure",
		"generate:cli-contract": "bun scripts/generate-cli-contract.ts",
		"generate:wordmark": "bun scripts/generate-wordmark.ts",
		"shadcn": "shadcn",
		"lint:repository": "bun scripts/lint.ts --disable-nested-config .",
		"lint:ui": "bun scripts/lint.ts --type-aware --threads 1 --deny-warnings --max-warnings 0 --report-unused-disable-directives-severity error --config src/ui/.oxlintrc.jsonc src/ui"
	},
	"dependencies": {
		"@assistant-ui/react": "0.15.17",
		"@assistant-ui/react-markdown": "0.14.14",
		"@base-ui/react": "1.7.0",
		"@excalidraw/excalidraw": "0.18.1",
		"@excalidraw/mermaid-to-excalidraw": "2.2.2",
		"@openai/codex": "0.151.0",
		"@remixicon/react": "4.9.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cn": "0.2.5",
		"commander": "15.0.0",
		"cors": "2.8.6",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"fractional-indexing": "4.0.0",
		"mermaid": "11.17.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"winston": "3.19.0",
		"ws": "8.21.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@babel/parser": "7.29.8",
		"@babel/types": "7.29.8",
		"@happy-dom/global-registrator": "20.14.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/bun": "1.4.0",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/node": "26.3.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "6.1.0",
		"backlog.md": "1.50.1",
		"concurrently": "10.0.5",
		"eslint-plugin-jsdoc": "64.3.5",
		"happy-dom": "20.14.0",
		"opentype.js": "1.3.4",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"shadcn": "4.21.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"@excalidraw/excalidraw@0.18.1": "patches/@excalidraw%2Fexcalidraw@0.18.1.patch",
		"@radix-ui/react-select@2.3.7": "patches/@radix-ui%2Freact-select@2.3.7.patch"
	}
}
