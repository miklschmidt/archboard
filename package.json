{
	"name": "archboard",
	"version": "0.1.0",
	"private": true,
	"description": "Architecture planning tool for architects who work with coding agents: an agent states what an architecture is, the server draws it, and a person reads, compares and presents it.",
	"homepage": "https://github.com/miklschmidt/archboard#readme",
	"bugs": {
		"url": "https://github.com/miklschmidt/archboard/issues"
	},
	"license": "BUSL-1.1",
	"author": {
		"name": "Mikkel Schmidt",
		"email": "mikkel.schmidt@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/miklschmidt/archboard.git"
	},
	"bin": {
		"archboard": "bin/archboard"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"type": "module",
	"scripts": {
		"server": "bun apps/server/src/server.ts",
		"build": "vp run frontend",
		"build:core": "vp run core",
		"dev": "vp run core && concurrently --kill-others --names server,web \"bun run server\" \"vp dev\"",
		"postinstall": "bun run generate:codex-contract && bun run generate:skill-artifacts",
		"lint": "vp run lint:all",
		"fix": "vp run fix:all",
		"fmt": "vp fmt --config vite.config.ts && cargo fmt --all",
		"fmt:check": "vp run format:check",
		"check": "vp run check:all",
		"test": "vp run test:all",
		"benchmark": "vp run benchmark:all",
		"type-check": "vp run types",
		"generate:codex-contract": "bun scripts/generate-codex-app-server-contract.ts",
		"ensure:codex-contract": "bun scripts/generate-codex-app-server-contract.ts --ensure",
		"generate:cli-contract": "bun apps/cli/src/cli/operations/contract-artifacts/generate.ts",
		"generate:skill-artifacts": "bun scripts/generate-skill-artifacts.ts",
		"shadcn": "shadcn",
		"eval:skill": "bun scripts/evaluate-skill.ts",
		"readme:assets": "bun scripts/readme-assets/make.ts",
		"readme:check": "bun scripts/readme-assets/check.ts",
		"example:workbench:build": "vp run workbench-example",
		"pack:voice": "vp run voice-package"
	},
	"dependencies": {
		"@archboard/elk-rs": "0.11.3",
		"@assistant-ui/react": "0.15.17",
		"@assistant-ui/react-markdown": "0.14.14",
		"@base-ui/react": "1.7.0",
		"@chenglou/pretext": "0.0.9",
		"@lumis-sh/wasm-nix": "0.26.3",
		"@lumis-sh/wasm-swift": "0.26.3",
		"@napi-rs/canvas": "1.0.9",
		"@openai/codex": "0.160.0",
		"@remixicon/react": "4.9.0",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-router": "1.170.33",
		"@teddyzhu/clipboard": "0.0.10",
		"@tree-sitter-grammars/tree-sitter-hcl": "1.2.0",
		"@viz-js/viz": "3.30.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cn": "0.2.5",
		"commander": "15.0.0",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"idb-keyval": "6.3.0",
		"libavoid-js": "0.5.0-beta.5",
		"lightningcss": "1.33.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-resizable-panels": "4.14.2",
		"remark-gfm": "4.0.1",
		"shell-quote": "1.9.0",
		"tailwind-merge": "3.6.0",
		"tree-sitter-c": "0.24.1",
		"tree-sitter-c-sharp": "0.23.5",
		"tree-sitter-cpp": "0.23.4",
		"tree-sitter-objc": "3.0.2",
		"tree-sitter-python": "0.25.0",
		"tree-sitter-typescript": "0.23.2",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"web-tree-sitter": "0.27.0",
		"winston": "3.19.0",
		"ws": "8.21.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@babel/parser": "7.29.8",
		"@babel/types": "7.29.8",
		"@happy-dom/global-registrator": "20.14.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/bun": "1.4.0",
		"@types/express": "5.0.6",
		"@types/node": "26.3.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "6.1.0",
		"agent-browser": "0.31.1",
		"ajv": "^8",
		"apca-w3": "0.1.9",
		"axe-core": "4.14.0",
		"backlog.md": "1.50.1",
		"concurrently": "10.0.5",
		"eslint-plugin-jsdoc": "64.3.5",
		"happy-dom": "20.14.0",
		"shadcn": "4.21.0",
		"tailwindcss": "4.3.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	},
	"engines": {
		"bun": ">=1.4.3",
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"packageManager": "bun@1.4.3",
	"patchedDependencies": {
		"@radix-ui/react-select@2.3.7": "patches/@radix-ui%2Freact-select@2.3.7.patch",
		"libavoid-js@0.5.0-beta.5": "patches/libavoid-js@0.5.0-beta.5.patch"
	}
}
