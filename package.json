{
  "name": "archboard",
  "version": "0.1.0",
  "private": true,
  "description": "Internal architecture canvas: a live Excalidraw board that agents and humans build, explore, and refactor code and infrastructure architecture on together.",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "archboard": "bin/canvas"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "cli": "bun src/bin.ts",
    "canvas": "bun src/server.ts",
    "build": "bun run build:frontend",
    "build:frontend": "bunx vite build",
    "dev": "bunx concurrently \"bun run dev:canvas\" \"bunx vite\"",
    "dev:canvas": "bun --hot src/dev-canvas.ts",
    "production": "bun run build && bun run canvas",
    "sync:skills": "bun scripts/sync-skills.mjs",
    "test": "bun run type-check && bun run test:module-scope && bun run test:mcp && bun run test:bind && bun run test:obsidian && bun run test:changes && bun run test:geometry && bun run test:labels && bun run test:library && bun run test:boards && bun run test:branch && bun run test:side-by-side && bun run test:install && bun run test:repos && bun run test:parity && bun run test:hot",
    "type-check": "bunx tsc --noEmit && bunx tsc --noEmit -p tsconfig.frontend.json",
    "test:bind": "bun scripts/check-local-bind.mjs",
    "test:obsidian": "bun scripts/check-obsidian-md.mjs",
    "test:mcp": "bun scripts/check-mcp-stdio.mjs",
    "test:changes": "bun scripts/check-changes.mjs",
    "test:geometry": "bun scripts/check-geometry.mjs",
    "test:labels": "bun scripts/check-labels.mjs",
    "test:library": "bun scripts/check-library.mjs",
    "test:boards": "bun scripts/check-boards.mjs",
    "test:branch": "bun scripts/check-branch-compare.mjs",
    "test:side-by-side": "bun scripts/check-side-by-side.mjs",
    "test:install": "bun scripts/check-install-doc.mjs",
    "test:repos": "bun scripts/check-repos.mjs",
    "test:parity": "bun scripts/check-surface-parity.mjs",
    "test:module-scope": "bun scripts/check-module-scope.mjs && bun scripts/check-module-scope.mjs --self-test",
    "test:hot": "bun scripts/check-hot-reload.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^1.1.3",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mermaid": "^11.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.6.0",
    "backlog.md": "^1.50.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "author": {
    "name": "Mikkel Schmidt",
    "email": "mikkel.schmidt@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/miklschmidt/archboard.git"
  },
  "homepage": "https://github.com/miklschmidt/archboard#readme",
  "bugs": {
    "url": "https://github.com/miklschmidt/archboard/issues"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
