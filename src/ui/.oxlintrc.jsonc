// TASK-150: approved UI policy. TASK-151 owns adoption outside src/ui.
// jsdoc-extra supplies only rules absent from Oxlint; these rules check TypeScript too.
{
	"$schema": "../../node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"react",
		"react-perf",
		"import",
		"jsdoc",
		"jsx-a11y",
		"promise",
	],
	"jsPlugins": [
		"../../tools/oxlint-plugin-archboard.js",
		{
			"name": "jsdoc-extra",
			"specifier": "eslint-plugin-jsdoc",
		},
	],
	"env": {
		"browser": true,
		"node": true,
		"es2023": true,
	},
	"globals": {
		"Bun": "readonly",
	},
	"settings": {
		"react": {
			"version": "19.2.8",
		},
	},
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"pedantic": "off",
		"style": "off",
		"restriction": "off",
		"nursery": "off",
	},
	"rules": {
		"archboard/no-anonymous-jsx-handlers": "error",
		"archboard/assistant-ui-imports": "error",
		"archboard/no-catch-all-exports": "error",
		"archboard/no-compatibility-identifiers": "error",
		"archboard/no-generic-buckets": "error",
		"archboard/mapped-source-paths": "error",
		"archboard/import-boundaries": "error",
		"archboard/module-entrypoints": "error",
		"archboard/root-implementation-modules": "error",
		"archboard/state-files-pure": "error",
		"archboard/no-archive-references": "error",
		"archboard/absolute-imports": "error",
		"complexity": [
			"error",
			{
				"max": 6,
				"variant": "classic",
			},
		],
		"max-lines": [
			"error",
			{
				"max": 600,
				"skipBlankLines": false,
				"skipComments": false,
			},
		],
		"import/named": "error",
		"import/export": "error",
		"no-restricted-exports": [
			"error",
			{
				"restrictDefaultExports": {
					"defaultFrom": true,
					"direct": true,
					"named": true,
					"namedFrom": true,
					"namespaceFrom": true,
				},
			},
		],
		"promise/no-return-in-finally": "error",
		"typescript/no-unnecessary-condition": "error",
		"no-unreachable-loop": "error",
		"unicorn/no-useless-iterator-to-array": "error",
		"typescript/prefer-optional-chain": "error",
		"jsdoc/check-access": "error",
		"jsdoc/check-property-names": "error",
		"jsdoc/check-tag-names": [
			"error",
			{
				"typed": true,
			},
		],
		"jsdoc/empty-tags": "error",
		"jsdoc/implements-on-classes": "error",
		"jsdoc/no-blank-blocks": "off",
		"jsdoc/no-defaults": "error",
		"jsdoc/require-param": "error",
		"jsdoc/require-param-description": "error",
		"jsdoc/require-param-name": "error",
		"jsdoc/require-param-type": "off",
		"jsdoc/require-property": "error",
		"jsdoc/require-property-description": "error",
		"jsdoc/require-property-name": "error",
		"jsdoc/require-property-type": "off",
		"jsdoc/require-returns": "error",
		"jsdoc/require-returns-description": "error",
		"jsdoc/require-returns-type": "off",
		"jsdoc/require-throws-description": "off",
		"jsdoc/require-throws-type": "error",
		"jsdoc/require-yields": "error",
		"jsdoc/require-yields-description": "off",
		"jsdoc/require-yields-type": "error",
		"archboard/typescript-source": "error",
		"react/react-in-jsx-scope": "off",
		"jsdoc-extra/check-alignment": "error",
		"jsdoc-extra/check-param-names": "error",
		"jsdoc-extra/check-types": "error",
		"jsdoc-extra/check-values": "error",
		"jsdoc-extra/escape-inline-tags": "error",
		"jsdoc-extra/multiline-blocks": "error",
		"jsdoc-extra/no-multi-asterisks": "error",
		"jsdoc-extra/no-types": "error",
		"jsdoc-extra/reject-any-type": "error",
		"jsdoc-extra/reject-function-type": "error",
		"jsdoc-extra/require-description": "error",
		"jsdoc-extra/require-jsdoc": [
			"error",
			{
				"require": {
					"FunctionDeclaration": true,
					"ArrowFunctionExpression": true,
					"FunctionExpression": true,
					"MethodDefinition": true,
				},
			},
		],
		"jsdoc-extra/require-next-type": "error",
		"jsdoc-extra/require-returns-check": "error",
		"jsdoc-extra/require-yields-check": "error",
		"jsdoc-extra/tag-lines": "error",
		"jsdoc-extra/ts-no-empty-object-type": "error",
		"jsdoc-extra/valid-types": "error",
	},
}
