		},
		{
			"id": "9G6CmNgt",
			"order": 10000,
			"name": "Codex workbench",
			"kind": "service",
			"responsibility": "Owns the private Codex child and bridges it to the panes"
		},
		{
			"id": "mTtiV3hX",
			"order": 11000,
			"name": "Agent CLI",
			"kind": "service",
			"responsibility": "Sends every board operation over HTTP and never writes a vault file itself"
		},
		{
			"id": "Eh7icS73",
			"order": 12000,
			"name": "Browser",
			"kind": "service",
			"responsibility": "Reads boards, says what each pane is showing, and writes nothing"
		},
		{
			"id": "8B8O9ZiT",
			"order": 13000,
			"name": "Board write routes",
			"kind": "route",
			"responsibility": "The one write boundary: every route that changes a board goes through here",
			"groups": ["writes"]
		},
		{
			"id": "Ck9cBsJC",
			"order": 14000,
			"name": "Claim routes",
			"kind": "route",
			"responsibility": "An agent's claim on a board, its release, and the person's override",
			"groups": ["writes"]
		},
		{
			"id": "JPg03tjh",
			"order": 15000,
			"name": "Rename route",
			"kind": "route",
			"responsibility": "Renames a board or a variant as a write, and moves what the server keyed by the old name: its panes, its claim, what the agent said",
			"groups": ["writes"]
		},
		{
			"id": "lLWMHtNU",
			"order": 16000,
			"name": "Discard route",
			"kind": "route",
