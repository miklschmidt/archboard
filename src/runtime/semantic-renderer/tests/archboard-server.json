{
	"nodes": [
		{
			"id": "2naazvac",
			"order": 1000,
			"name": "HTTP application",
			"kind": "module",
			"responsibility": "Composes the middleware and mounts every route on the one application"
		},
		{
			"id": "J7yOKraz",
			"order": 2000,
			"name": "Application lifetime",
			"kind": "module",
			"responsibility": "Boots and stops the server: the vault and loopback refusals, the pidfile, the ordered shutdown"
		},
		{
			"id": "K6P74fM7",
			"order": 3000,
			"name": "Mutation admission",
			"kind": "module",
			"responsibility": "Admits changes while the server runs and counts each until it settles, so a stop drains every accepted write or refuses with SERVER_BUSY",
			"groups": ["writes"]
		},
		{
			"id": "Y70KOm9C",
			"order": 4000,
			"name": "Board routes",
			"kind": "route",
			"responsibility": "Mounts every board route and answers the reads: the family, the catalogue, one drawn view, the vault check",
			"groups": ["drawing"]
		},
		{
			"id": "wYcdVszt",
			"order": 5000,
			"name": "Semantic board store",
			"kind": "module",
			"responsibility": "The one place a board is read or written",
			"groups": ["writes"]
		},
		{
			"id": "xP18j2Co",
			"order": 6000,
			"name": "Semantic renderer",
			"kind": "module",
			"responsibility": "Draws one variant, view and theme as a self-contained document",
			"groups": ["drawing"]
		},
		{
			"id": "yiSc1qWU",
			"order": 7000,
			"name": "Pane registry",
			"kind": "module",
