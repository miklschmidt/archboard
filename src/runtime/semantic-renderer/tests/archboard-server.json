			"groups": ["writes"]
		},
		{
			"id": "tirq1uzi",
			"order": 17000,
			"name": "Service routes",
			"kind": "route",
			"responsibility": "Serves the page, and the health answer naming the archboard-server service, its pid and whether it runs the source on disk"
		},
		{
			"id": "ws1UusCP",
			"order": 18000,
			"name": "Pane routes",
			"kind": "route",
			"responsibility": "What each pane shows and where, pushed by the browser; the CLI opens, closes and shows panes through it",
			"groups": ["panes"]
		},
		{
			"id": "M9w3f93y",
			"order": 19000,
			"name": "Pane socket",
			"kind": "module",
			"responsibility": "One socket per page: registers it with the panes, and passes its agent messages to the Codex workbench",
			"groups": ["panes"]
		},
		{
			"id": "8imgDQSw",
			"order": 20000,
			"name": "Board lease",
			"kind": "module",
			"responsibility": "One writer at a time per board: the lease file in the vault, an agent's claim, and news when the holder changes",
			"groups": ["writes"]
		},
		{
			"id": "EAiFrCYk",
			"order": 21000,
			"name": "Board announcements",
			"kind": "module",
			"responsibility": "Tells every pane on a board who holds it and what they said they were doing",
			"groups": ["panes"]
		},
		{
			"id": "jpk7aRzD",
			"order": 22000,
			"name": "Change feed",
			"kind": "module",
			"responsibility": "Every settled board change as one stream with a cursor, read off the panes' announcements, for the agent's context",
			"groups": ["panes"]
		}
	],
