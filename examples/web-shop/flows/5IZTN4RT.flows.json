      "participants": [
        "Shop/MKhTEYqf#lwmpnaVU",
        "Shop/5IZTN4RT#4sZ8ZI9y",
        "Shop/5IZTN4RT#SN2ShpE5",
        "Shop/5IZTN4RT#mmSzZdKG"
      ],
      "steps": [
        {
          "id": "Shop/5IZTN4RT#iEFwMg6K",
          "from": "Shop/MKhTEYqf#lwmpnaVU",
          "to": "Shop/5IZTN4RT#4sZ8ZI9y",
          "label": "POST /reservations",
          "kind": "sync"
        },
        {
          "id": "Shop/5IZTN4RT#TQKVXDfs",
          "from": "Shop/5IZTN4RT#4sZ8ZI9y",
          "to": "Shop/5IZTN4RT#SN2ShpE5",
          "label": "set these items aside",
          "kind": "sync"
        },
        {
          "id": "Shop/5IZTN4RT#AD8giBuc",
          "from": "Shop/5IZTN4RT#SN2ShpE5",
          "to": "Shop/5IZTN4RT#mmSzZdKG",
          "label": "lock each item's row",
          "kind": "sync",
          "note": "a second order for the same item waits here until the first commits"
        },
        {
          "id": "Shop/5IZTN4RT#boYUz1Ob",
          "from": "Shop/5IZTN4RT#mmSzZdKG",
          "to": "Shop/5IZTN4RT#SN2ShpE5",
