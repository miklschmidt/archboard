          "from": "Shop/5IZTN4RT#SN2ShpE5",
          "to": "Shop/5IZTN4RT#SN2ShpE5",
          "label": "check every item is covered",
          "kind": "self",
          "note": "one item short: nothing is reserved and the answer is 409 sold out"
