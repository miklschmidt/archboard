{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"jsx": "react-jsx",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": true,
		"noEmitOnError": true,
		"preserveConstEnums": true,
		"removeComments": false,
		"types": ["node", "bun"],
		"exactOptionalPropertyTypes": true,
		"noUncheckedSideEffectImports": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false
	},
	// Name the folders that hold TypeScript, never the repository root: on Linux tsserver puts one
	// inotify watch on every directory under each include base, dot-directories too, and
	// .skill-evals alone holds millions of them.
	"include": ["src", "frontend", "tests", "scripts", "tools", "docs", "vite.config.ts"],
	"exclude": ["node_modules", "dist"],
	"watchOptions": {
		"excludeDirectories": ["**/.skill-evals", "**/.claude", "**/.agents", "**/.git", "**/dist"]
	}
}
