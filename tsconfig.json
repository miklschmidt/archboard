{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"jsx": "react-jsx",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"],
			"@excalidraw/math": ["./node_modules/@excalidraw/excalidraw/dist/types/math/index.d.ts"],
			"@excalidraw/utils/export": ["./node_modules/@excalidraw/excalidraw/dist/types/utils/export.d.ts"],
			"@excalidraw/utils/withinBounds": ["./node_modules/@excalidraw/excalidraw/dist/types/utils/withinBounds.d.ts"],
			"@excalidraw/excalidraw/element/transform": ["./node_modules/@excalidraw/excalidraw/dist/types/excalidraw/data/transform.d.ts"],
			"browser-fs-access": ["./node_modules/browser-fs-access/index.d.ts"]
		},
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"checkJs": false,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": true,
		"noEmitOnError": true,
		"preserveConstEnums": true,
		"removeComments": false,
		"types": ["node", "bun"],
		"exactOptionalPropertyTypes": true,
		"noUncheckedSideEffectImports": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
	"exclude": ["node_modules", "dist", "legacy", "frontend", "src/server/board-rendering/browser.ts"]
}
