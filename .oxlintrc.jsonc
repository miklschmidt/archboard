{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"unicorn",
		"typescript",
		"oxc",
		"import",
		"jsx-a11y",
		"promise",
		"node",
		"react",
		"react-perf",
	],
	"jsPlugins": ["./tools/oxlint-plugin-archboard.js"],
	"env": {
		"browser": true,
		"node": true,
		"es2023": true,
	},
	"globals": {
		"Bun": "readonly",
	},
	"options": {
		"typeAware": true,
		"denyWarnings": true,
		"maxWarnings": 0,
		"reportUnusedDisableDirectives": "error",
	},
	"ignorePatterns": [
		"dist/**",
		"node_modules/**",
		"backlog/**",
		".agents/**",
		".claude/**",
		"docs/design/vendor/**",
	],
	"settings": {
		"react": {
			"version": "19.2.8",
		},
	},
	"rules": {
		"complexity": [
			"error",
			{
				"max": 60,
				"variant": "classic",
			},
		],
		"no-console": "error",
		"import/no-cycle": "error",
		"import/no-relative-parent-imports": "off",
		"typescript/consistent-type-imports": "error",
		"typescript/no-require-imports": "error",
		"typescript/no-explicit-any": "error",
		"react/jsx-no-undef": "error",
		"react/no-danger": "error",
		"react/react-in-jsx-scope": "off",
		"archboard/no-anonymous-jsx-handlers": "error",
		"archboard/no-catch-all-exports": "error",
		"archboard/no-compatibility-identifiers": "error",
		"archboard/no-generic-buckets": "error",
		"archboard/mapped-source-paths": "error",
		"archboard/import-boundaries": "error",
		"archboard/module-entrypoints": "error",
		"archboard/root-implementation-modules": "error",
		"archboard/state-files-pure": "error",
	},
	"overrides": [
		{
			"files": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"frontend/**/*.ts",
				"frontend/**/*.tsx",
				"tools/**/*.js",
			],
			"rules": {
				"no-await-in-loop": "off",
				"typescript/no-unsafe-type-assertion": "off",
				"typescript/no-unnecessary-type-assertion": "off",
				"typescript/no-base-to-string": "off",
				"typescript/no-unnecessary-condition": "off",
				"typescript/no-unnecessary-type-conversion": "off",
				"typescript/consistent-return": "off",
			},
		},
		{
			"files": ["scripts/**/*.mjs", "**/*.test.ts", "**/*.spec.ts"],
			"rules": {
				"complexity": "off",
				"no-await-in-loop": "off",
				"no-console": "off",
				"typescript/no-explicit-any": "off",
				"typescript/no-base-to-string": "off",
				"typescript/no-unsafe-type-assertion": "off",
				"typescript/prefer-optional-chain": "off",
			},
		},
	],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"nursery": "error",
	},
}
