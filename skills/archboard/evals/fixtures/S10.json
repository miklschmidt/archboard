{
	"$comment": "S05's pipeline with traffic already illustrated on the response path, so turning it off is a real change.",
	"registerRepo": true,
	"steps": [
		{
			"op": "new",
			"board": "Flask request pipeline",
			"input": {
				"level": "service",
				"nodes": [
					{
						"name": "WSGI server",
						"kind": "external",
						"responsibility": "Calls the application once per request"
					},
					{
						"name": "Flask app",
						"kind": "app",
						"responsibility": "The WSGI application object",
						"binding": { "repo": "$FLASK", "path": "src/flask/app.py" }
					},
					{
						"name": "Flask.wsgi_app",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Pushes the request context and dispatches",
						"binding": { "repo": "$FLASK", "path": "src/flask/app.py" }
					},
					{
						"name": "full_dispatch_request",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Preprocess, dispatch and finalize one request",
						"binding": { "repo": "$FLASK", "path": "src/flask/app.py" }
					},
					{
						"name": "make_response",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Turns a view's return value into a Response",
						"binding": { "repo": "$FLASK", "path": "src/flask/app.py" }
					},
					{
						"name": "process_response",
						"kind": "function",
						"parent": "Flask app",
						"responsibility": "Runs after_request functions and saves the session",
						"binding": { "repo": "$FLASK", "path": "src/flask/app.py" }
					}
				],
				"edges": [
					{
						"from": "WSGI server",
						"to": "Flask.wsgi_app",
						"kind": "call",
						"label": "environ, start_response",
						"emphasis": "hero"
					},
					{
						"from": "Flask.wsgi_app",
						"to": "full_dispatch_request",
						"kind": "call",
						"description": "The hot path every request takes"
					},
					{
						"from": "full_dispatch_request",
						"to": "make_response",
						"kind": "call",
						"emphasis": "muted"
					},
					{
						"from": "make_response",
						"to": "process_response",
						"kind": "call",
						"label": "response",
						"traffic": {}
					}
				]
			}
		}
	]
}
