								"id": "SCewKCv2",
								"heading": "Meaning is read once and drawn here",
								"body": "A read answers with the board family or with a drawing made on the server. The browser is a viewer: it holds board content only as a read-only cache of what this said.",
								"subjects": [
									"Y70KOm9C",
									"wYcdVszt",
									"xP18j2Co"
								]
							},
							{
								"id": "YWeWWUoZ",
								"heading": "One write boundary, one lease",
								"body": "Every change goes through one boundary: the writer states the version it read, the board's lease admits one writer at a time, and the file is committed before the write is answered.",
								"subjects": [
									"8B8O9ZiT",
									"iG4T44Pd",
									"wYcdVszt",
									"Ck9cBsJC"
								]
							},
							{
								"id": "HRtMJ3Oc",
								"heading": "The file stays the truth while panes stay live",
								"body": "A pane is told a new version exists and reads again; a change nobody here made is noticed on disk and announced the same way. Nothing about a board lives in a pane.",
								"subjects": [
									"ZuLyutvj",
									"yiSc1qWU",
									"VO9ngl7m",
									"9G6CmNgt"
								]
							}
